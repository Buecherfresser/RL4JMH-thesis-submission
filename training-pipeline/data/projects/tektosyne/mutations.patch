+                switch (location) {
+                    case START:
+                        return new SubdivisionElement(line.start);
+                    case END:
+                        return new SubdivisionElement(line.end);
+                    case BETWEEN:
+                        return new SubdivisionElement(edge);
+                }
+
+                edge = edge._next;
+            } while (edge != face._outerEdge);
+        }
+
