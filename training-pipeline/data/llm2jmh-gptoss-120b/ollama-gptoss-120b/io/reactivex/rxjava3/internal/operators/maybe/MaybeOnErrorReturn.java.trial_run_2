```java
package io.reactivex.rxjava3.internal.operators.maybe;

import java.util.concurrent.TimeUnit;
import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.functions.Function;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Microbenchmark for {@code MaybeOnErrorReturn}.
 *
 * <p>Measures the throughput of the {@code onErrorReturn} operator when the upstream
 * terminates with an error. A baseline benchmark without the operator is also provided
 * to help isolate the overhead introduced by the operator.</p>
 *
 * <p>Best practices applied:
 * <ul>
 *   <li>Use {@code @State(Scope.Thread)} to avoid sharing mutable state between threads.</li>
 *   <li>Perform all allocations in {@code @Setup} to keep the benchmark measurement pure.</li>
 *   <li>Consume results with {@link Blackhole} to prevent dead‑code elimination.</li>
 *   <li>Configure warm‑up, measurement, and fork parameters to obtain stable results.</li>
 *   <li>Run in {@link Mode#Throughput} with {@link TimeUnit#SECONDS} output for operations per second.</li>
 * </ul>
 * </p>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@State(Scope.Thread)
public class MaybeOnErrorReturnBenchmark {

    /** Source that immediately fails with a RuntimeException. */
    private Maybe<Integer> errorSource;

    /** The same source wrapped with {@code onErrorReturn}. */
    private Maybe<Integer> errorWithFallback;

    /** Baseline source that succeeds (used to compare against the error path). */
    private Maybe<Integer> successSource;

    @Setup
    public void setUp() {
        Function<Throwable, Integer> fallback = throwable -> 42;
        errorSource = Maybe.error(new RuntimeException("boom"));
        errorWithFallback = errorSource.onErrorReturn(fallback);
        successSource = Maybe.just(1);
    }

    /** Benchmark the throughput of {@code onErrorReturn} when the upstream errors. */
    @Benchmark
    public void onErrorReturnThroughput(Blackhole bh) {
        Integer result = errorWithFallback.blockingGet(); // emits fallback value
        bh.consume(result);
    }

    /**
     * Baseline benchmark that measures the cost of subscribing to a failing {@code Maybe}
     * without any error‑handling operator. The expected error is caught and ignored so
     * that the benchmark can continue.
     */
    @Benchmark
    public void errorBaselineThroughput(Blackhole bh) {
        try {
            Integer result = errorSource.blockingGet(); // throws RuntimeException
            bh.consume(result);
        } catch (Throwable ex) {
            // Expected error path – consume the exception to avoid dead‑code elimination.
            bh.consume(ex);
        }
    }

    /** Benchmark the throughput of a successful {@code Maybe} (best‑case reference). */
    @Benchmark
    public void successBaselineThroughput(Blackhole bh) {
        Integer result = successSource.blockingGet();
        bh.consume(result);
    }
}
```