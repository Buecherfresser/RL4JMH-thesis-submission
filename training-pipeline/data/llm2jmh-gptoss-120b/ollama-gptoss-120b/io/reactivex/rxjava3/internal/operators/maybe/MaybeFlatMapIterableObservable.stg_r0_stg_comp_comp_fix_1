package io.reactivex.rxjava3.internal.operators.maybe;

import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.TimeUnit;
import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.functions.Function;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for {@link MaybeFlatMapIterableObservable}.
 *
 * The benchmark measures the throughput of the {@code flatMapIterable} operator
 * when a {@link Maybe} emits a single value that is mapped to an {@link Iterable}
 * of a configurable size.
 *
 * Best practices applied:
 * - {@code @State(Scope.Thread)} to avoid sharing mutable state between threads.
 * - Warm‑up and measurement iterations to let the JIT stabilize.
 * - Use of {@link Blackhole} to consume emitted items and prevent dead‑code elimination.
 * - The benchmark runs in {@link Mode#Throughput} (operations per second).
 */
@State(Scope.Thread)
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
public class MaybeFlatMapIterableObservableBenchmark {

    /**
     * Size of the iterable produced by the mapper.
     */
    @Param({ "10", "100", "1000", "10000" })
    public int iterableSize;

    /**
     * The source {@link Maybe} that emits a single integer.
     */
    private Maybe<Integer> source;

    /**
     * Mapper that turns the integer into an {@link Iterable} of {@code Integer}.
     */
    private Function<Integer, Iterable<Integer>> mapper;

    /**
     * Observable produced by the internal {@link MaybeFlatMapIterableObservable} operator.
     */
    private Observable<Integer> observable;

    @Setup(Level.Trial)
    public void setup() {
        source = Maybe.just(1);
        // Pre‑create a list of the required size to avoid allocation overhead inside the benchmark.
        List<Integer> baseList = new ArrayList<>(iterableSize);
        for (int i = 0; i < iterableSize; i++) {
            baseList.add(i);
        }
        // The mapper returns a fresh iterable each time to mimic realistic usage.
        mapper = v -> new ArrayList<>(baseList);

        // Create the Observable that applies the flatMapIterable operator.
        observable = new MaybeFlatMapIterableObservable<>(source, mapper);
    }

    /**
     * Executes the {@code flatMapIterable} operator and consumes all emitted items.
     *
     * @param bh Blackhole to consume the items and prevent dead‑code elimination.
     */
    @Benchmark
    public void flatMapIterable(Blackhole bh) {
        observable.subscribe(bh::consume, bh::consume, () -> {});
    }
}
