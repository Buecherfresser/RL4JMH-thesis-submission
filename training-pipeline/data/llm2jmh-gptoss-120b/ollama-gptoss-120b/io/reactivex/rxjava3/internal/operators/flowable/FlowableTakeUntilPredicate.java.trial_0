package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.core.FlowableSubscriber;
import io.reactivex.rxjava3.internal.operators.flowable.FlowableTakeUntilPredicate;
import io.reactivex.rxjava3.functions.Predicate;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import org.reactivestreams.Subscription;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link FlowableTakeUntilPredicate}.
 *
 * The benchmark measures the throughput (operations per second) of the operator
 * when applied to a finite synchronous source. A simple predicate is used to
 * stop the flow after a configurable number of items.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Pre‑create the source and predicate in @Setup to exclude allocation overhead.
 * - Use Blackhole to consume emitted items and prevent dead‑code elimination.
 * - Configure warm‑up, measurement iterations and forks for reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class FlowableTakeUntilPredicateBenchmark {

    /** Number of items emitted by the source Flowable. */
    @Param({"1000", "10000", "100000"})
    public int itemCount;

    /** The predicate will stop after this many items (inclusive). */
    @Param({"500", "1000", "5000"})
    public int stopAt;

    private Flowable<Integer> source;
    private Predicate<Integer> predicate;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a synchronous source that emits a range of integers.
        source = Flowable.range(1, itemCount);

        // Predicate that returns true when the value reaches {@code stopAt}.
        predicate = value -> value >= stopAt;
    }

    /**
     * Benchmark that subscribes to the Flowable with the {@code takeUntil} predicate
     * and drains all emitted items using a Blackhole.
     *
     * Each invocation creates a fresh subscription, ensuring that the measured
     * work includes subscription, request handling, predicate evaluation and
     * cancellation when the predicate matches.
     */
    @Benchmark
    public void takeUntilPredicate(Blackhole bh) {
        source
            .lift(subscriber -> new FlowableTakeUntilPredicate.InnerSubscriber<>(subscriber, predicate))
            .subscribe(new DrainSubscriber(bh));
    }

    /**
     * Simple {@link FlowableSubscriber} that requests {@code Long.MAX_VALUE}
     * and forwards each received item to a {@link Blackhole}.
     */
    static final class DrainSubscriber implements FlowableSubscriber<Integer> {
        private final Blackhole bh;
        private Subscription upstream;

        DrainSubscriber(Blackhole bh) {
            this.bh = bh;
        }

        @Override
        public void onSubscribe(Subscription s) {
            this.upstream = s;
            // Request an unbounded number of items; the operator will cancel when needed.
            s.request(Long.MAX_VALUE);
        }

        @Override
        public void onNext(Integer t) {
            bh.consume(t);
        }

        @Override
        public void onError(Throwable t) {
            // Errors are not expected in this benchmark; rethrow to fail the run.
            throw new RuntimeException(t);
        }

        @Override
        public void onComplete() {
            // No-op – completion is part of the measured work.
        }
    }
}
```