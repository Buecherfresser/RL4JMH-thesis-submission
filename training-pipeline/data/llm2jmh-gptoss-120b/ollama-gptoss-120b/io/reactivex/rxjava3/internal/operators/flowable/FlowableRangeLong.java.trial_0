```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.internal.operators.flowable.FlowableRangeLong;
import io.reactivex.rxjava3.internal.subscriptions.EmptySubscription;
import io.reactivex.rxjava3.operators.ConditionalSubscriber;
import org.reactivestreams.Subscriber;
import org.reactivestreams.Subscription;

/**
 * JMH benchmarks for {@link FlowableRangeLong}.
 *
 * Measures throughput of the fast‑path (unbounded request) and the slow‑path
 * (bounded request) for both regular and conditional subscribers.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@State(Scope.Thread)
public class FlowableRangeLongBenchmark {

    /** Number of elements emitted by the range. */
    @Param({"1000", "1000000", "10000000"})
    public long count;

    /** The Flowable under test. */
    private Flowable<Long> flowable;

    /** Subscriber that consumes values via Blackhole (regular). */
    private Subscriber<Long> subscriber;

    /** ConditionalSubscriber that consumes values via Blackhole. */
    private ConditionalSubscriber<Long> conditionalSubscriber;

    @Setup(Level.Trial)
    public void setup() {
        flowable = new FlowableRangeLong(0, count);
        subscriber = new BlackholeSubscriber();
        conditionalSubscriber = new BlackholeConditionalSubscriber();
    }

    /** Fast‑path benchmark: request Long.MAX_VALUE (unbounded). */
    @Benchmark
    public void fastPathRegular(Blackhole bh) {
        flowable.subscribe(new BlackholeSubscriber(bh));
    }

    /** Fast‑path benchmark with ConditionalSubscriber. */
    @Benchmark
    public void fastPathConditional(Blackhole bh) {
        flowable.subscribe(new BlackholeConditionalSubscriber(bh));
    }

    /** Slow‑path benchmark: request a finite number of items (count). */
    @Benchmark
    public void slowPathRegular(Blackhole bh) {
        flowable.subscribe(new BlackholeSubscriber(bh, count));
    }

    /** Slow‑path benchmark with ConditionalSubscriber. */
    @Benchmark
    public void slowPathConditional(Blackhole bh) {
        flowable.subscribe(new BlackholeConditionalSubscriber(bh, count));
    }

    /** Simple Subscriber that forwards each onNext to a Blackhole. */
    static final class BlackholeSubscriber implements Subscriber<Long> {
        private final Blackhole bh;
        private Subscription upstream;
        private final long requestAmount;

        BlackholeSubscriber() {
            this(null, Long.MAX_VALUE);
        }

        BlackholeSubscriber(Blackhole bh) {
            this(bh, Long.MAX_VALUE);
        }

        BlackholeSubscriber(Blackhole bh, long requestAmount) {
            this.bh = bh;
            this.requestAmount = requestAmount;
        }

        @Override
        public void onSubscribe(Subscription s) {
            this.upstream = s;
            s.request(requestAmount);
        }

        @Override
        public void onNext(Long t) {
            if (bh != null) {
                bh.consume(t);
            }
        }

        @Override
        public void onError(Throwable t) {
            // No‑op for benchmark
        }

        @Override
        public void onComplete() {
            // No‑op for benchmark
        }
    }

    /** ConditionalSubscriber that forwards each successful tryOnNext to a Blackhole. */
    static final class BlackholeConditionalSubscriber implements ConditionalSubscriber<Long> {
        private final Blackhole bh;
        private Subscription upstream;
        private final long requestAmount;

        BlackholeConditionalSubscriber() {
            this(null, Long.MAX_VALUE);
        }

        BlackholeConditionalSubscriber(Blackhole bh) {
            this(bh, Long.MAX_VALUE);
        }

        BlackholeConditionalSubscriber(Blackhole bh, long requestAmount) {
            this.bh = bh;
            this.requestAmount = requestAmount;
        }

        @Override
        public void onSubscribe(Subscription s) {
            this.upstream = s;
            s.request(requestAmount);
        }

        @Override
        public void onNext(Long t) {
            // Not used; tryOnNext is the primary path
        }

        @Override
        public boolean tryOnNext(Long t) {
            if (bh != null) {
                bh.consume(t);
            }
            return true; // count every element as "accepted"
        }

        @Override
        public void onError(Throwable t) {
            // No‑op for benchmark
        }

        @Override
        public void onComplete() {
            // No‑op for benchmark
        }
    }
}
```