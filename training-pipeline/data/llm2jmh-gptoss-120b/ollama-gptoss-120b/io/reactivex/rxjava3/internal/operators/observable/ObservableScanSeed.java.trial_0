```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.core.ObservableSource;
import io.reactivex.rxjava3.functions.BiFunction;
import io.reactivex.rxjava3.functions.Supplier;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableScanSeed}
 * using the public {@code Observable.scan(seed, accumulator)} API.
 *
 * The benchmark measures the throughput (operations per second) of processing a fixed
 * number of items through the scan operator with a simple integer accumulator.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Pre‑create the source Observable in @Setup to exclude its construction cost.
 * - Use Blackhole to consume the final result and prevent dead‑code elimination.
 * - Configure warm‑up, measurement iterations and forks for reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@State(Scope.Thread)
public class ObservableScanSeedBenchmark {

    /** Number of items emitted by the source Observable. */
    @Param({"1000", "10000", "100000"})
    public int itemCount;

    /** Source Observable emitting a range of integers. */
    private Observable<Integer> source;

    /** Seed supplier for the scan operator. */
    private Supplier<Integer> seedSupplier;

    /** Accumulator function that adds the incoming value to the accumulated sum. */
    private BiFunction<Integer, Integer, Integer> accumulator;

    @Setup(Level.Trial)
    public void setup() {
        // Create a cold Observable that emits a range of integers [1, itemCount]
        source = Observable.range(1, itemCount);

        // Seed is zero for summation
        seedSupplier = () -> 0;

        // Simple addition accumulator
        accumulator = (sum, value) -> sum + value;
    }

    /**
     * Executes the scan operator and consumes the final accumulated value.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void scanSeedThroughput(Blackhole bh) {
        // The scan operator under test
        Observable<Integer> scanned = source.scan(seedSupplier, accumulator);

        // Subscribe and block until completion, feeding each emitted item to Blackhole.
        // Using blockingSubscribe ensures the benchmark measures the full pipeline execution.
        scanned.blockingSubscribe(bh::consume);
    }
}
```