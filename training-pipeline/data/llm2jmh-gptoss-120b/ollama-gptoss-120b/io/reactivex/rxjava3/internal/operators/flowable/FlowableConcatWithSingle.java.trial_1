package io.reactivex.rxjava3.internal.operators.flowable;

import java.util.concurrent.TimeUnit;
import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.core.Single;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableConcatWithSingle}
 * measuring the throughput of concatenating a Flowable with a Single.
 *
 * The benchmark creates a Flowable that emits a configurable number of items,
 * concatenates it with a Single, and then consumes all items using {@code blockingForEach}.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the number of upstream items to explore scaling behavior.
 * - Use Blackhole to prevent dead-code elimination.
 * - Warm‑up, measurement, and fork settings follow typical JMH recommendations.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableConcatWithSingleBenchmark {

    /**
     * Number of items emitted by the upstream Flowable before the Single is concatenated.
     */
    @Param({ "1", "10", "100", "1000", "10000" })
    public int upstreamItemCount;

    private Flowable<Integer> flowableWithSingle;

    @Setup(Level.Trial)
    public void setUp() {
        // Upstream Flowable emitting a range of integers.
        Flowable<Integer> upstream = Flowable.range(0, upstreamItemCount);
        // Single that emits a single value after the upstream completes.
        Single<Integer> single = Single.just(-1);
        // The operator under test: concat the Flowable with the Single.
        flowableWithSingle = upstream.concatWith(single);
    }

    /**
     * Consumes the concatenated sequence using a blocking subscription.
     *
     * @param bh Blackhole to consume the emitted items and avoid dead‑code elimination.
     */
    @Benchmark
    public void concatWithSingleThroughput(Blackhole bh) {
        // blockingForEach will subscribe, request all items, and block until completion.
        flowableWithSingle.blockingForEach(bh::consume);
    }
}
```