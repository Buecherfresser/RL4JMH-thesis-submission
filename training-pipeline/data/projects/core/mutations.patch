+		<OC> Consumer<Consumer<OC>> buildOutputCollectionHandler(OC output) {
+			Consumer<Consumer<OC>> outputItemsHandler =
+				output != null ?
+					iterableObjectHelper.isConcurrentEnabled(output) ?
+					(outputHandler) -> {
+						outputHandler.accept(output);
+					} :
+					(outputHandler) -> {
