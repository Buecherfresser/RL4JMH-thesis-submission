/**
 * JMH benchmarks for {@link BehaviorSubject}.
 *
 * <p>These benchmarks focus on the most performance‑critical paths:
 * <ul>
 *   <li>emitting items via {@code onNext}</li>
 *   <li>subscribing observers</li>
 * </ul>
 *
 * <p>All benchmarks run in {@link Mode#Throughput} to measure how many
 * operations per time unit can be performed under steady‑state conditions.
 *
 * <p>Typical JMH command line:
 * <pre>
 *   java -jar benchmarks.jar -bm Throughput -wi 5 -i 10 -f 2 -t 4
 * </pre>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@Threads(1)
@State(Scope.Benchmark)
public class BehaviorSubjectBenchmark {

    /**
     * Subject under test.
     */
    private BehaviorSubject<Integer> subject;

    /**
     * A pool of dummy observers used to simulate a realistic subscription load.
     */
    private List<DummyObserver> observers;

    /**
     * Number of observers to keep subscribed during the {@code onNext} benchmark.
     */
    @Param({ "0", "10", "100", "1000" })
    private int observerCount;

    /**
     * Counter used to generate distinct values for {@code onNext}.
     */
    private int counter;

    @Setup(Level.Trial)
    public void setUp() {
        subject = BehaviorSubject.create();
        observers = new ArrayList<>(observerCount);
        for (int i = 0; i < observerCount; i++) {
            DummyObserver o = new DummyObserver();
            subject.subscribe(o);
            observers.add(o);
        }
        counter = 0;
    }

    /**
     * Benchmark the {@code onNext} path with the configured number of observers.
     *
     * <p>The method emits a single integer value. JMH will invoke this method
     * repeatedly, measuring how many emissions per millisecond can be performed.
     */
    @Benchmark
    public void emitOnNext() {
        subject.onNext(counter++);
    }

    /**
     * Benchmark the subscription path. Each invocation creates a new observer
     * and subscribes it to the subject. This measures the overhead of the
     * {@code subscribeActual} logic, including array copying and lock handling.
     */
    @Benchmark
    // simulate concurrent subscriptions
    @Threads(4)
    public void subscribe() {
        DummyObserver o = new DummyObserver();
        subject.subscribe(o);
        // Immediately dispose to keep the benchmark focused on subscription cost
        o.dispose();
    }

    /**
     * Simple {@link Observer} implementation that does nothing on the callbacks.
     * It also implements {@link Disposable} so that the benchmark can dispose it
     * without additional allocations.
     */
    private static final class DummyObserver implements Observer<Integer>, Disposable {

        private volatile boolean disposed;

        @Override
        public void onSubscribe(Disposable d) {
            // no-op
        }

        @Override
        public void onNext(Integer integer) {
            // no-op
        }

        @Override
        public void onError(Throwable e) {
            // no-op
        }

        @Override
        public void onComplete() {
            // no-op
        }

        @Override
        public void dispose() {
            disposed = true;
        }

        @Override
        public boolean isDisposed() {
            return disposed;
        }
    }
}
