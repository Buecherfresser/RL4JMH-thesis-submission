```java
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;
import java.util.function.Function;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.internal.operators.observable.ObservableFlatMapCompletable;

/**
 * Benchmark for {@link ObservableFlatMapCompletable}.
 *
 * The benchmark measures the throughput of processing a fixed number of upstream items
 * where each item is mapped to a {@link Completable} that completes immediately.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Perform all heavyweight initialisation in @Setup.
 * - Use a deterministic source (Observable.range) to keep the workload constant.
 * - Run in Mode.Throughput so JMH reports operations per second.
 * - Include warm‑up, measurement, and fork parameters.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class ObservableFlatMapCompletableBenchmark {

    /** Number of items emitted by the upstream source per benchmark iteration. */
    @Param({"1000", "10000", "100000"})
    public int itemCount;

    /** Whether the operator should delay errors (not used in this simple benchmark). */
    @Param({"false"})
    public boolean delayErrors;

    private Observable<Integer> source;
    private Function<Integer, CompletableSource> mapper;
    private ObservableFlatMapCompletable<Integer> operator;

    @Setup(Level.Trial)
    public void setup() {
        // Upstream emits a deterministic range of integers.
        source = Observable.range(1, itemCount);

        // Mapper returns a Completable that completes immediately.
        mapper = v -> Completable.complete();

        // Create the operator instance under test.
        operator = new ObservableFlatMapCompletable<>(source, mapper, delayErrors);
    }

    /**
     * Subscribes to the operator and blocks until completion.
     *
     * Each invocation processes {@code itemCount} items, so the reported throughput
     * corresponds to the number of such batches completed per second.
     */
    @Benchmark
    public void flatMapCompletableThroughput() {
        // The downstream observer does nothing; we just block until the stream terminates.
        operator.blockingSubscribe();
    }
}
```