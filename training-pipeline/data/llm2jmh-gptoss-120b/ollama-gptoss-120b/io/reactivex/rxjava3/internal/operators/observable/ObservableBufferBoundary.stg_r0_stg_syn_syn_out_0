/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableBufferBoundary}.
 *
 * The benchmark measures the throughput (operations per second) of the bufferBoundary
 * operator when processing a configurable number of upstream items.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - @Setup(Level.Trial) prepares the observable pipeline once per JVM fork.
 * - Blackhole consumes the downstream buffers to prevent dead‑code elimination.
 * - Warm‑up, measurement, and fork parameters are chosen to give stable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class ObservableBufferBoundaryBenchmark {

    /**
     * Number of items emitted by the upstream source.
     * Typical values are chosen to exercise both small‑ and medium‑sized streams.
     */
    @Param({ "1_000", "10_000", "100_000" })
    public int size;

    /**
     * The observable that applies the bufferBoundary operator.
     * It is created once per trial to avoid measuring pipeline construction overhead.
     */
    private Observable<List<Integer>> bufferedObservable;

    /**
     * Set up the observable pipeline.
     *
     * The source emits a range of integers.
     * A single “open” signal starts a buffer, and the corresponding “close” signal
     * closes it immediately, resulting in one‑item buffers. This pattern stresses
     * the boundary handling logic without involving time‑based operators.
     */
    @Setup(Level.Trial)
    public void setUp() {
        Observable<Integer> source = Observable.range(1, size);
        // Open a buffer once; each open token will be closed immediately.
        ObservableSource<Object> open = Observable.just(new Object());
        // For each open token, return an Observable that emits a single item to close the buffer.
        Function<Object, ObservableSource<Object>> close = token -> Observable.just(new Object());
        // Buffer supplier creates a new mutable collection for each buffer.
        bufferedObservable = source.bufferBoundary(open, close, ArrayList::new);
    }

    /**
     * Benchmark method that subscribes to the buffered observable and consumes all emitted buffers.
     *
     * @param bh Blackhole to consume the buffers and prevent dead‑code elimination.
     */
    @Benchmark
    public void bufferBoundaryThroughput(Blackhole bh) {
        // blockingSubscribe ensures the method returns only after the whole stream has been processed.
        bufferedObservable.blockingSubscribe(bh::consume);
    }
}
