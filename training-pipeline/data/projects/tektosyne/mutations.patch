+                            ((count & 0xFF0000) != 0 ? 12 :
+                            ((count & 0xFFC000) != 0 ? 11 :
+                            ((count & 0xFFF000) != 0 ? 10 :
+                            ((count & 0xFFFC00) != 0 ? 9 :
+                            ((count & 0xFFFF00) != 0 ? 8 :
+                            ((count & 0xFFFFC0) != 0 ? 7 :
+                            ((count & 0xFFFFF0) != 0 ? 6 :
+                            ((count & 0xFFFFFC) != 0 ? 5 : 4))))))))));
+                } else {
+                    // determine probe level (favors lower node counts)
+                    level = 1;
+                    while ((count >> (level << 1)) > 0) level++;
