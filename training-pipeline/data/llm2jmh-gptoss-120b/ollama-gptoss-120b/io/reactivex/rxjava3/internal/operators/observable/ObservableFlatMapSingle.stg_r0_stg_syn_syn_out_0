/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableFlatMapSingle}.
 *
 * The benchmark measures the throughput (operations per second) of the flatMapSingle
 * operator when applied to a simple range source and a trivial mapper.
 *
 * Best‑practice notes:
 * • Use {@code blockingSubscribe} to make the benchmark deterministic – the method
 *   returns only after the whole stream has been processed.
 * • Keep the mapper cheap (here {@code Single.just}) to focus on the operator's
 *   overhead rather than the work done inside the Single.
 * • Parameterise the source size to see how the operator scales.
 * • Blackhole consumes the downstream values to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class ObservableFlatMapSingleBenchmark {

    /**
     * Number of items emitted by the upstream Observable.
     * Typical values are chosen to keep the benchmark fast while still exercising
     * the internal queueing and concurrency logic.
     */
    @Param({ "100", "1000", "10000" })
    public int size;

    /**
     * Upstream Observable used in each benchmark iteration.
     */
    private Observable<Integer> source;

    @Setup(Level.Trial)
    public void setUp() {
        // A cold Observable that emits a range of integers.
        source = Observable.range(1, size);
    }

    /**
     * Benchmark the flatMapSingle operator with a simple mapper that returns
     * {@code Single.just(i)}. The downstream consumes the values via Blackhole.
     *
     * @param bh Blackhole to consume emitted items and avoid dead‑code elimination.
     */
    @Benchmark
    public void flatMapSingle(Blackhole bh) {
        source.flatMapSingle(i -> Single.just(i * 2)).blockingSubscribe(bh::consume);
    }
}
