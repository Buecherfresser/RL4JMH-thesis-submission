-            if (cd.isDepndency()) {
-                cds.add(cd);
-            } else {
-                cds.add(0, cd);
-            }
-        }
-        CodeDependent codeDependent;
-        // copy cds
-        List<CodeDependent> copiedCds = new ArrayList<ProtobufIDLProxy.CodeDependent>(cds);
-        while ((codeDependent = hasDependency(copiedCds, compiledClass)) != null) {
-            if (debug) {
