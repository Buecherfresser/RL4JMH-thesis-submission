/**
 * JMH benchmark for {@link FlowableOnBackpressureError}.
 *
 * The benchmark measures the throughput (items processed per second) when a large
 * number of items flow through the operator under a simple downstream subscriber
 * that requests all items eagerly.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Perform all setup in @Setup(Level.Trial) to exclude it from measurement.
 * - Use Blackhole to consume items and prevent dead-code elimination.
 * - Configure warm‑up, measurement, forks and time units for reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableOnBackpressureErrorBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "1000", "100000", "1000000" })
    public int itemCount;

    /**
     * The Flowable under test (source → onBackpressureError).
     */
    private Flowable<Integer> flowable;

    /**
     * Subscriber that consumes items and forwards them to Blackhole.
     */
    private BlackholeSubscriber subscriber;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a hot source that emits a known number of items.
        Flowable<Integer> source = Flowable.range(1, itemCount);
        // Apply the operator we want to benchmark.
        flowable = source.onBackpressureError();
        subscriber = new BlackholeSubscriber();
    }

    @Benchmark
    public void testOnBackpressureError(Blackhole bh) {
        // Subscribe with a fresh subscriber for each iteration.
        subscriber.setBlackhole(bh);
        flowable.subscribe(subscriber);
        // The subscriber requests all items eagerly in onSubscribe.
        // No further synchronization needed because the benchmark runs in a single thread.
    }

    /**
     * Simple subscriber that requests {@code Long.MAX_VALUE} on subscription
     * and forwards each received item to the provided Blackhole.
     */
    private static class BlackholeSubscriber extends DefaultSubscriber<Integer> {

        private Blackhole bh;

        void setBlackhole(Blackhole bh) {
            this.bh = bh;
        }

        @Override
        public void onStart() {
            // Request an unbounded number of items to avoid backpressure interference.
            request(Long.MAX_VALUE);
        }

        @Override
        public void onNext(Integer value) {
            // Consume the value to prevent dead‑code elimination.
            bh.consume(value);
        }

        @Override
        public void onError(Throwable t) {
            // Errors are not expected in this benchmark; rethrow to fail fast.
            throw new RuntimeException(t);
        }

        @Override
        public void onComplete() {
            // No-op; completion is part of the normal flow.
        }
    }

    /**
     * Main method to run the benchmark from the command line.
     *
     * Example:
     * <pre>
     *   java -jar target/benchmarks.jar io.reactivex.rxjava3.benchmarks.FlowableOnBackpressureErrorBenchmark
     * </pre>
     */
    public static void main(String[] args) throws Exception {
        org.openjdk.jmh.Main.main(args);
    }
}
