package io.reactivex.rxjava3.internal.operators.flowable;

import java.util.concurrent.TimeUnit;
import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.core.Single;
import io.reactivex.rxjava3.functions.BiFunction;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * JMH benchmark for {@link FlowableReduceSeedSingle}.
 *
 * Measures throughput of reducing a {@link Flowable} with a seed using integer addition.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Benchmark)
public class FlowableReduceSeedSingleBenchmark {

    @Param({ "10000", "100000", "1000000" })
    public int size;

    private Flowable<Integer> source;

    private static final BiFunction<Integer, Integer, Integer> SUM_REDUCER = (a, b) -> a + b;

    private static final Integer SEED = 0;

    @Setup(Level.Trial)
    public void setUp() {
        source = Flowable.range(1, size);
    }

    @Benchmark
    public void reduceWithSeed(Blackhole bh) {
        Single<Integer> reduced = new FlowableReduceSeedSingle<Integer, Integer>(source, SEED, SUM_REDUCER);
        Integer result = reduced.blockingGet();
        bh.consume(result);
    }
}
