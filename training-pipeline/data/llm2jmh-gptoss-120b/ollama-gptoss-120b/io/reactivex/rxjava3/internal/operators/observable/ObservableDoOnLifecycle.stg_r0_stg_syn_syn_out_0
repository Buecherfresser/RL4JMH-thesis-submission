/**
 * Benchmark for {@link ObservableDoOnLifecycle}.
 *
 * Measures the throughput of an Observable that emits a fixed number of items
 * while applying a no‑op {@code doOnLifecycle} operator.
 *
 * The benchmark follows JMH best practices:
 * <ul>
 *   <li>Uses {@link Blackhole} to consume emitted items and prevent dead‑code elimination.</li>
 *   <li>Configures warm‑up and measurement iterations.</li>
 *   <li>Runs in a separate JVM fork to isolate the benchmark from JVM warm‑up effects.</li>
 *   <li>Uses {@link Mode#Throughput} to report operations per second.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class ObservableDoOnLifecycleBenchmark {

    /**
     * Number of items emitted per subscription.
     */
    @Param({ "1", "1000", "100000" })
    public int itemCount;

    /**
     * The Observable under test.
     */
    private Observable<Integer> observable;

    /**
     * No‑op consumer for {@code onSubscribe}.
     */
    private static final Consumer<Disposable> NOOP_CONSUMER = d -> {
        /* no‑op */
    };

    /**
     * No‑op action for {@code onDispose}.
     */
    private static final Action NOOP_ACTION = () -> {
        /* no‑op */
    };

    @Setup(Level.Trial)
    public void setUp() {
        // Base source that emits a range of integers.
        Observable<Integer> source = Observable.range(1, itemCount);
        // Wrap the source with the ObservableDoOnLifecycle operator.
        observable = new ObservableDoOnLifecycle<>(source, NOOP_CONSUMER, NOOP_ACTION);
    }

    /**
     * Subscribes to the observable and consumes all emitted items.
     *
     * @param bh Blackhole to consume items and avoid dead‑code elimination.
     */
    @Benchmark
    public void doOnLifecycleThroughput(Blackhole bh) {
        observable.subscribe(// onNext
        bh::consume, // onError
        bh::consume, // onComplete
        () -> bh.consume("complete"));
    }
}
