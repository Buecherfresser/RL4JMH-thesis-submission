package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observer;
import io.reactivex.rxjava3.disposables.Disposable;
import io.reactivex.rxjava3.subjects.PublishSubject;
import org.openjdk.jmh.annotations.*;

import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

/**
 * JMH benchmarks for {@link PublishSubject}.
 *
 * The benchmarks focus on the most common operations:
 *   - emitting items to a subject with a fixed number of observers (throughput of onNext)
 *   - adding a new observer (throughput of subscribe)
 *   - disposing an observer (throughput of dispose)
 *
 * All benchmarks run in {@link Mode#Throughput} and report operations per millisecond.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Benchmark)
public class PublishSubjectBenchmark {

    /** Number of observers attached to the subject during the onNext benchmark. */
    @Param({"1", "10", "100"})
    public int observerCount;

    /** The subject under test. */
    private PublishSubject<Integer> subject;

    /** Pre‑created observers that do nothing on callbacks. */
    private DummyObserver[] observers;

    /** Counter used to generate distinct values for onNext. */
    private final AtomicInteger counter = new AtomicInteger();

    @Setup(Level.Trial)
    public void setUp() {
        subject = PublishSubject.create();
        observers = new DummyObserver[observerCount];
        for (int i = 0; i < observerCount; i++) {
            observers[i] = new DummyObserver();
            subject.subscribe(observers[i]);
        }
    }

    /**
     * Benchmark the throughput of emitting a single item to a subject that already has
     * {@code observerCount} observers subscribed.
     */
    @Benchmark
    public void emitOnNext() {
        subject.onNext(counter.incrementAndGet());
    }

    /**
     * Benchmark the throughput of adding a new observer to the subject.
     * The observer is immediately disposed to keep the subject size stable.
     */
    @Benchmark
    public void subscribeAndDispose() {
        DummyObserver observer = new DummyObserver();
        subject.subscribe(observer);
        observer.dispose();
    }

    /**
     * Dummy observer implementation that discards all signals.
     * It also exposes its {@link Disposable} so the benchmark can dispose it.
     */
    private static final class DummyObserver implements Observer<Integer>, Disposable {

        private volatile boolean disposed;

        @Override
        public void onSubscribe(Disposable d) {
            // No-op – the subject will manage disposal via this instance.
        }

        @Override
        public void onNext(Integer value) {
            // No-op – we deliberately avoid any work to isolate subject overhead.
        }

        @Override
        public void onError(Throwable e) {
            // No-op
        }

        @Override
        public void onComplete() {
            // No-op
        }

        @Override
        public void dispose() {
            disposed = true;
        }

        @Override
        public boolean isDisposed() {
            return disposed;
        }
    }
}
```