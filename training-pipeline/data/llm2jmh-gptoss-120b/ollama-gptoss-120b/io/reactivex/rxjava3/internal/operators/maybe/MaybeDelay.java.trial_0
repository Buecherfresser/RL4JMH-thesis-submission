package io.reactivex.rxjava3.benchmarks.internal.operators.maybe;

import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.core.MaybeObserver;
import io.reactivex.rxjava3.core.Scheduler;
import io.reactivex.rxjava3.internal.operators.maybe.MaybeDelay;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link MaybeDelay} in throughput mode.
 *
 * The benchmark uses {@link Schedulers#trampoline()} to avoid thread scheduling overhead
 * and focuses on the operator's internal logic (state handling, atomic operations, etc.).
 *
 * Best‑practice JMH settings:
 * - Warm‑up iterations to let the JIT stabilize.
 * - Multiple measurement iterations for statistical relevance.
 * - Several forks to isolate JVM state.
 * - Blackhole consumption to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class MaybeDelayBenchmark {

    /** Source Maybe that emits a single integer value. */
    private Maybe<Integer> source;

    /** Scheduler used by the operator – trampoline runs tasks on the current thread. */
    private Scheduler scheduler;

    /** MaybeDelay instance with zero delay and delayError = false. */
    private Maybe<Integer> delayNoError;

    /** MaybeDelay instance with zero delay and delayError = true. */
    private Maybe<Integer> delayWithError;

    /** A Maybe that terminates with an error (used for the delayError=true case). */
    private Maybe<Integer> errorSource;

    @Setup(Level.Trial)
    public void setup() {
        // Use trampoline to eliminate thread‑creation overhead and keep the benchmark focused.
        scheduler = Schedulers.trampoline();

        // Normal successful source.
        source = Maybe.just(1);

        // Error source for the delayError=true scenario.
        errorSource = Maybe.error(new RuntimeException("test"));

        // Zero delay ensures we measure only the operator's bookkeeping.
        delayNoError = new MaybeDelay<>(source, 0, TimeUnit.MILLISECONDS, scheduler, false);
        delayWithError = new MaybeDelay<>(errorSource, 0, TimeUnit.MILLISECONDS, scheduler, true);
    }

    /**
     * Benchmark the happy‑path (onSuccess) execution of {@link MaybeDelay}
     * with {@code delayError = false}.
     */
    @Benchmark
    public void delaySuccess(Blackhole bh) {
        // blockingGet blocks until the Maybe terminates; the result is consumed by Blackhole.
        Integer result = delayNoError.blockingGet();
        bh.consume(result);
    }

    /**
     * Benchmark the error‑path execution of {@link MaybeDelay}
     * with {@code delayError = true}.
     */
    @Benchmark
    public void delayError(Blackhole bh) {
        try {
            // blockingGet throws the upstream error; we capture it to avoid benchmark failure.
            delayWithError.blockingGet();
        } catch (Throwable ex) {
            bh.consume(ex);
        }
    }
}
```