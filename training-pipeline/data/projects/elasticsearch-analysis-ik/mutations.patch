+            context.addLexeme(newLexeme);
+            this.start = -1;
+            this.end = -1;
+		}
+		
+		//判断是否锁定缓冲区
+		if(this.start == -1 && this.end == -1){
+			//对缓冲区解锁
+			needLock = false;
+		}else{
+			needLock = true;
+		}
+		return needLock;
+	}
