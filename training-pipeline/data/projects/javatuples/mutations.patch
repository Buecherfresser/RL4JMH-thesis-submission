-        X element0 = null;
-        X element1 = null;
-        
-        final Iterator<X> iter = iterable.iterator();
-        
-        int i = 0;
-        while (i < index) {
-            if (iter.hasNext()) {
-                iter.next();
-            } else {
-                tooFewElements = true;
-            }
-            i++;
-        }
-        
-        if (iter.hasNext()) {
-            element0 = iter.next();
-        } else {
-            tooFewElements = true;
