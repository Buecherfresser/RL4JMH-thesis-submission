+            Sink<T> other = new Sink<>(this.lock);
+            sink.other = other;
+            other.other = sink;
+            other.push(headTail, null, true);
+            if (mode == MODE_MAP_FIRST || mode == MODE_MAP_FIRST_OR_ELSE)
+                this.left = sink;
+            else
