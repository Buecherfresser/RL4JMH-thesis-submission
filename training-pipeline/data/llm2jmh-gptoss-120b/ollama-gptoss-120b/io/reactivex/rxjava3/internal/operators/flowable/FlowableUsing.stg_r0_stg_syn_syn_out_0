/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableUsing}.
 *
 * The benchmark measures the throughput (operations per second) of subscribing to a
 * {@code FlowableUsing} that emits a fixed number of integer values.
 *
 * Best practices applied:
 * - {@code @State(Scope.Thread)} to avoid sharing mutable state between threads.
 * - Separate {@code @Setup} method to create the Flowable once per thread.
 * - Use {@code Blackhole} to consume emitted items and prevent dead-code elimination.
 * - Warm‑up and measurement iterations are defined to let the JIT stabilize.
 * - The benchmark runs in {@code Mode.Throughput} with results expressed in operations per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@State(Scope.Thread)
public class FlowableUsingBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "1", "10", "1000", "100000" })
    public int itemCount;

    /**
     * The Flowable under test.
     */
    private Flowable<Integer> flowableUsing;

    /**
     * A simple resource that will be created and disposed for each subscription.
     */
    private static final Supplier<String> RESOURCE_SUPPLIER = () -> "resource";

    /**
     * Disposer that pretends to clean up the resource.
     */
    private static final Consumer<String> DISPOSER = r -> {
        // No‑op; in a real scenario this could close a file, release a lock, etc.
    };

    @Setup(Level.Trial)
    public void setUp() {
        // Source Flowable that emits a range of integers.
        Flowable<Integer> source = Flowable.range(1, itemCount);
        // Create the FlowableUsing operator with eager disposal disabled (eager = false)
        // to focus on the typical use‑case where disposal happens after termination.
        flowableUsing = Flowable.using(RESOURCE_SUPPLIER, resource -> source, DISPOSER, false);
    }

    /**
     * Subscribes to the {@code FlowableUsing} and consumes all emitted items.
     *
     * @param bh Blackhole to consume items and avoid dead‑code elimination.
     */
    @Benchmark
    public void subscribeAndConsume(Blackhole bh) {
        flowableUsing.subscribe(new Subscriber<Integer>() {

            private Subscription upstream;

            @Override
            public void onSubscribe(Subscription s) {
                this.upstream = s;
                // Request all items in one go to keep the benchmark simple.
                s.request(Long.MAX_VALUE);
            }

            @Override
            public void onNext(Integer t) {
                bh.consume(t);
            }

            @Override
            public void onError(Throwable t) {
                // Errors are not expected in this benchmark; rethrow to fail fast.
                throw new RuntimeException(t);
            }

            @Override
            public void onComplete() {
                // No action needed on completion.
            }
        });
    }
}
