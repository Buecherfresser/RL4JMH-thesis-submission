/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableFlatMapMaybe}
 * measuring throughput of the flatMapMaybe operator when the mapper returns an immediate {@link Maybe}.
 */
@State(Scope.Thread)
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@Threads(1)
public class ObservableFlatMapMaybeBenchmark {

    /**
     * Number of items emitted by the source Observable per benchmark iteration.
     */
    @Param({ "1000", "10000", "100000" })
    public int size;

    /**
     * Source Observable emitting a range of integers.
     */
    private Observable<Integer> source;

    /**
     * Mapper converting each integer into a Maybe emitting a String.
     */
    private Function<Integer, MaybeSource<String>> mapper;

    @Setup(Level.Trial)
    public void setup() {
        // Create a cold Observable that emits 'size' sequential integers.
        source = Observable.range(1, size);
        // Mapper returns a Maybe that immediately emits a transformed value.
        mapper = i -> Maybe.just("value-" + i);
    }

    /**
     * Executes the flatMapMaybe operator and consumes all emitted items.
     *
     * The benchmark measures how many complete flatMapMaybe executions can be performed per second.
     */
    @Benchmark
    public void flatMapMaybeThroughput(Blackhole bh) {
        // The blockingSubscribe ensures the whole stream is processed before the method returns.
        source.flatMapMaybe(mapper).blockingSubscribe(bh::consume);
    }
}
