package io.reactivex.rxjava3.internal.operators.flowable;

import io.reactivex.rxjava3.internal.operators.flowable.FlowableConcatMap.ErrorMode;
import java.util.concurrent.TimeUnit;
import org.reactivestreams.Publisher;
import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.*;
import io.reactivex.rxjava3.schedulers.*;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.*;

@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableConcatMapSchedulerBenchmark {

    @Param({ "1000", "10000", "100000" })
    public int itemCount;

    @Param({ "32", "128", "1024" })
    public int prefetch;

    private Flowable<Integer> source;
    private Function<Integer, Publisher<Integer>> mapper;
    private Scheduler scheduler;
    private ErrorMode errorMode;

    @Setup(Level.Trial)
    public void setUp() {
        source = Flowable.range(1, itemCount);
        mapper = v -> Flowable.just(v);
        scheduler = Schedulers.computation();
        errorMode = ErrorMode.IMMEDIATE;
    }

    @Benchmark
    public void concatMapScheduler(Blackhole bh) {
        Flowable<Integer> flowable = new FlowableConcatMapScheduler<>(
                source,
                mapper,
                prefetch,
                errorMode,
                scheduler
        );

        flowable.subscribe(new Consumer<Integer>() {
            @Override
            public void accept(Integer value) {
                bh.consume(value);
            }
        }, bh::consume);
    }
}
