+        String otherValue = other.getName(-1);
+        if (thisValue == null && otherValue == null) {
+            return 0;
+        } else if (thisValue != null && otherValue == null) {
+            return 1;
+        } else if (thisValue == null && otherValue != null) {
+            return -1;
+        } else {
+            return thisValue.compareTo(otherValue);
+        }
+    }
+}
