```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Single;
import io.reactivex.rxjava3.functions.Action;
import org.openjdk.jmh.annotations.*;

import java.util.concurrent.TimeUnit;

/**
 * Benchmarks for {@link io.reactivex.rxjava3.internal.operators.single.SingleDoAfterTerminate}.
 *
 * <p>Measures the throughput (operations per second) of a plain {@code Single.just}
 * versus the same {@code Single} wrapped with {@code doAfterTerminate}.
 *
 * <p>Best practices applied:
 * <ul>
 *   <li>Separate {@link State} for shared immutable fixtures.</li>
 *   <li>Warm‑up and measurement iterations to let the JIT stabilize.</li>
 *   <li>Multiple forks to reduce JVM start‑up noise.</li>
 *   <li>Blackhole is not needed because we return the result, which JMH treats as a
 *       consumption point.</li>
 *   <li>All allocations are performed in {@link Setup} to avoid measuring allocation cost.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Benchmark)
public class SingleDoAfterTerminateBenchmark {

    /** Plain source without any operator. */
    private Single<Integer> plainSingle;

    /** Source wrapped with {@code doAfterTerminate}. */
    private Single<Integer> withDoAfterTerminate;

    /** No‑op action used for the operator. */
    private Action noopAction;

    @Setup(Level.Trial)
    public void setUp() {
        // A simple source that emits a constant value.
        plainSingle = Single.just(1);

        // No‑op action – the overhead we want to measure.
        noopAction = () -> {
            // intentionally empty
        };

        // Apply the operator under test.
        withDoAfterTerminate = plainSingle.doAfterTerminate(noopAction);
    }

    /**
     * Baseline benchmark: retrieve the value from a plain {@code Single}.
     *
     * @return the emitted integer (used by JMH to prevent dead‑code elimination)
     */
    @Benchmark
    public int baseline() {
        return plainSingle.blockingGet();
    }

    /**
     * Benchmark the {@code doAfterTerminate} operator.
     *
     * @return the emitted integer (used by JMH to prevent dead‑code elimination)
     */
    @Benchmark
    public int withDoAfterTerminate() {
        return withDoAfterTerminate.blockingGet();
    }
}
```