/**
 * JMH benchmark for {@link FlowableSwitchMapCompletable}.
 *
 * Measures the throughput (operations per second) of the switchMapCompletable operator
 * when applied to a hot {@link Flowable} emitting a configurable number of items.
 *
 * The benchmark follows best practices:
 * - Uses @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Performs all allocations in @Setup to keep the measured section focused on the operator.
 * - Uses Blackhole to consume results and prevent dead-code elimination.
 * - Configurable parameters for source size and delayErrors flag.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableSwitchMapCompletableBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "1", "10", "100", "1000" })
    public int sourceSize;

    /**
     * Whether the operator should delay errors.
     */
    @Param({ "true", "false" })
    public boolean delayErrors;

    private Flowable<Integer> source;

    private Function<Integer, CompletableSource> mapper;

    private Completable benchmarkedCompletable;

    @Setup(Level.Trial)
    public void setup() {
        // Create a hot source that emits a fixed number of integers.
        // hide() prevents fusion optimizations that could mask the operator's cost.
        source = Flowable.range(1, sourceSize).hide();
        // Simple mapper that returns a Completable that completes immediately.
        mapper = v -> Completable.complete();
        // Build the Completable under test.
        benchmarkedCompletable = new FlowableSwitchMapCompletable<>(source, mapper, delayErrors);
    }

    @Benchmark
    public void switchMapCompletableThroughput(Blackhole bh) {
        // Subscribe and block until completion.
        // The result of blockingAwait() is a boolean indicating termination,
        // which we feed to Blackhole to avoid dead‑code elimination.
        boolean terminated = benchmarkedCompletable.blockingAwait();
        bh.consume(terminated);
    }
}
