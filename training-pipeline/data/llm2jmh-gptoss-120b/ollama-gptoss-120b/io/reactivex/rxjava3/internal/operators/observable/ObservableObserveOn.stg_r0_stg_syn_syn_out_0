/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableObserveOn}
 * measuring throughput (items per second) under different configurations.
 *
 * The benchmark creates a hot Observable emitting a fixed number of integers,
 * applies {@code observeOn} with configurable scheduler, delayError flag and buffer size,
 * then consumes the items using a custom {@link Observer} that forwards each item to a {@link Blackhole}
 * to avoid dead-code elimination.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between benchmark threads.
 * - Use @Param to explore a matrix of configurations.
 * - Use @Setup(Level.Iteration) to recreate the Observable for each iteration, ensuring a fresh state.
 * - Use CountDownLatch to synchronously wait for the asynchronous flow to complete.
 * - Keep the benchmark method short and side‑effect free (only Blackhole consumption).
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class ObservableObserveOnBenchmark {

    /**
     * Number of items emitted by the source Observable per subscription.
     */
    @Param({ "1000", "10000", "100000" })
    public int itemCount;

    /**
     * Buffer size passed to observeOn.
     */
    @Param({ "128", "1024", "8192" })
    public int bufferSize;

    /**
     * Whether observeOn should delay errors.
     */
    @Param({ "true", "false" })
    public boolean delayError;

    /**
     * Scheduler type used by observeOn.
     */
    @Param({ "computation", "single", "io" })
    public String schedulerName;

    private Observable<Integer> observable;

    @Setup(Level.Iteration)
    public void setUp() {
        // Create a simple cold Observable that emits a range of integers.
        Observable<Integer> source = Observable.range(1, itemCount);
        // Choose the scheduler based on the parameter.
        switch(schedulerName) {
            case "computation":
                observable = source.observeOn(Schedulers.computation(), delayError, bufferSize);
                break;
            case "single":
                observable = source.observeOn(Schedulers.single(), delayError, bufferSize);
                break;
            case "io":
                observable = source.observeOn(Schedulers.io(), delayError, bufferSize);
                break;
            default:
                throw new IllegalArgumentException("Unsupported scheduler: " + schedulerName);
        }
    }

    @Benchmark
    public void observeOnThroughput(Blackhole bh) throws InterruptedException {
        CountDownLatch latch = new CountDownLatch(1);
        observable.subscribe(new Observer<Integer>() {

            @Override
            public void onSubscribe(Disposable d) {
                /* no-op */
            }

            @Override
            public void onNext(Integer value) {
                // Feed each emitted value to Blackhole to prevent dead‑code elimination.
                bh.consume(value);
            }

            @Override
            public void onError(Throwable e) {
                // In case of error, still count down to avoid hanging the benchmark.
                latch.countDown();
            }

            @Override
            public void onComplete() {
                latch.countDown();
            }
        });
        // Wait for the asynchronous flow to finish before returning.
        latch.await();
    }
}
