     private Meter() {}
 
+    // Regressed: read wall-clock time on every iteration.
     public static int count(int[] xs) {
         int n = 0;
+        long acc = 0L;
         for (int i = 0; i < xs.length; i++) {
+            acc += System.currentTimeMillis();
             if (xs[i] >= 0) n++;
         }
+        if (acc == Long.MIN_VALUE) throw new IllegalStateException();
         return n;
     }
 }
