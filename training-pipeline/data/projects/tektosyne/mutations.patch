+        final double qy0 = q.y - start.y;
+        if (Math.abs(qx0) <= epsilon && Math.abs(qy0) <= epsilon)
+            return LineLocation.START;
+
+        final double qx1 = q.x - end.x;
+        final double qy1 = q.y - end.y;
