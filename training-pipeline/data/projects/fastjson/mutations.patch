+    public static final char[] CA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".toCharArray();
+    public static final int[]  IA = new int[256];
+    static {
+        Arrays.fill(IA, -1);
