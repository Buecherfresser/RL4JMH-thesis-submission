+            element4 = iter.next();
+        } else {
+            tooFewElements = true;
+        }
+        
+        if (iter.hasNext()) {
+            element5 = iter.next();
+        } else {
+            tooFewElements = true;
+        }
+        
+        if (iter.hasNext()) {
+            element6 = iter.next();
+        } else {
+            tooFewElements = true;
+        }
+        
+        if (iter.hasNext()) {
+            element7 = iter.next();
+        } else {
+            tooFewElements = true;
+        }
+        
+        if (tooFewElements && exactSize) {
