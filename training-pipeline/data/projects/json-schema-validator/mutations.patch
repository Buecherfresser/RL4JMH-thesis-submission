+    public boolean contains(String segment) {
+        boolean result = segment.equals(this.pathSegment);
+        if (result) {
+            return true;
+        }
+        NodePath path = this.getParent();
+        while (path != null) {
+            if (segment.equals(path.pathSegment)) {
+                return true;
+            }
+            path = path.getParent();
+        }
+        return false;
+    }
