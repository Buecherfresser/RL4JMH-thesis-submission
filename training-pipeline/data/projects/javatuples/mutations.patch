+    
+    public <X> LabelValue<X,B> setLabel(final X label) {
+        return new LabelValue<X,B>(label, this.value);
+    }
+    
+    
+    public <Y> LabelValue<A,Y> setValue(final Y value) {
+        return new LabelValue<A,Y>(this.label, value);
+    }
