```java
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import io.reactivex.rxjava3.core.Completable;
import io.reactivex.rxjava3.core.CompletableSource;
import io.reactivex.rxjava3.disposables.Disposable;
import io.reactivex.rxjava3.internal.operators.completable.CompletablePeek;

/**
 * Benchmark for {@link CompletablePeek} measuring the overhead of the peek
 * callbacks when the upstream completes normally.
 *
 * The benchmark runs in {@link Mode#Throughput} (operations per second) and
 * reports the result in milliseconds. It follows JMH best‑practice:
 * <ul>
 *   <li>State is scoped to a single thread to avoid contention.</li>
 *   <li>All allocations are performed in {@link Setup} to keep the measured
 *       method focused on the operator execution.</li>
 *   <li>Blackhole is used to prevent dead‑code elimination.</li>
 *   <li>Reasonable warm‑up, measurement and fork settings are provided.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class CompletablePeekBenchmark {

    /** The Completable under test – a source that completes immediately. */
    private CompletableSource source;

    /** The CompletablePeek instance with no‑op callbacks. */
    private Completable peeked;

    @Setup(Level.Trial)
    public void setUp() {
        // A source that completes synchronously.
        source = Completable.complete();

        // No‑op callbacks for all peek points.
        CompletablePeek peekOperator = new CompletablePeek(
                source,
                d -> { /* onSubscribe */ },
                e -> { /* onError */ },
                () -> { /* onComplete */ },
                () -> { /* onTerminate */ },
                () -> { /* onAfterTerminate */ },
                () -> { /* onDispose */ }
        );

        // Expose as a public Completable for the benchmark method.
        peeked = Completable.wrap(peekOperator);
    }

    /**
     * Subscribes to the {@link CompletablePeek} and blocks until completion.
     * The Blackhole is used to consume the result (void) and to prevent the
     * JIT from optimizing away the call.
     *
     * @param bh Blackhole to avoid dead‑code elimination.
     */
    @Benchmark
    public void subscribeAndAwait(Blackhole bh) {
        // blockingAwait returns void; we still pass the Blackhole to keep the
        // method non‑empty from the JIT perspective.
        peeked.blockingAwait();
        bh.consume(0);
    }
}
```