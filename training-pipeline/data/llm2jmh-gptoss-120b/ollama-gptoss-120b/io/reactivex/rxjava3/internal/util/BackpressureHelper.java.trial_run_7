```java
package io.reactivex.rxjava3.internal.util;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for the back‑pressure helper arithmetic methods.
 *
 * The benchmark class itself is a {@code @State}, so its fields are used
 * directly in the benchmark methods. No additional parameter classes are
 * required.
 */
@State(Scope.Thread)
public class BackpressureHelperBenchmark {

    /** Parameters supplied by JMH. */
    @Param({ "0", "1", "54321", "9223372036854775807" })
    public long a;

    @Param({ "0", "1", "54321", "9223372036854775807" })
    public long b;

    @Param({ "0", "1", "1000", "9223372036854775807" })
    public long n;

    /** Public no‑arg constructor required by JMH. */
    public BackpressureHelperBenchmark() {
        // Prevent instantiation
    }

    // -------------------------------------------------------------------------
    // Helper methods (unchanged)
    // -------------------------------------------------------------------------
    public static long addCap(long a, long b) {
        long res = a + b;
        if (res < 0L) {
            return Long.MAX_VALUE;
        }
        return res;
    }

    public static long multiplyCap(long a, long b) {
        if (a == 0L || b == 0L) {
            return 0L;
        }
        long result = a * b;
        if (result / a != b) {
            return Long.MAX_VALUE;
        }
        return result;
    }

    // -------------------------------------------------------------------------
    // Benchmark methods
    // -------------------------------------------------------------------------
    @Benchmark
    public long add(Blackhole bh) {
        long r = addCap(a, b);
        bh.consume(r);
        return r;
    }

    @Benchmark
    public long multiply(Blackhole bh) {
        long r = multiplyCap(a, b);
        bh.consume(r);
        return r;
    }
}
