package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observable;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for the {@code Observable.take} operator which internally uses {@code ObservableTake}.
 * Measures throughput (operations per second) of taking a limited number of items from a source.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class ObservableTakeThroughputBenchmark {

    /**
     * Total number of items emitted by the source Observable.
     * Must be >= {@code limit} to avoid premature completion.
     */
    @Param({"1000", "1000000"})
    public int sourceSize;

    /**
     * Number of items to take from the source.
     */
    @Param({"10", "1000", "100000"})
    public int limit;

    private Observable<Integer> source;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a cold, synchronous source that emits integers from 0 to sourceSize-1.
        source = Observable.range(0, sourceSize);
    }

    @Benchmark
    public void take(Blackhole bh) {
        // Apply the take operator and consume the emitted items with Blackhole to prevent dead‑code elimination.
        source.take(limit).blockingSubscribe(bh::consume);
    }
}
```