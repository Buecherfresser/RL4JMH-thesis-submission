/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableOnBackpressureBufferStrategy}.
 *
 * The benchmark measures the throughput (items processed per second) of the
 * {@code onBackpressureBuffer} operator under different buffer sizes and
 * overflow strategies. It uses a simple synchronous {@link Flowable#range}
 * source to isolate the cost of the operator itself.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@State(Scope.Thread)
public class FlowableOnBackpressureBufferStrategyBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "1000", "100000", "1000000" })
    public int itemCount;

    /**
     * Buffer size passed to the operator.
     */
    @Param({ "1000", "100000", "1000000" })
    public long bufferSize;

    /**
     * The Flowable under test, created once per trial.
     */
    private Flowable<Integer> testFlowable;

    @Setup(Level.Trial)
    public void setUp() {
        // Simple synchronous source; no scheduler is involved to isolate operator cost.
        Flowable<Integer> source = Flowable.range(0, itemCount);
        // Apply the operator with a no‑op overflow action and no‑op dropped consumer.
        testFlowable = source.onBackpressureBuffer(bufferSize, () -> {
            /* no‑op overflow action */
        }, BackpressureOverflowStrategy.ERROR, v -> {
            /* no‑op dropped consumer */
        });
    }

    /**
     * Executes the Flowable and consumes all emitted items.
     *
     * @param bh Blackhole to consume items and avoid dead‑code elimination.
     */
    @Benchmark
    public void backpressureBufferThroughput(Blackhole bh) {
        // blockingSubscribe runs the whole stream synchronously and returns only after completion.
        testFlowable.blockingSubscribe(bh::consume);
    }
}
