/**
 * Benchmark for {@link FlowableConcatMapEager} (the eager concatMap operator).
 *
 * The benchmark measures the throughput (operations per second) of processing a
 * fixed-size upstream {@link Flowable} with a mapper that returns a small inner
 * {@link Flowable}. The parameters (maxConcurrency, prefetch, errorMode) are
 * chosen to reflect typical usage patterns while still exercising the core
 * logic of the operator.
 *
 * Best‑practice notes:
 * • Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * • Initialise the source Flowable in @Setup(Level.Trial) so that the cost of
 *   building the pipeline is not counted in the benchmark.
 * • Use Blackhole to consume the emitted items and prevent dead‑code elimination.
 * • Run with several warm‑up iterations and measurement iterations to let the
 *   JIT stabilize.
 * • Fork the JVM to isolate benchmark runs.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableConcatMapEagerBenchmark {

    /**
     * Number of items emitted by the upstream Flowable.
     */
    @Param({ "1000", "10000", "100000" })
    public int upstreamSize;

    /**
     * Max concurrency for the eager concatMap operator.
     */
    @Param({ "4", "8", "16" })
    public int maxConcurrency;

    /**
     * Prefetch size for each inner subscriber.
     */
    @Param({ "32", "64", "128" })
    public int prefetch;

    /**
     * Error handling mode.
     */
    @Param({ "IMMEDIATE", "BOUNDARY", "END" })
    public ErrorMode errorMode;

    /**
     * The prepared Flowable pipeline to be benchmarked.
     */
    private Flowable<Integer> flowable;

    /**
     * Mapper that creates a small inner Flowable for each upstream item.
     */
    private final Function<Integer, Publisher<Integer>> mapper = v -> Flowable.just(v).subscribeOn(Schedulers.computation());

    @Setup(Level.Trial)
    public void setUp() {
        // Upstream emits a range of integers.
        Flowable<Integer> source = Flowable.range(1, upstreamSize);
        // Apply the eager concatMap operator with the configured parameters.
        flowable = source.concatMapEager(mapper, maxConcurrency, prefetch, errorMode);
    }

    /**
     * Executes the pipeline and consumes all emitted items.
     *
     * @param bh Blackhole to consume the items and avoid dead‑code elimination.
     */
    @Benchmark
    public void eagerConcatMapThroughput(Blackhole bh) {
        // blockingSubscribe ensures the benchmark measures the full processing time.
        flowable.blockingSubscribe(bh::consume);
    }
}
