package io.reactivex.rxjava3.internal.operators.observable;

import java.util.concurrent.TimeUnit;
import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.Consumer;
import io.reactivex.rxjava3.schedulers.*;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.*;

@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class ObservableSampleTimedBenchmark {

    @Param({ "100000" })
    public int itemCount;

    @Param({ "1" })
    public long periodMs;

    private Scheduler scheduler;
    private Observable<Integer> source;

    /** No‑op consumer for the onDropped callback (typed to Integer). */
    private static final Consumer<Integer> NOOP = v -> {};

    @Setup(Level.Trial)
    public void setUp() {
        scheduler = Schedulers.computation();
        source = Observable.range(0, itemCount);
    }

    @Benchmark
    public void sampleTimedNoLast(Blackhole bh) {
        // 5‑argument overload with emitLast = false and a non‑null onDropped consumer.
        source.sample(periodMs, TimeUnit.MILLISECONDS, scheduler, false, NOOP)
              .blockingSubscribe(bh::consume);
    }

    @Benchmark
    public void sampleTimedEmitLast(Blackhole bh) {
        // 5‑argument overload with emitLast = true and a non‑null onDropped consumer.
        source.sample(periodMs, TimeUnit.MILLISECONDS, scheduler, true, NOOP)
              .blockingSubscribe(bh::consume);
    }
}
