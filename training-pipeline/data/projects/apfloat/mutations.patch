-        Apfloat one = new Apfloat(1, Apfloat.INFINITE, x.radix());
-        long xPrecision = Util.ifFinite(targetPrecision, targetPrecision + one.equalDigits(x)); // If the log() argument is close to 1, the result is less accurate
