-     */
-    @Override
-    public int readSInt32() throws IOException
-    {
-        checkIfPackedField();
-        final int n = readRawVarint32();
-        return (n >>> 1) ^ -(n & 1);
-    }
-
-    /**
-     * Read an {@code sint64} field value from the internal buffer.
-     */
-    @Override
-    public long readSInt64() throws IOException
