```
package io.reactivex.rxjava3.internal.jdk8.benchmark;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.parallel.ParallelFlowable;
import io.reactivex.rxjava3.internal.jdk8.ParallelMapOptional;
import io.reactivex.rxjava3.functions.Function;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.Optional;
import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link ParallelMapOptional}.
 *
 * Measures the throughput (operations per second) of the parallel mapping
 * operator when the mapper returns {@link Optional#empty()} for half of the
 * items and {@link Optional#of(Object)} for the other half.
 *
 * The benchmark follows best practices:
 * - @State(Scope.Thread) isolates benchmark state per thread.
 * - @Setup creates immutable data structures used in the benchmark.
 * - Blackhole consumes the downstream values to prevent dead‑code elimination.
 * - Warm‑up, measurement, and fork parameters are chosen to give reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class ParallelMapOptionalBenchmark {

    /** Number of items emitted by the source Flowable. */
    @Param({"1000", "100000", "1000000"})
    public int itemCount;

    /** Parallelism level (number of rails). */
    @Param({"1", "2", "4", "8"})
    public int parallelism;

    /** Mapper function used by ParallelMapOptional. */
    private Function<Integer, Optional<Integer>> mapper;

    /** Source ParallelFlowable that will be wrapped by ParallelMapOptional. */
    private ParallelFlowable<Integer> source;

    @Setup(Level.Trial)
    public void setUp() {
        // Simple mapper: even numbers are emitted, odd numbers are filtered out.
        mapper = i -> (i & 1) == 0 ? Optional.of(i) : Optional.empty();

        // Create a ParallelFlowable from a range of integers.
        // The source is created once per trial; each benchmark iteration will
        // subscribe a fresh set of subscribers.
        source = Flowable.range(1, itemCount)
                .parallel(parallelism);
    }

    /**
     * Executes the ParallelMapOptional operator and consumes all emitted items.
     *
     * @param bh Blackhole to consume downstream values.
     */
    @Benchmark
    public void mapOptionalThroughput(Blackhole bh) {
        // Wrap the source with the operator under test.
        ParallelMapOptional<Integer, Integer> operator =
                new ParallelMapOptional<>(source, mapper);

        // Convert back to a sequential Flowable and block while consuming.
        operator.sequential()
                .subscribe(bh::consume);
        // The subscription completes when all items have been processed.
    }
}
```