@State(Scope.Thread)
public class FlowableToListBenchmark {

    @Param({ "1000", "10000", "100000" })
    public int size;

    @Param({ "ArrayList", "LinkedList" })
    public String collectionType;

    private Flowable<Integer> source;

    private Supplier<Collection<Integer>> collectionSupplier;

    @Setup(Level.Trial)
    public void setUp() {
        source = Flowable.range(1, size);
        switch(collectionType) {
            case "ArrayList":
                collectionSupplier = () -> new java.util.ArrayList<>();
                break;
            case "LinkedList":
                collectionSupplier = () -> new java.util.LinkedList<>();
                break;
            default:
                collectionSupplier = () -> new java.util.ArrayList<>();
        }
    }

    @Benchmark
    @BenchmarkMode(Mode.Throughput)
    @OutputTimeUnit(TimeUnit.MILLISECONDS)
    @Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
    @Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
    @Fork(1)
    public void toListThroughput(Blackhole bh) {
        // The public API uses toList(Supplier) which internally uses FlowableToList
        Collection<Integer> result = source.toList(collectionSupplier).blockingGet();
        bh.consume(result);
    }
}
