package io.reactivex.rxjava3.internal.operators.maybe.benchmark;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.functions.Action;

import java.util.concurrent.TimeUnit;

@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class MaybeDoOnTerminateBenchmark {

    private Maybe<Integer> plain;
    private Maybe<Integer> withDoOnTerminate;
    private Action noop;

    @Setup
    public void setup() {
        // No‑op Action to isolate the overhead of the operator itself
        noop = () -> {};

        // Baseline: a plain Maybe that emits a single value and completes
        plain = Maybe.just(1);

        // Variant: the same Maybe wrapped with doOnTerminate
        withDoOnTerminate = Maybe.just(1).doOnTerminate(noop);
    }

    @Benchmark
    public void plainMaybe(Blackhole bh) {
        // blockingGet forces subscription and termination synchronously
        int value = plain.blockingGet();
        bh.consume(value);
    }

    @Benchmark
    public void maybeDoOnTerminate(Blackhole bh) {
        int value = withDoOnTerminate.blockingGet();
        bh.consume(value);
    }
}
```