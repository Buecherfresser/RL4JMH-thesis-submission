/**
 * Benchmark for the internal {@code ObservableSwitchMap} operator via the public {@code switchMap}
 * API. Measures throughput (operations per second) of a simple switchMap scenario where each
 * upstream item is mapped to a scalar {@code Observable.just} source.
 *
 * The benchmark follows JMH best‑practice guidelines:
 * - State is scoped to a single thread to avoid contention.
 * - All objects are created in a @Setup method (Level.Trial) to exclude allocation overhead.
 * - Blackhole is used to consume emitted items and prevent dead‑code elimination.
 * - Warm‑up, measurement, and fork parameters are defined explicitly.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@State(Scope.Thread)
public class ObservableSwitchMapBenchmark {

    /**
     * Number of items emitted by the upstream Observable per subscription.
     */
    @Param({ "1000", "10000", "100000" })
    public int itemCount;

    /**
     * Buffer size used by the switchMap operator.
     */
    @Param({ "128" })
    public int bufferSize;

    /**
     * The upstream Observable (cold source).
     */
    private Observable<Integer> source;

    /**
     * Mapper function that creates a scalar Observable for each upstream item.
     */
    private Function<Integer, Observable<Integer>> mapper;

    /**
     * The Observable under test (switchMap applied).
     */
    private Observable<Integer> switched;

    @Setup(Level.Trial)
    public void setUp() {
        // Cold source that emits a range of integers synchronously.
        source = Observable.range(1, itemCount);
        // Simple mapper: each integer is turned into an Observable.just(integer).
        mapper = i -> Observable.just(i);
        // Apply switchMap with the configured buffer size.
        switched = source.switchMap(mapper, bufferSize);
    }

    /**
     * Executes the switchMap pipeline and consumes all emitted items.
     *
     * @param bh Blackhole to consume items and avoid dead‑code elimination.
     */
    @Benchmark
    public void switchMapThroughput(Blackhole bh) {
        // Subscribe synchronously; Observable.range and switchMap run on the calling thread.
        switched.subscribe(bh::consume);
    }
}
