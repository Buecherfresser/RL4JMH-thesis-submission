+     * @param customMapping 用户自定义的mapping
+     */
+    public ClassMap(Type<A> aType, Type<B> bType, List<FieldMap> fieldsMapping, boolean mapOnNull,
+                    AtoBMapping<A, B> customMapping) {
+        this.aType = aType;
