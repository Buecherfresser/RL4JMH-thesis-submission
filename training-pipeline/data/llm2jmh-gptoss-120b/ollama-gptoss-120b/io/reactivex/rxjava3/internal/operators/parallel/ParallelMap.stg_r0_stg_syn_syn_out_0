/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.parallel.ParallelMap}.
 * Measures the throughput of a simple mapping operation executed in parallel.
 *
 * The benchmark runs the pipeline:
 *   Flowable.range(0, SIZE)
 *       .parallel(PARALLELISM)
 *       .runOn(Schedulers.computation())
 *       .map(mapper)
 *       .sequential()
 *       .blockingForEach(blackhole::consume);
 *
 * This isolates the overhead of the ParallelMap operator while keeping the source
 * and downstream cheap.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class ParallelMapBenchmark {

    /**
     * Number of items emitted per benchmark iteration.
     */
    @Param({ "1000", "10000", "100000" })
    public int size;

    /**
     * Parallelism level (number of rails).
     */
    @Param({ "1", "2", "4", "8" })
    public int parallelism;

    private ParallelFlowable<Integer> source;

    private Function<Integer, Integer> mapper;

    @Setup(Level.Trial)
    public void setUp() {
        // Simple identity mapper with a tiny arithmetic operation to avoid dead-code elimination.
        mapper = i -> i + 1;
        // Create a parallel flowable that emits a range of integers.
        source = Flowable.range(0, size).parallel(parallelism).runOn(Schedulers.computation());
    }

    @Benchmark
    public void parallelMapThroughput(Blackhole bh) {
        // Apply the ParallelMap operator and consume all items.
        source.map(mapper).sequential().blockingForEach(bh::consume);
    }
}
