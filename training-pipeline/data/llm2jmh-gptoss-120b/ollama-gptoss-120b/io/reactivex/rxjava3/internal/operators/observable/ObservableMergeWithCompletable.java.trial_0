```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.Completable;
import io.reactivex.rxjava3.core.Observable;

/**
 * Benchmark for the {@code Observable.mergeWith(Completable)} operator,
 * which internally uses {@code ObservableMergeWithCompletable}.
 *
 * The benchmark measures throughput (operations per second) of merging
 * a synchronous {@link Observable} with a synchronous {@link Completable}
 * and consuming all items.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Perform all work synchronously (no async schedulers) to focus on operator overhead.
 * - Use blackhole-friendly return value (the count) to prevent dead‑code elimination.
 * - Warm‑up, measurement, and fork settings are chosen to give stable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@Threads(1)
public class ObservableMergeWithCompletableBenchmark {

    @State(Scope.Thread)
    public static class BenchmarkState {
        /** Number of items emitted by the source Observable. */
        @Param({"1000", "10000", "100000"})
        public int itemCount;

        /** Source Observable emitting a range of integers. */
        Observable<Integer> source;

        /** Completable that completes immediately. */
        Completable other;

        @Setup(Level.Trial)
        public void setUp() {
            // Synchronous source and Completable to isolate operator overhead.
            source = Observable.range(1, itemCount);
            other = Completable.complete();
        }
    }

    /**
     * Executes the mergeWith operator and blocks until completion,
     * returning the number of items emitted. The returned value is used
     * by JMH to prevent dead‑code elimination.
     *
     * @param state the benchmark state containing the source and Completable
     * @return the count of emitted items (should equal {@code state.itemCount})
     */
    @Benchmark
    public int mergeWithCompletable(BenchmarkState state) {
        // The public API uses the internal ObservableMergeWithCompletable implementation.
        return state.source
                .mergeWith(state.other)
                .blockingCount();
    }
}
```