package io.reactivex.rxjava3.internal.operators.flowable;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.*;
import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link FlowableGroupJoin}.
 *
 * The benchmark creates two finite Flowables (left and right) of configurable size,
 * joins them with never‑ending end publishers (so groups stay open for the whole
 * stream), and materialises the result selector into a simple {@code String}.
 *
 * Throughput mode measures how many join operations can be performed per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class FlowableGroupJoinBenchmark {

    /** Number of items emitted by each source Flowable. */
    @Param({"1000", "10000"})
    public int size;

    private Flowable<String> joined;

    @Setup(Level.Invocation)
    public void setUp() {
        // Simple integer sources.
        Flowable<Integer> left = Flowable.range(1, size);
        Flowable<Integer> right = Flowable.range(1, size);

        // Keep each group open for the whole stream.
        Function<Integer, Publisher<Object>> leftEnd = v -> Flowable.never();
        Function<Integer, Publisher<Object>> rightEnd = v -> Flowable.never();

        // Result selector: combine the left value with the count of right values seen so far.
        BiFunction<Integer, Flowable<Integer>, String> resultSelector = (l, rs) ->
                l + ":" + rs.count().blockingGet();

        // Build the operator under test.
        joined = new FlowableGroupJoin<>(
                left,
                right,
                leftEnd,
                rightEnd,
                resultSelector
        );
    }

    @Benchmark
    public void groupJoin(Blackhole bh) {
        // Subscribe and consume all emitted items. blockingSubscribe ensures the benchmark
        // measures the full lifecycle of the operator.
        joined.blockingSubscribe(bh::consume);
    }
}
```