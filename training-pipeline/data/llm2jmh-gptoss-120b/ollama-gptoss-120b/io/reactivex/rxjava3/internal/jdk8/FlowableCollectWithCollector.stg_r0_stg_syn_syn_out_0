/**
 * JMH benchmark for {@link FlowableCollectWithCollector}.
 *
 * Measures the throughput of collecting a Flowable of integers into a {@link List}
 * using a Java {@link Collector}.
 *
 * The benchmark follows best practices:
 * - Uses @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Performs a warm‑up phase to let the JIT optimize the code.
 * - Uses Blackhole to consume the result and prevent dead‑code elimination.
 * - Configured for throughput mode (operations per second).
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@State(Scope.Thread)
public class FlowableCollectWithCollectorBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "1000", "10000", "100000" })
    public int itemCount;

    /**
     * The source Flowable emitting a range of integers.
     */
    private Flowable<Integer> source;

    /**
     * Collector that accumulates items into a List.
     */
    private Collector<Integer, ?, List<Integer>> collector;

    /**
     * The operator under test.
     */
    private FlowableCollectWithCollector<Integer, ?, List<Integer>> operator;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a simple source that emits a deterministic range of integers.
        source = Flowable.range(1, itemCount);
        // Use the standard toList collector.
        collector = Collectors.toList();
        // Instantiate the operator directly (equivalent to source.collect(collector)).
        operator = new FlowableCollectWithCollector<>(source, collector);
    }

    /**
     * Benchmark method that subscribes to the operator and blocks until the collection
     * is complete. The resulting list is consumed by Blackhole to avoid dead‑code elimination.
     */
    @Benchmark
    public void collectToList(Blackhole bh) {
        // blockingFirst() will wait for the Flowable to emit the single aggregated result.
        List<Integer> result = operator.blockingFirst();
        // Consume the result so the JIT cannot discard the whole computation.
        bh.consume(result);
    }
}
