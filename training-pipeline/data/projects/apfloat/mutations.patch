-                t = pow(result, n);
-                t = lastIterationExtendPrecision(iterations, -1, t);
-
-                result = lastIterationExtendPrecision(iterations, -1, result);
-                result = result.add(result.multiply(one.subtract(x.multiply(t))).divide(divisor));
