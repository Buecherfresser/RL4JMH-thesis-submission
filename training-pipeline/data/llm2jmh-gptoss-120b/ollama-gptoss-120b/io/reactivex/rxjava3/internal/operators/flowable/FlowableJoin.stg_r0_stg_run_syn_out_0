/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableJoin}
 * measuring throughput of the join operation.
 *
 * The benchmark creates two finite Flowables, applies the join operator
 * with simple end publishers (timers) and a trivial result selector.
 * A custom Subscriber requests {@code Long.MAX_VALUE} to avoid back‑pressure
 * issues that caused {@link io.reactivex.rxjava3.exceptions.MissingBackpressureException}
 * in the original version.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class FlowableJoinBenchmark {

    @Param({ "100", "1000", "10000" })
    public int size;

    private Flowable<Integer> joinedFlowable;

    private static final Function<Integer, Flowable<Long>> LEFT_END = l -> Flowable.timer(1, TimeUnit.MILLISECONDS);

    private static final Function<Integer, Flowable<Long>> RIGHT_END = r -> Flowable.timer(1, TimeUnit.MILLISECONDS);

    private static final BiFunction<Integer, Integer, Integer> RESULT_SELECTOR = (l, r) -> l + r;

    @Setup(Level.Invocation)
    public void setUp() {
        Flowable<Integer> left = Flowable.range(1, size);
        Flowable<Integer> right = Flowable.range(1, size);
        joinedFlowable = left.join(right, LEFT_END, RIGHT_END, RESULT_SELECTOR);
    }

    @Benchmark
    public void joinThroughput(Blackhole bh) throws InterruptedException {
        CountDownLatch latch = new CountDownLatch(1);
        joinedFlowable.subscribe(new Subscriber<Integer>() {

            @Override
            public void onSubscribe(Subscription s) {
                // request unbounded to avoid back‑pressure errors
                s.request(Long.MAX_VALUE);
            }

            @Override
            public void onNext(Integer t) {
                bh.consume(t);
            }

            @Override
            public void onError(Throwable t) {
                t.printStackTrace();
                latch.countDown();
            }

            @Override
            public void onComplete() {
                latch.countDown();
            }
        });
        latch.await();
    }
}
