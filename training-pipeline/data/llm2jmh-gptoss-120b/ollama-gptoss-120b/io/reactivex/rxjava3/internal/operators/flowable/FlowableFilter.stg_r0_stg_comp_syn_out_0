/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableFilter}.
 * Measures the throughput of the filter operator under different workloads and predicate
 * characteristics. The benchmark uses {@link Flowable#range(int, int)} as a deterministic
 * upstream source and consumes the filtered items with a {@link Blackhole} to avoid dead‑code
 * elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
public class FlowableFilterBenchmark {

    /**
     * Number of items emitted by the upstream {@link Flowable#range(int, int)}.
     */
    @Param({ "1000", "10000", "100000" })
    public int itemCount;

    /**
     * Type of predicate applied in the filter operator.
     * <ul>
     *   <li>alwaysTrue – predicate that always returns {@code true}</li>
     *   <li>alwaysFalse – predicate that always returns {@code false}</li>
     *   <li>mod3 – returns {@code true} for values divisible by 3 (≈33% pass)</li>
     * </ul>
     */
    @Param({ "alwaysTrue", "alwaysFalse", "mod3" })
    public String predicateType;

    private Predicate<Integer> predicate;

    @Setup(Level.Trial)
    public void setUp() {
        switch(predicateType) {
            case "alwaysTrue":
                predicate = v -> true;
                break;
            case "alwaysFalse":
                predicate = v -> false;
                break;
            case "mod3":
                predicate = v -> (v % 3) == 0;
                break;
            default:
                throw new IllegalArgumentException("Unsupported predicate type: " + predicateType);
        }
    }

    @Benchmark
    public void filterThroughput(Blackhole bh) {
        Flowable<Integer> source = Flowable.range(1, itemCount);
        source.filter(predicate).blockingForEach(bh::consume);
    }
}
