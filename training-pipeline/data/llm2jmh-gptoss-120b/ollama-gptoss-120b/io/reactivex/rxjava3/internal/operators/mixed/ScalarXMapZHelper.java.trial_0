package io.reactivex.rxjava3.internal.operators.mixed;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.Function;
import io.reactivex.rxjava3.internal.disposables.EmptyDisposable;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.Objects;
import java.util.concurrent.TimeUnit;
import java.util.function.Supplier;

/**
 * JMH microbenchmarks for {@link ScalarXMapZHelper}.
 *
 * The benchmarks measure the throughput of the three scalar‑optimisation helpers
 * when the source is a {@link Supplier} that returns a non‑null value and the mapper
 * returns a simple reactive source (Completable.complete(), Maybe.just(...), Single.just(...)).
 *
 * Best practices applied:
 * • @State(Scope.Thread) isolates benchmark state per thread.
 * • @Setup prepares immutable objects once per iteration.
 * • Blackhole is used to consume the boolean result to avoid dead‑code elimination.
 * • Warm‑up, measurement, and fork parameters follow typical JMH recommendations.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
public class ScalarXMapZHelperBenchmark {

    @State(Scope.Thread)
    public static class BenchmarkState {
        // Source that implements Supplier<T>
        Supplier<Integer> supplier;

        // Mappers for each reactive type
        Function<Integer, CompletableSource> completableMapper;
        Function<Integer, MaybeSource<Integer>> maybeMapper;
        Function<Integer, SingleSource<Integer>> singleMapper;

        // Observers that simply discard signals
        CompletableObserver completableObserver;
        Observer<Integer> maybeObserver;
        Observer<Integer> singleObserver;

        @Setup(Level.Trial)
        public void setUp() {
            supplier = () -> 42; // non‑null scalar value

            completableMapper = v -> Completable.complete();

            maybeMapper = v -> Maybe.just(v);

            singleMapper = v -> Single.just(v);

            completableObserver = new CompletableObserver() {
                @Override public void onSubscribe(Disposable d) {}
                @Override public void onComplete() {}
                @Override public void onError(Throwable e) {}
            };

            maybeObserver = new Observer<Integer>() {
                @Override public void onSubscribe(Disposable d) {}
                @Override public void onNext(Integer value) {}
                @Override public void onError(Throwable e) {}
                @Override public void onComplete() {}
            };

            singleObserver = maybeObserver; // same implementation works for Single
        }
    }

    @Benchmark
    public void tryAsCompletable(BenchmarkState state, Blackhole bh) {
        boolean result = ScalarXMapZHelper.tryAsCompletable(
                state.supplier,
                state.completableMapper,
                state.completableObserver);
        bh.consume(result);
    }

    @Benchmark
    public void tryAsMaybe(BenchmarkState state, Blackhole bh) {
        boolean result = ScalarXMapZHelper.tryAsMaybe(
                state.supplier,
                state.maybeMapper,
                state.maybeObserver);
        bh.consume(result);
    }

    @Benchmark
    public void tryAsSingle(BenchmarkState state, Blackhole bh) {
        boolean result = ScalarXMapZHelper.tryAsSingle(
                state.supplier,
                state.singleMapper,
                state.singleObserver);
        bh.consume(result);
    }
}
