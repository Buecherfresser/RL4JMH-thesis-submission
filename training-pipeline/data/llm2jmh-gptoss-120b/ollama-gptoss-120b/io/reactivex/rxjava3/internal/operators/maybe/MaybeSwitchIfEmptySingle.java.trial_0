```
package io.reactivex.rxjava3.internal.operators.maybe.benchmark;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.internal.operators.maybe.MaybeSwitchIfEmptySingle;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link MaybeSwitchIfEmptySingle}.
 *
 * <p>Two scenarios are measured:
 * <ul>
 *   <li>Source {@code Maybe} emits a value – the {@code Single} fallback is never subscribed.</li>
 *   <li>Source {@code Maybe} completes empty – the {@code Single} fallback is subscribed.</li>
 * </ul>
 *
 * <p>Throughput mode is used because the operator is typically used in high‑volume reactive pipelines.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 1, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class MaybeSwitchIfEmptySingleBenchmark {

    private MaybeSwitchIfEmptySingle<Integer> switchIfEmptyWithValue;
    private MaybeSwitchIfEmptySingle<Integer> switchIfEmptyEmpty;

    @Setup(Level.Trial)
    public void setUp() {
        // Scenario 1: source Maybe emits a value, fallback Single is never used.
        Maybe<Integer> sourceWithValue = Maybe.just(1);
        Single<Integer> fallback = Single.just(2);
        switchIfEmptyWithValue = new MaybeSwitchIfEmptySingle<>(sourceWithValue, fallback);

        // Scenario 2: source Maybe completes empty, fallback Single is subscribed.
        Maybe<Integer> sourceEmpty = Maybe.empty();
        switchIfEmptyEmpty = new MaybeSwitchIfEmptySingle<>(sourceEmpty, fallback);
    }

    /**
     * Benchmark where the source {@code Maybe} emits a value.
     *
     * @param bh Blackhole to consume the result and prevent dead‑code elimination.
     */
    @Benchmark
    public void testSourceEmitsValue(Blackhole bh) {
        // blockingGet is used to obtain the terminal value synchronously for measurement.
        Integer result = switchIfEmptyWithValue.blockingGet();
        bh.consume(result);
    }

    /**
     * Benchmark where the source {@code Maybe} completes empty and the fallback {@code Single}
     * is subscribed.
     *
     * @param bh Blackhole to consume the result and prevent dead‑code elimination.
     */
    @Benchmark
    public void testSourceEmptySwitches(Blackhole bh) {
        Integer result = switchIfEmptyEmpty.blockingGet();
        bh.consume(result);
    }
}
```