/**
 * Benchmark for {@link MaybeFlatMapBiSelector}.
 *
 * The benchmark measures the throughput of a simple {@code Maybe} pipeline that
 * uses the flatMapBiSelector operator. The pipeline is:
 *
 * <pre>
 * Maybe.just(1)
 *     .flatMapBiSelector(v -> Maybe.just(v * 2), (a, b) -> a + ":" + b)
 * </pre>
 *
 * The {@code blockingGet()} call forces the subscription to be executed
 * synchronously, allowing JMH to measure the end‑to‑end cost of the operator.
 *
 * Best practices applied:
 * <ul>
 *   <li>State is scoped to a single thread to avoid contention.</li>
 *   <li>All objects are created in {@link Setup} to exclude allocation overhead.</li>
 *   <li>Blackhole is used to consume the result and prevent dead‑code elimination.</li>
 *   <li>Warm‑up, measurement, and fork parameters are chosen to provide stable results.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@State(Scope.Thread)
public class MaybeFlatMapBiSelectorBenchmark {

    private Maybe<String> benchmarkMaybe;

    @Setup(Level.Trial)
    public void setup() {
        // Source Maybe emitting a single integer.
        Maybe<Integer> source = Maybe.just(1);
        // Mapper that transforms the upstream value into another Maybe.
        Function<Integer, MaybeSource<Integer>> mapper = v -> Maybe.just(v * 2);
        // Result selector that combines the original and inner values.
        BiFunction<Integer, Integer, String> resultSelector = (a, b) -> a + ":" + b;
        // Create the internal operator directly.
        benchmarkMaybe = new MaybeFlatMapBiSelector<>(source, mapper, resultSelector);
    }

    @Benchmark
    public void flatMapBiSelectorThroughput(Blackhole bh) {
        // Execute the pipeline synchronously and consume the result.
        bh.consume(benchmarkMaybe.blockingGet());
    }
}
