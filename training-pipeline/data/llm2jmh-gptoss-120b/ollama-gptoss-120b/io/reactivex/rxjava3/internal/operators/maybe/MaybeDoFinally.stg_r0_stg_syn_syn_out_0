/**
 * JMH benchmark measuring the throughput impact of the {@code Maybe.doFinally} operator
 * compared to a plain {@code Maybe.just} source.
 *
 * <p>Best practices applied:
 * <ul>
 *   <li>Separate {@code @State} for immutable per‑thread data.</li>
 *   <li>Warm‑up and measurement iterations to let the JIT stabilize.</li>
 *   <li>Multiple forks to reduce noise from JVM start‑up.</li>
 *   <li>Use of {@link Blackhole} to prevent dead‑code elimination.</li>
 *   <li>Throughput mode (operations per time unit) which is appropriate for reactive stream
 *       operators where the goal is to maximize the number of processed items.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class MaybeDoFinallyBenchmark {

    /**
     * Baseline Maybe without any operator.
     */
    private Maybe<Integer> baseline;

    /**
     * Maybe with the {@code doFinally} operator applied.
     */
    private Maybe<Integer> withDoFinally;

    /**
     * No‑op action used for the {@code doFinally} operator.
     */
    private static final Action NOOP = () -> {
        // intentionally empty
    };

    @Setup(Level.Trial)
    public void setUp() {
        // Simple source emitting a single integer.
        baseline = Maybe.just(1);
        // Same source wrapped with the doFinally operator.
        withDoFinally = Maybe.just(1).doFinally(NOOP);
    }

    /**
     * Benchmark the plain {@code Maybe.just} source.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void baseline(BenchmarkState state, Blackhole bh) {
        bh.consume(state.baseline.blockingGet());
    }

    /**
     * Benchmark the {@code Maybe.just} source with {@code doFinally} applied.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void doFinally(BenchmarkState state, Blackhole bh) {
        bh.consume(state.withDoFinally.blockingGet());
    }

    /**
     * State holder exposing the prepared Maybe instances to benchmark methods.
     */
    @State(Scope.Thread)
    public static class BenchmarkState {

        Maybe<Integer> baseline;

        Maybe<Integer> withDoFinally;

        @Setup(Level.Trial)
        public void init() {
            baseline = Maybe.just(1);
            withDoFinally = Maybe.just(1).doFinally(NOOP);
        }
    }
}
