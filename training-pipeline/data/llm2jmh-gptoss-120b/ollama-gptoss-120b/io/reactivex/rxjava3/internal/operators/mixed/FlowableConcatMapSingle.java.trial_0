```
package io.reactivex.rxjava3.benchmarks.internal.operators.mixed;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.internal.operators.mixed.FlowableConcatMapSingle;
import io.reactivex.rxjava3.internal.util.ErrorMode;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for {@link FlowableConcatMapSingle}.
 *
 * The benchmark measures the throughput (operations per second) of the
 * concatMapSingle operator when processing a fixed-size synchronous source.
 *
 * Best practices applied:
 * - @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - @Setup to create immutable source and mapper once per benchmark iteration.
 * - @Param to allow experimentation with different prefetch sizes.
 * - Blackhole consumption to prevent dead-code elimination.
 * - Mode.Throughput with TimeUnit.SECONDS for clear throughput numbers.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class FlowableConcatMapSingleBenchmark {

    /** Number of items emitted by the source Flowable. */
    @Param({"1000"})
    public int itemCount;

    /** Prefetch size for the operator. */
    @Param({"32", "64", "128"})
    public int prefetch;

    /** Error handling mode. */
    public ErrorMode errorMode = ErrorMode.IMMEDIATE;

    private Flowable<Integer> source;
    private Function<Integer, SingleSource<Integer>> mapper;

    @Setup(Level.Trial)
    public void setup() {
        // Synchronous source emitting a known number of integers.
        source = Flowable.range(1, itemCount);

        // Simple mapper that returns a Single emitting the doubled value.
        mapper = v -> Single.just(v * 2);
    }

    /**
     * Executes the concatMapSingle operator and consumes all resulting items.
     *
     * The use of {@code blockingSubscribe} guarantees that the benchmark method
     * returns only after the whole stream has been processed, providing a
     * deterministic measurement of throughput.
     */
    @Benchmark
    public void concatMapSingleThroughput(Blackhole bh) {
        source.concatMapSingle(mapper, errorMode, prefetch)
              .blockingSubscribe(bh::consume);
    }
}
```