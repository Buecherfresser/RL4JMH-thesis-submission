+        if (Math.abs(delta) <= epsilon)
+            return 0;
+
+        return (delta < 0 ? -1 : 1);
+    }
+
+    /**
+     * Compares two {@link Double} numbers for equality, given the specified epsilon.
+     * @param a the first {@link Double} number to compare
+     * @param b the second {@link Double} number to compare
