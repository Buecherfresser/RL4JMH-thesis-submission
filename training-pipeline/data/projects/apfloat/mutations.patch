-        // Newton's iteration
-        while (iterations-- > 0)
-        {
-            precision *= 2;
-            result = result.precision(Math.min(precision, targetPrecision));
-
-            Apfloat t = pow(result, n);
-            t = lastIterationExtendPrecision(iterations, precisingIteration, t);
