-	public static boolean isScientificNotation(String str) {
-		Matcher matcher = SCIENTIFIC_NOTATION_PATTERN.matcher(str);
-		if (!matcher.find()) {
-			return false;
-		}
-		String matched = matcher.group();
-		return matched.length()==str.length();
-	}
