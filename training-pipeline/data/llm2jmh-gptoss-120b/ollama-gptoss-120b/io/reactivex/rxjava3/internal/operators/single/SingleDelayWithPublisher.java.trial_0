```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Single;
import io.reactivex.rxjava3.core.SingleObserver;
import io.reactivex.rxjava3.core.SingleSource;
import io.reactivex.rxjava3.internal.operators.single.SingleDelayWithPublisher;
import io.reactivex.rxjava3.internal.subscriptions.SubscriptionHelper;
import io.reactivex.rxjava3.internal.disposables.DisposableHelper;
import io.reactivex.rxjava3.plugins.RxJavaPlugins;
import org.openjdk.jmh.annotations.*;
import org.reactivestreams.Publisher;
import org.reactivestreams.Subscription;
import org.reactivestreams.FlowableSubscriber;
import org.reactivestreams.Flowable;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicReference;

/**
 * Benchmark for {@link SingleDelayWithPublisher}.
 *
 * The benchmark measures the throughput of the operator when the upstream {@link Single}
 * emits a value immediately and the delaying {@link Publisher} emits a single item
 * also immediately. This reflects the common use‑case where the delay is driven by
 * another reactive source rather than a timed delay.
 *
 * Best practices applied:
 * <ul>
 *   <li>State is scoped to the thread ({@code @State(Scope.Thread)}) to avoid contention.</li>
 *   <li>All allocations are performed in {@code @Setup(Level.Trial)} to keep the measured
 *       section focused on the operator's runtime behavior.</li>
 *   <li>Blackhole is used to consume the result, preventing dead‑code elimination.</li>
 *   <li>Throughput mode is selected to report operations per second.</li>
 *   <li>Warm‑up and measurement iterations are left to the JMH runner configuration.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class SingleDelayWithPublisherBenchmark {

    /** Source Single that emits a constant value. */
    private SingleSource<Integer> source;

    /** Publisher that emits a single item and completes. */
    private Publisher<String> other;

    /** The operator under test. */
    private Single<Integer> delayedSingle;

    @Setup(Level.Trial)
    public void setUp() {
        // Simple source that immediately emits 1
        source = observer -> observer.onSuccess(1);

        // Publisher that immediately emits a dummy value and completes
        other = new Publisher<String>() {
            @Override
            public void subscribe(org.reactivestreams.Subscriber<? super String> s) {
                s.onSubscribe(new Subscription() {
                    @Override public void request(long n) { /* no backpressure needed */ }
                    @Override public void cancel() { /* no-op */ }
                });
                s.onNext("trigger");
                s.onComplete();
            }
        };

        // Create the operator instance
        delayedSingle = new SingleDelayWithPublisher<>(source, other);
    }

    /**
     * Benchmark method that subscribes to the delayed Single and blocks for the result.
     *
     * @param bh Blackhole to consume the emitted value.
     */
    @Benchmark
    public void delayedSingleThroughput(Blackhole bh) {
        // blockingGet is used to keep the benchmark simple and deterministic.
        // In a real‑world scenario you might prefer async subscription with a latch.
        int result = delayedSingle.blockingGet();
        bh.consume(result);
    }
}
```