```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.Predicate;
import io.reactivex.rxjava3.subscribers.DisposableSubscriber;

/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableRetryPredicate}.
 * Measures the throughput of a Flowable that retries on a specific exception
 * using a predicate. The benchmark runs in {@link Mode#Throughput} and reports
 * operations per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class FlowableRetryPredicateBenchmark {

    /** Number of items emitted before an artificial error is introduced. */
    @Param({"1000", "10000"})
    public int itemCount;

    /** How many times the source may be retried. */
    @Param({"1", "5", "10"})
    public int retryCount;

    /** Predicate that decides whether to retry on the given Throwable. */
    private Predicate<Throwable> retryPredicate;

    /** Source Flowable that emits {@code itemCount} items and then fails. */
    private Flowable<Integer> source;

    /** Counter to ensure the subscriber does not get optimized away. */
    private final AtomicInteger consumed = new AtomicInteger();

    @Setup(Level.Trial)
    public void setUp() {
        // Predicate that retries only on RuntimeException.
        retryPredicate = throwable -> throwable instanceof RuntimeException;

        // Build a source that emits a range of integers and then throws.
        source = Flowable.range(1, itemCount)
                .concatWith(Flowable.error(new RuntimeException("forced failure")));
    }

    /**
     * Benchmark method that subscribes to the Flowable with retry logic.
     * The subscriber consumes all items and discards them via Blackhole.
     */
    @Benchmark
    public void retryPredicateThroughput(Blackhole bh) {
        // Reset the consumed counter for each invocation.
        consumed.set(0);

        source
            .retryWhen(errors -> errors
                .zipWith(Flowable.range(1, retryCount + 1), (err, attempt) -> {
                    // Apply the predicate; if it returns false, propagate the error.
                    if (!retryPredicate.test(err)) {
                        throw new RuntimeException(err);
                    }
                    // Otherwise, retry by emitting a dummy item.
                    return attempt;
                })
                .flatMap(attempt -> Flowable.empty())) // trigger retry without emitting items
            .subscribe(new DisposableSubscriber<Integer>() {
                @Override
                public void onNext(Integer integer) {
                    // Consume the value to prevent dead code elimination.
                    consumed.incrementAndGet();
                    bh.consume(integer);
                }

                @Override
                public void onError(Throwable t) {
                    // Errors are expected after retries are exhausted.
                    bh.consume(t);
                }

                @Override
                public void onComplete() {
                    // No-op.
                }
            });
    }
}
```