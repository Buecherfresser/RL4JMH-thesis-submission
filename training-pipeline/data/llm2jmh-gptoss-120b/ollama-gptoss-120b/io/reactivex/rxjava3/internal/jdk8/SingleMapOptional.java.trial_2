package io.reactivex.rxjava3.internal.jdk8;

import java.util.Optional;
import java.util.concurrent.TimeUnit;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import io.reactivex.rxjava3.core.*;

@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class SingleMapOptionalBenchmark {

    private Single<Integer> source;

    private Function<Integer, Optional<? extends String>> mapperPresent;

    private Function<Integer, Optional<? extends String>> mapperEmpty;

    private Maybe<String> maybePresent;

    private Maybe<String> maybeEmpty;

    @Setup(Level.Trial)
    public void setUp() {
        source = Single.just(42);
        mapperPresent = v -> Optional.of("value:" + v);
        mapperEmpty   = v -> Optional.empty();

        maybePresent = new SingleMapOptional<Integer, String>(source, mapperPresent);
        maybeEmpty   = new SingleMapOptional<Integer, String>(source, mapperEmpty);
    }

    @Benchmark
    public void mapPresent(Blackhole bh) {
        bh.consume(maybePresent.blockingGet());
    }

    @Benchmark
    public void mapEmpty(Blackhole bh) {
        bh.consume(maybeEmpty.blockingGet());
    }
}
