/**
 * JMH benchmark for {@link MaybeFromSupplier}.
 *
 * Measures the throughput of subscribing to a {@code MaybeFromSupplier}
 * that wraps a simple {@link Supplier}. The benchmark follows best
 * practices:
 * <ul>
 *   <li>Uses {@code @State(Scope.Thread)} to avoid sharing mutable state across threads.</li>
 *   <li>Initialises the {@code Maybe} and the {@code Supplier} in {@code @Setup}.</li>
 *   <li>Consumes the emitted value with {@link Blackhole} to prevent dead‑code elimination.</li>
 *   <li>Specifies warm‑up and measurement iterations.</li>
 *   <li>Runs in {@link Mode#Throughput} with a time unit of operations per millisecond.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@State(Scope.Thread)
public class MaybeFromSupplierBenchmark {

    /**
     * Simple supplier returning a constant integer.
     */
    private Supplier<Integer> constantSupplier;

    /**
     * The Maybe instance under test.
     */
    private MaybeFromSupplier<Integer> maybe;

    /**
     * Observer that forwards the received value to a Blackhole.
     */
    private MaybeObserver<Integer> blackholeObserver;

    @Setup(Level.Trial)
    public void setUp() {
        constantSupplier = () -> 42;
        maybe = new MaybeFromSupplier<>(constantSupplier::get);
        // The observer forwards the success value (or completion) to the Blackhole.
        blackholeObserver = new MaybeObserver<Integer>() {

            @Override
            public void onSubscribe(Disposable d) {
                // No need to keep the disposable; the operation is synchronous.
            }

            @Override
            public void onSuccess(Integer value) {
                // Consume the value to avoid dead‑code elimination.
                // The Blackhole will be injected at benchmark execution time.
            }

            @Override
            public void onError(Throwable e) {
                // Errors are not expected in this benchmark; rethrow to fail fast.
                throw new RuntimeException(e);
            }

            @Override
            public void onComplete() {
                // No value emitted; nothing to consume.
            }
        };
    }

    @Benchmark
    public void subscribeAndConsume(Blackhole bh) {
        // Replace the observer with one that uses the provided Blackhole.
        MaybeObserver<Integer> observer = new MaybeObserver<Integer>() {

            @Override
            public void onSubscribe(Disposable d) {
                // No action needed.
            }

            @Override
            public void onSuccess(Integer value) {
                bh.consume(value);
            }

            @Override
            public void onError(Throwable e) {
                bh.consume(e);
            }

            @Override
            public void onComplete() {
                // No value to consume.
            }
        };
        maybe.subscribe(observer);
    }
}
