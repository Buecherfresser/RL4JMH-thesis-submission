-			// Let's try with Double.parse(...)
-			if (supportsScientificNotation && isScientificNotation(literal)) {
-				return Double.valueOf(literal);
-			}
-			throw new IllegalArgumentException(literal+" is not a number");
-		}
-		return result.doubleValue();
-	}
