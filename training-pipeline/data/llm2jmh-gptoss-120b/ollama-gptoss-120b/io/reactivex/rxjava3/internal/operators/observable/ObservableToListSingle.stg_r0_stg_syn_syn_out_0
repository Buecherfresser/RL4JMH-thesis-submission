/**
 * JMH benchmark for {@link ObservableToListSingle}.
 *
 * Measures the throughput of converting an {@link Observable} into a {@link Single}
 * that emits a {@link List} containing all upstream items.
 *
 * The benchmark uses a range Observable as the source and varies the number of
 * emitted items via the {@code size} parameter.
 *
 * Best practices applied:
 * - Separate state per thread to avoid contention.
 * - Warm‑up and measurement iterations to let the JIT stabilize.
 * - Multiple forks to reduce JVM warm‑up bias.
 * - Use {@link Blackhole} to consume results and prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class ObservableToListSingleBenchmark {

    /**
     * Number of items emitted by the source Observable.
     * Adjust to evaluate scaling behavior.
     */
    @Param({ "10", "100", "1_000", "10_000", "100_000" })
    public int size;

    /**
     * Capacity hint for the internal ArrayList used by the operator.
     * Keeping it equal to {@code size} avoids unnecessary resizing.
     */
    @Param({ "true" })
    public boolean useCapacityHint;

    private ObservableSource<Integer> source;

    private ObservableToListSingle<Integer, List<Integer>> operator;

    @Setup(Level.Iteration)
    public void setUp() {
        // Create a simple range Observable as the upstream source.
        source = Observable.range(1, size);
        if (useCapacityHint) {
            // Use the constructor that accepts a capacity hint for the collection supplier.
            operator = new ObservableToListSingle<>(source, size);
        } else {
            // Use the default constructor with a generic ArrayList supplier.
            Supplier<List<Integer>> supplier = () -> new java.util.ArrayList<>();
            operator = new ObservableToListSingle<>(source, supplier);
        }
    }

    /**
     * Benchmark the to‑list conversion.
     *
     * @param bh Blackhole to consume the resulting list and avoid dead‑code elimination.
     */
    @Benchmark
    public void toListSingle(Blackhole bh) {
        // The operator is a Single; blockingGet() materializes the list synchronously.
        List<Integer> result = operator.blockingGet();
        bh.consume(result);
    }
}
