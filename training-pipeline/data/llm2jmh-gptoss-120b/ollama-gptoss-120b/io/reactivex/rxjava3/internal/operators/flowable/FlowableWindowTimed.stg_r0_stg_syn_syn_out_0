/**
 * JMH benchmarks for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableWindowTimed}.
 *
 * The benchmarks cover the three main execution paths:
 *   1. Exact unbounded windows (timespan == timeskip, maxSize == Long.MAX_VALUE)
 *   2. Exact bounded windows (timespan == timeskip, maxSize &lt; Long.MAX_VALUE)
 *   3. Skip windows (timespan != timeskip)
 *
 * All benchmarks run in {@link Mode#Throughput} and report operations per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableWindowTimedBenchmark {

    /**
     * Number of items emitted by the source Flowable per benchmark run.
     */
    @Param({ "1000", "10000", "100000" })
    public int itemCount;

    /**
     * Window timespan in milliseconds.
     */
    @Param({ "10", "50" })
    public long timespanMs;

    /**
     * Window timeskip in milliseconds (used only for the skip variant).
     */
    @Param({ "20", "100" })
    public long timeskipMs;

    /**
     * Maximum size of a window (used only for the bounded variant).
     */
    @Param({ "Long.MAX_VALUE", "1000" })
    public long maxSize;

    /**
     * Buffer size for the internal UnicastProcessor.
     */
    @Param({ "128", "1024" })
    public int bufferSize;

    /**
     * Whether the timer should be restarted when a bounded window reaches maxSize.
     */
    @Param({ "true", "false" })
    public boolean restartTimerOnMaxSize;

    /**
     * Scheduler used by the operator (computation scheduler is the most common choice).
     */
    private io.reactivex.rxjava3.core.Scheduler scheduler;

    @Setup(Level.Trial)
    public void setup() {
        scheduler = Schedulers.computation();
    }

    /**
     * Exact unbounded windows: timespan == timeskip and maxSize == Long.MAX_VALUE.
     */
    @Benchmark
    public void exactUnbounded(Blackhole bh) {
        Flowable<Integer> source = Flowable.range(1, itemCount).subscribeOn(scheduler);
        source.window(timespanMs, TimeUnit.MILLISECONDS, scheduler, bufferSize).flatMap(w -> w).blockingSubscribe(bh::consume);
    }

    /**
     * Exact bounded windows: timespan == timeskip and maxSize &lt; Long.MAX_VALUE.
     */
    @Benchmark
    public void exactBounded(Blackhole bh) {
        Flowable<Integer> source = Flowable.range(1, itemCount).subscribeOn(scheduler);
        source.window(timespanMs, TimeUnit.MILLISECONDS, scheduler, maxSize, bufferSize, restartTimerOnMaxSize).flatMap(w -> w).blockingSubscribe(bh::consume);
    }

    /**
     * Skip windows: timespan != timeskip.
     */
    @Benchmark
    public void skip(Blackhole bh) {
        Flowable<Integer> source = Flowable.range(1, itemCount).subscribeOn(scheduler);
        source.window(timespanMs, timeskipMs, TimeUnit.MILLISECONDS, scheduler, bufferSize).flatMap(w -> w).blockingSubscribe(bh::consume);
    }
}
