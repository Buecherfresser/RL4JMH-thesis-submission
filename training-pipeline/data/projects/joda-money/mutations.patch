+     *
+     * @return the decimal places, from 0 to 9 (normally 0, 2 or 3)
+     */
+    public int getDecimalPlaces() {
+        return decimalPlaces < 0 ? 0 : decimalPlaces;
+    }
+
+    /**
+     * Checks if this is a pseudo-currency.
+     *
