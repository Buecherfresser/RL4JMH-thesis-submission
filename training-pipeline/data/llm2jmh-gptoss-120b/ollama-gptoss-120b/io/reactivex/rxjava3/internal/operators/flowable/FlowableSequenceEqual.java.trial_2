```
package io.reactivex.rxjava3.internal.operators.flowable;

import java.util.concurrent.TimeUnit;
import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.BiPredicate;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableSequenceEqual}.
 *
 * The benchmark measures the throughput (operations per second) of the
 * {@code Flowable.sequenceEqual} operator under different sequence sizes and
 * prefetch values. It uses {@link Flowable#range} as a deterministic source
 * and a simple {@code Objects::equals} comparator.
 *
 * Best practices applied:
 * - {@code @State(Scope.Thread)} isolates benchmark state per thread.
 * - Parameters are provided for sequence size and prefetch to explore scaling.
 * - {@code @Setup(Level.Iteration)} prepares fresh sources for each iteration,
 *   avoiding cross‑iteration interference.
 * - The result is consumed via {@link Blackhole} to prevent dead‑code elimination.
 * - Warm‑up and measurement iterations are defined to let the JVM reach a steady state.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableSequenceEqualBenchmark {

    /**
     * Number of items emitted by each source Flowable.
     */
    @Param({ "10", "100", "1000", "10000" })
    public int size;

    /**
     * Prefetch size used by the operator.
     */
    @Param({ "32", "128", "512" })
    public int prefetch;

    private Flowable<Integer> source1;
    private Flowable<Integer> source2;
    private BiPredicate<Integer, Integer> comparer;

    @Setup(Level.Iteration)
    public void setUp() {
        // Deterministic sources emitting the same sequence of integers.
        source1 = Flowable.range(1, size);
        source2 = Flowable.range(1, size);
        // Simple equality comparator; could be replaced with a more expensive one for other scenarios.
        comparer = Integer::equals;
    }

    /**
     * Executes the sequenceEqual operator and consumes the Boolean result.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void sequenceEqualThroughput(Blackhole bh) {
        // The operator under test. The prefetch parameter is passed directly.
        Boolean equal = Flowable.sequenceEqual(source1, source2, comparer, prefetch)
                                 .blockingGet();
        // Consume the result so the JIT cannot eliminate the whole pipeline.
        bh.consume(equal);
    }

    @TearDown(Level.Iteration)
    public void tearDown() {
        // Explicitly dispose of any resources; not strictly required for range sources,
        // but good practice when benchmarking operators that may hold onto threads or buffers.
        source1 = null;
        source2 = null;
        comparer = null;
    }
}
```