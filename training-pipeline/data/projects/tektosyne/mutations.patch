+        for (int i = 0; i < lines.length; i++) {
+            output[4 * i] = lines[i].start.x;
+            output[4 * i + 1] = lines[i].start.y;
+            output[4 * i + 2] = lines[i].end.x;
+            output[4 * i + 3] = lines[i].end.y;
+        }
