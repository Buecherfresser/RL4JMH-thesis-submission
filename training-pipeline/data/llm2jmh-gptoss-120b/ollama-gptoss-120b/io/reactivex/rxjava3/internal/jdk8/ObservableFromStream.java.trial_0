```
package io.reactivex.rxjava3.internal.jdk8.benchmark;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.internal.jdk8.ObservableFromStream;
import io.reactivex.rxjava3.observers.TestObserver;
import org.openjdk.jmh.annotations.*;

import java.util.List;
import java.util.concurrent.TimeUnit;
import java.util.stream.Collectors;
import java.util.stream.IntStream;
import java.util.stream.Stream;

/**
 * JMH benchmark for {@link ObservableFromStream}.
 *
 * Measures the throughput of subscribing to an Observable that wraps a Java {@link Stream}
 * and consumes all elements. The benchmark uses a {@link TestObserver} to eagerly subscribe
 * and block until the stream completes, ensuring that the measured work includes the full
 * iteration, emission, and disposal path.
 *
 * The benchmark follows best practices:
 * - @State(Scope.Thread) isolates data per thread to avoid contention.
 * - @Setup prepares immutable test data once per iteration.
 * - @Benchmark method contains only the code under test.
 * - Throughput mode reports operations per second.
 * - Warm‑up, measurement, and fork parameters are chosen to provide stable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class ObservableFromStreamBenchmark {

    /**
     * Size of the source {@link Stream}. Adjust to represent realistic workloads.
     */
    @Param({"100", "1_000", "10_000"})
    public int size;

    private List<Integer> sourceList;

    @Setup(Level.Trial)
    public void setUp() {
        // Prepare a deterministic list of integers to be streamed.
        sourceList = IntStream.rangeClosed(1, size)
                .boxed()
                .collect(Collectors.toList());
    }

    /**
     * Benchmark that creates a fresh {@link Stream}, wraps it into an {@link ObservableFromStream},
     * subscribes with a {@link TestObserver}, and blocks until completion.
     *
     * The use of a fresh Stream per invocation ensures that the benchmark measures the
     * full cost of stream creation, iterator acquisition, emission, and resource cleanup.
     *
     * @return a {@link TestObserver} that has completed the subscription.
     */
    @Benchmark
    public TestObserver<Integer> subscribeAndConsume() {
        // Create a new Stream for each benchmark iteration.
        Stream<Integer> stream = sourceList.stream();

        // Wrap the Stream into the Observable under test.
        Observable<Integer> observable = new ObservableFromStream<>(stream);

        // Use TestObserver to subscribe and await terminal event.
        TestObserver<Integer> observer = new TestObserver<>();
        observable.subscribe(observer);
        observer.awaitDone(Long.MAX_VALUE, TimeUnit.NANOSECONDS);

        // The observer now holds the consumed items; returning it prevents dead‑code elimination.
        return observer;
    }
}
```