/**
 * Benchmark for {@code Flowable.concatWith(Completable)} which internally uses
 * {@code FlowableConcatWithCompletable}. The benchmark measures the throughput
 * of processing a stream of {@code size} items followed by a Completable.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Pre‑create the source Flowable and Completable in @Setup to exclude allocation overhead.
 * - Use Blackhole to consume emitted items and prevent dead‑code elimination.
 * - Use a CountDownLatch to synchronously wait for completion without blocking the JMH thread pool.
 * - Configure warm‑up, measurement, and fork parameters for reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 1, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableConcatWithCompletableBenchmark {

    /**
     * Number of items emitted by the upstream Flowable before the Completable is concatenated.
     */
    @Param({ "1_000", "10_000", "100_000" })
    public int size;

    private Flowable<Integer> flowableWithCompletable;

    @Setup(Level.Trial)
    public void setUp() {
        // Upstream Flowable emitting a range of integers.
        Flowable<Integer> source = Flowable.range(1, size);
        // Completable that completes immediately.
        Completable completable = Completable.complete();
        // The operator under test: concat the Flowable with the Completable.
        flowableWithCompletable = source.concatWith(completable);
    }

    @Benchmark
    public void concatWithCompletable(Blackhole bh) throws InterruptedException {
        // Latch to wait for onComplete before returning from the benchmark method.
        CountDownLatch latch = new CountDownLatch(1);
        flowableWithCompletable.subscribe(new FlowableSubscriber<Integer>() {

            private Disposable disposable;

            @Override
            public void onSubscribe(Disposable d) {
                this.disposable = d;
                // Request all items at once for maximum throughput.
                d.request(Long.MAX_VALUE);
            }

            @Override
            public void onNext(Integer t) {
                // Consume the item to avoid dead‑code elimination.
                bh.consume(t);
            }

            @Override
            public void onError(Throwable t) {
                // In a benchmark we treat errors as fatal.
                t.printStackTrace();
                latch.countDown();
            }

            @Override
            public void onComplete() {
                latch.countDown();
            }
        });
        // Wait for the stream to finish; this does not interfere with JMH timing
        // because the benchmark method itself is measured.
        latch.await();
    }
}
