/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableConcatMap}.
 *
 * The benchmark measures the throughput (operations per second) of the concatMap
 * operator when mapping a range of integers to simple scalar Observables.
 *
 * Best practices applied:
 * - Use @State with Scope.Thread to avoid sharing mutable state between threads.
 * - Perform all allocations in @Setup(Level.Trial) to keep the benchmark focused on the operator.
 * - Consume the emitted items via Blackhole to prevent dead‑code elimination.
 * - Configure warm‑up, measurement iterations and forks for reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(3)
@State(Scope.Thread)
public class ObservableConcatMapBenchmark {

    /**
     * Number of items emitted by the source Observable per benchmark iteration.
     */
    @Param({ "1000", "10000" })
    public int itemCount;

    /**
     * Source Observable emitting a range of integers.
     */
    private Observable<Integer> source;

    /**
     * Mapper function used by concatMap.
     */
    private Function<Integer, ObservableSource<Integer>> mapper;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a cold source that emits a fixed range of integers.
        source = Observable.range(0, itemCount);
        // Simple mapper that returns a scalar Observable for each upstream value.
        mapper = i -> Observable.just(i);
    }

    /**
     * Benchmark the concatMap operator in its default (IMMEDIATE error) mode.
     *
     * @param bh Blackhole to consume the emitted items and avoid dead‑code elimination.
     */
    @Benchmark
    public void concatMapThroughput(Blackhole bh) {
        source.concatMap(mapper).subscribe(bh::consume);
    }
}
