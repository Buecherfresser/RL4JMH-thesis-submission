+	 * 源代码由林良益(linliangyi2005@gmail.com)提供
+	 * 版权声明 2012，乌龙茶工作室
+	 * provided by Linliangyi and copyright 2012 by Oolong studio
+	 * 
+	 * QuickSortSet集合单元
+	 * 
+	 */
+	class Cell implements Comparable<Cell>{
+		private Cell prev;
+		private Cell next;
+		private Lexeme lexeme;
+		
+		Cell(Lexeme lexeme){
+			if(lexeme == null){
+				throw new IllegalArgumentException("lexeme must not be null");
+			}
+			this.lexeme = lexeme;
+		}
+
+		public int compareTo(Cell o) { org.wltea.analyzer.jmhbench.MutationSwitch.tick(1);
+			return this.lexeme.compareTo(o.lexeme);
+		}
+
+		public Cell getPrev(){ org.wltea.analyzer.jmhbench.MutationSwitch.tick(5);
+			return this.prev;
+		}
+		
+		public Cell getNext(){ org.wltea.analyzer.jmhbench.MutationSwitch.tick(9);
+			return this.next;
+		}
+		
+		public Lexeme getLexeme(){ org.wltea.analyzer.jmhbench.MutationSwitch.tick(13);
+			return this.lexeme;
+		}
+	}
+}
