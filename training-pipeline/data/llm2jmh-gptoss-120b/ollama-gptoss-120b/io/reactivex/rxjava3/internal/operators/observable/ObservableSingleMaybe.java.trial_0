```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.internal.operators.observable.ObservableSingleMaybe;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link ObservableSingleMaybe} in throughput mode.
 *
 * The benchmark measures how many times per second we can subscribe to an {@code Observable}
 * that emits a single element and convert it to a {@code Maybe} using the operator under test.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Pre‑create the source {@code Observable} and the {@code Maybe} in @Setup to exclude allocation overhead.
 * - Use Blackhole to consume the result and prevent dead‑code elimination.
 * - Configure warm‑up, measurement iterations and forks to obtain stable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@Threads(1)
public class ObservableSingleMaybeBenchmark {

    /**
     * State holding the source Observable and the Maybe produced by the operator.
     * Each thread gets its own instance to avoid contention.
     */
    @State(Scope.Thread)
    public static class BenchmarkState {
        // Observable that emits exactly one integer value.
        Observable<Integer> source;

        // The Maybe that wraps the source using ObservableSingleMaybe.
        Maybe<Integer> maybe;

        @Setup(Level.Trial)
        public void setUp() {
            // Create a simple Observable that emits a single element and completes.
            source = Observable.just(42);

            // Apply the operator under test.
            maybe = new ObservableSingleMaybe<>(source);
        }
    }

    /**
     * Benchmark method that subscribes to the Maybe and blocks until the result is available.
     *
     * @param state   the benchmark state containing the pre‑created Maybe.
     * @param bh      Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void singleElementThroughput(BenchmarkState state, Blackhole bh) {
        // blockingGet() subscribes, waits for completion and returns the value (or null on empty).
        // This is a realistic usage pattern for a Maybe that is expected to emit a single value.
        Integer result = state.maybe.blockingGet();
        bh.consume(result);
    }
}
```