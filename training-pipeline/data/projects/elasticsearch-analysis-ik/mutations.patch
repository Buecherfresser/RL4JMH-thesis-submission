+						for (String location : singleton.getRemoteExtDictionarys()) {
+							// 10 秒是初始延迟可以修改的 60是间隔时间 单位秒
+							pool.scheduleAtFixedRate(new Monitor(location, cfg), 10, 60, TimeUnit.SECONDS);
