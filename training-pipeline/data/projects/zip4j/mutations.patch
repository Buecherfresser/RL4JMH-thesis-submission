+/*
+ * Source referred from Matthias Gartner's PKCS#5 implementation -
+ * see http://rtner.de/software/PBKDF2.html
+ */
+
+class BinTools {
+  public static final String hex = "0123456789ABCDEF";
+
+  public static String bin2hex(final byte[] b) { net.lingala.zip4j.jmhbench.MutationSwitch.tick(41);
+    if (b == null) {
+      return "";
+    }
+    StringBuffer sb = new StringBuffer(2 * b.length);
+    for (int i = 0; i < b.length; i++) {
+      int v = (256 + b[i]) % 256;
+      sb.append(hex.charAt((v / 16) & 15));
+      sb.append(hex.charAt((v % 16) & 15));
+    }
+    return sb.toString();
+  }
