+    }
+
+    @Override
+    public int compareTo(NodePath other) {
+        if (this.parent != null && other.parent == null) {
+            return 1;
+        } else if (this.parent == null && other.parent != null) {
+            return -1;
+        } else if (this.parent != null && other.parent != null) {
+            int result = this.parent.compareTo(other.parent);
