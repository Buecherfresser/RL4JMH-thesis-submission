/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.jdk8.FlowableCollectWithCollectorSingle}
 * (exposed via {@code Flowable.collect(Collector)}).
 *
 * The benchmark measures the throughput of collecting a finite {@link Flowable}
 * into a container using a {@link Collector}. The test uses {@code Flowable.range}
 * as a deterministic source and {@code Collectors.toList()} as the collector.
 *
 * Best‑practice notes:
 * • The source and collector are created once per trial to avoid measuring allocation overhead.
 * • {@code blockingGet()} is used to force the {@link io.reactivex.rxjava3.core.Single}
 *   to complete synchronously, ensuring the benchmark measures the full operator pipeline.
 * • The benchmark runs with warm‑up and measurement iterations, multiple forks,
 *   and reports throughput in operations per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableCollectWithCollectorSingleBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "100", "1_000", "10_000" })
    public int itemCount;

    /**
     * The source Flowable emitting a range of integers.
     */
    private Flowable<Integer> source;

    /**
     * Collector that accumulates the emitted items into a {@link List}.
     */
    private Collector<Integer, ?, List<Integer>> collector;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a deterministic source; using range ensures no external I/O.
        source = Flowable.range(1, itemCount);
        // Standard collector that gathers items into an ArrayList.
        collector = Collectors.toList();
    }

    /**
     * Executes the collect operator and blocks until the result is available.
     *
     * @return the collected list (returned to JMH so it is not dead‑code eliminated)
     */
    @Benchmark
    public List<Integer> collect() {
        // Flowable.collect internally uses FlowableCollectWithCollectorSingle.
        return source.collect(collector).blockingGet();
    }
}
