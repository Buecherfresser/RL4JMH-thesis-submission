+        for (int i = from - 1; ++i <= to;) {
+            element = list[i];
+            if (comp.compare(element, splitter) < 0) {
+                // swap x[i] with x[from]
+                list[i] = list[from];
+                list[from] = element;
+                from++;
+            }
+        }
+        return from - 1;
+    }
