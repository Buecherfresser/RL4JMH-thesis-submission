```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Completable;
import io.reactivex.rxjava3.core.Flowable;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for the {@code ignoreElements()} operator which internally uses
 * {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableIgnoreElementsCompletable}.
 *
 * The benchmark measures the throughput (operations per second) of subscribing to a
 * {@link Flowable} that emits a configurable number of items and then ignoring all
 * elements via {@code ignoreElements()}.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the number of emitted items to see scaling behavior.
 * - Use Blackhole to prevent dead-code elimination.
 * - Use a warm‑up phase and multiple measurement iterations.
 * - Run in Mode.Throughput with results expressed in operations per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@Threads(1)
public class FlowableIgnoreElementsBenchmark {

    @State(Scope.Thread)
    public static class BenchmarkState {

        /**
         * Number of items emitted by the source Flowable.
         * Typical values: 1, 10, 100, 1_000, 10_000, 100_000.
         */
        @Param({"1", "10", "100", "1000", "10000", "100000"})
        public int itemCount;

        /**
         * Pre‑created Flowable that will be reused for each benchmark iteration.
         * Using a cached Flowable avoids the overhead of constructing the source
         * inside the measured method.
         */
        Flowable<Integer> source;

        @Setup(Level.Trial)
        public void setUp() {
            // Create a Flowable that emits a range of integers.
            source = Flowable.range(1, itemCount);
        }

        /**
         * Helper method that subscribes to the source, applies ignoreElements(),
         * and blocks until completion. The result is a Completable that we
         * block on to ensure the whole pipeline is executed.
         */
        public void runIgnoreElements() {
            Completable completable = source.ignoreElements();
            // blockingAwait() is used to wait for completion without additional
            // callbacks, keeping the benchmark code simple and deterministic.
            completable.blockingAwait();
        }
    }

    @Benchmark
    public void ignoreElementsThroughput(BenchmarkState state, Blackhole bh) {
        // Execute the operation; any side‑effects are consumed by Blackhole
        // to prevent the JIT from optimizing the call away.
        state.runIgnoreElements();
        bh.consume(state.itemCount); // consume a value to keep the method non‑trivial
    }
}
```