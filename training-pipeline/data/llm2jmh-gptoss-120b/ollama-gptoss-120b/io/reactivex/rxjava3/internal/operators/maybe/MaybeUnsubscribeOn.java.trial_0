```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.disposables.Disposable;
import io.reactivex.rxjava3.internal.operators.maybe.MaybeUnsubscribeOn;
import io.reactivex.rxjava3.schedulers.Schedulers;
import io.reactivex.rxjava3.core.Scheduler;

/**
 * Benchmark for {@link MaybeUnsubscribeOn} measuring the throughput of the
 * {@code dispose()} operation. The benchmark creates a {@code Maybe} that never
 * terminates, applies the {@code unsubscribeOn} operator and repeatedly disposes
 * the subscription. This isolates the cost of scheduling the disposal on the
 * provided {@link Scheduler}.
 *
 * The benchmark follows JMH best‑practice guidelines:
 * <ul>
 *   <li>State is scoped to a single thread to avoid contention.</li>
 *   <li>Warm‑up and measurement iterations are defined.</li>
 *   <li>Forking isolates JVM warm‑up effects.</li>
 *   <li>Blackhole is not required because we only measure side‑effects.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class MaybeUnsubscribeOnBenchmark {

    /** Scheduler used by the operator – a single‑threaded scheduler is sufficient for the test. */
    private Scheduler scheduler;

    /** The Maybe source that never terminates; disposal is the only operation exercised. */
    private Maybe<Integer> source;

    /** The operator under test. */
    private Maybe<Integer> maybeUnsubscribeOn;

    /** Disposable obtained after subscription; reused in each benchmark iteration. */
    private Disposable disposable;

    @Setup(Level.Trial)
    public void setUp() {
        // Use a dedicated single‑threaded scheduler to avoid interference from other threads.
        scheduler = Schedulers.single();

        // A never‑ending Maybe; we only care about the disposal path.
        source = Maybe.never();

        // Apply the operator under test.
        maybeUnsubscribeOn = new MaybeUnsubscribeOn<>(source, scheduler);

        // Subscribe once; the same Disposable will be disposed repeatedly in the benchmark.
        maybeUnsubscribeOn.subscribe(new io.reactivex.rxjava3.core.MaybeObserver<Integer>() {
            @Override public void onSubscribe(Disposable d) { disposable = d; }
            @Override public void onSuccess(Integer value) {}
            @Override public void onError(Throwable e) {}
            @Override public void onComplete() {}
        });
    }

    @TearDown(Level.Trial)
    public void tearDown() {
        // Ensure the scheduler is shut down to avoid thread leaks.
        scheduler.shutdown();
    }

    /**
     * Benchmark the throughput of disposing the subscription.
     *
     * Each invocation disposes the previously obtained {@link Disposable},
     * which triggers the {@code scheduleDirect} call inside {@link MaybeUnsubscribeOn.UnsubscribeOnMaybeObserver}.
     */
    @Benchmark
    public void dispose() {
        // The operator internally checks for already‑disposed state, so we need a fresh subscription
        // for each iteration to measure the full cost. Re‑subscribe before disposing.
        maybeUnsubscribeOn.subscribe(new io.reactivex.rxjava3.core.MaybeObserver<Integer>() {
            @Override public void onSubscribe(Disposable d) { d.dispose(); }
            @Override public void onSuccess(Integer value) {}
            @Override public void onError(Throwable e) {}
            @Override public void onComplete() {}
        });
    }
}
```