```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.Consumer;
import io.reactivex.rxjava3.schedulers.Schedulers;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableOnBackpressureLatest}
 * measuring throughput of the operator under varying source sizes.
 *
 * The benchmark creates a hot {@link Flowable} emitting a configurable number of integers,
 * applies {@code onBackpressureLatest} with a no‑op drop handler, and consumes all items
 * using {@link Blackhole} to prevent dead‑code elimination.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the source size to explore scaling behavior.
 * - Use Blackhole for side‑effect consumption.
 * - Run with warm‑up and measurement iterations, multiple forks, and a fixed time unit.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class FlowableOnBackpressureLatestBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     * Adjust to evaluate small vs. large streams.
     */
    @Param({"1_000", "10_000", "100_000", "1_000_000"})
    public int itemCount;

    /**
     * Source Flowable that emits a range of integers.
     * It is created in {@link #setup()} to avoid measuring construction overhead.
     */
    private Flowable<Integer> source;

    /**
     * No‑op drop handler required by the operator.
     */
    private static final Consumer<Integer> NO_OP_DROP = t -> {
        // intentionally empty – drop handling is not part of the throughput measurement
    };

    @Setup(Level.Trial)
    public void setup() {
        // Use a computation scheduler to decouple emission from the benchmark thread.
        source = Flowable.range(1, itemCount)
                         .subscribeOn(Schedulers.computation())
                         .hide(); // hide to prevent fusion optimizations that would bypass the operator
    }

    /**
     * Benchmark method that applies {@code onBackpressureLatest} to the source
     * and consumes all emitted items via {@link Blackhole}.
     *
     * The use of {@code blockingSubscribe} ensures the benchmark thread waits
     * for the entire stream to be processed, providing a clear throughput measurement.
     *
     * @param bh Blackhole to consume items and avoid dead‑code elimination.
     */
    @Benchmark
    public void onBackpressureLatestThroughput(Blackhole bh) {
        source.onBackpressureLatest(NO_OP_DROP)
              .blockingSubscribe(bh::consume, bh::consume);
    }
}
```