+	public static class ObjectAndPathForResources<T, R> {
+		Map<T, PathForResources<R>> resources;
+		Supplier<PathForResources<R>> pathForResourcesSupplier;
+		String instanceId;
+
+		public ObjectAndPathForResources() {
+			this(1L, item -> item, null );
