```
package io.reactivex.rxjava3.benchmarks.internal.operators.flowable;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.Function;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.infra.Blackhole;

/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableGroupBy}.
 *
 * The benchmark measures the throughput (operations per second) of the
 * {@code groupBy} operator under different configurations.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the number of upstream items and the buffer size.
 * - Use Blackhole to consume results and prevent dead‑code elimination.
 * - Run the flow in a deterministic scheduler (single thread) to isolate
 *   operator performance from thread‑pool variability.
 * - Use @BenchmarkMode(Mode.Throughput) and @OutputTimeUnit(TimeUnit.SECONDS)
 *   as requested.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class FlowableGroupByBenchmark {

    /** Number of items emitted by the upstream Flowable. */
    @Param({"1_000", "10_000", "100_000"})
    public int itemCount;

    /** Buffer size used by the GroupBy operator. */
    @Param({"16", "128", "1024"})
    public int bufferSize;

    /** Whether the operator should delay errors. */
    @Param({"true", "false"})
    public boolean delayError;

    /** Upstream source used in the benchmark. */
    private Flowable<Integer> source;

    /** Key selector: groups items by modulo 10. */
    private static final Function<Integer, Integer> KEY_SELECTOR = i -> i % 10;

    /** Value selector: identity function. */
    private static final Function<Integer, Integer> VALUE_SELECTOR = i -> i;

    @Setup(Level.Invocation)
    public void setUp() {
        // Create a fresh source for each invocation to avoid caching effects.
        source = Flowable.range(1, itemCount)
                .subscribeOn(Schedulers.single()); // deterministic scheduler
    }

    /**
     * Benchmark that applies {@code groupBy} to the source Flowable,
     * then merges the groups back and consumes all items.
     *
     * The Blackhole ensures that the result of the stream is used,
     * preventing the JIT from optimizing the whole pipeline away.
     */
    @Benchmark
    public void groupByThroughput(Blackhole bh) {
        source
            .groupBy(KEY_SELECTOR, VALUE_SELECTOR, bufferSize, delayError, null)
            // Flatten the groups back into a single stream.
            .flatMap(g -> g)
            // Consume each item with Blackhole.
            .doOnNext(bh::consume)
            // Block until the whole stream finishes to get a deterministic measurement.
            .blockingSubscribe();
    }
}
```