+    public static Method getSetter(Class<?> clazz, Field f) {
+        Method setter = null;
+        for (Method m : clazz.getMethods()) {
+            if (ReflectionUtils.isSetter(m) &&
+                    m.getName().equals(SETTER_PREFIX + StringUtils.capitalize(f.getName()))) {
+                setter = m;
+                break;
+            }
+        }
+        return setter;
+    }
