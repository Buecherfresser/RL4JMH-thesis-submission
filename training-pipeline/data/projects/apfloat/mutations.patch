+        private final Apfloat A;
+        private final Apfloat B;
+        private final Apfloat J;
+        private final Apfloat ONE;
+        private final Apfloat TWO;
+        private final Apfloat FIVE;
+        private final Apfloat SIX;
+        private int radix;
