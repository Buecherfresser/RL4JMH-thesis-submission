```
package io.reactivex.rxjava3.internal.operators.observable;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.Predicate;
import io.reactivex.rxjava3.schedulers.Schedulers;

/**
 * JMH benchmark for {@link ObservableRetryPredicate}.
 *
 * The benchmark measures the throughput (operations per second) of an
 * Observable that emits a fixed number of items, then fails, and is retried
 * according to a predicate. The retry count is limited to avoid an infinite
 * loop.
 *
 * Best‑practice JMH settings are used:
 * - 5 warm‑up iterations
 * - 10 measurement iterations
 * - 3 forks
 * - 1 thread per fork
 * - Throughput mode (operations/second)
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class ObservableRetryPredicateBenchmark {

    /** Number of items emitted before the error is triggered. */
    @Param({"10", "100", "1000"})
    public int itemCount;

    /** Number of retry attempts allowed. */
    @Param({"1", "5", "10"})
    public long retryCount;

    /** Predicate that always returns true (i.e., always retry while attempts remain). */
    private Predicate<Throwable> alwaysRetry;

    /** Source Observable that emits {@code itemCount} items and then fails. */
    private Observable<Integer> source;

    /** Observable under test – source with retry predicate applied. */
    private Observable<Integer> retryObservable;

    @Setup(Level.Trial)
    public void setUp() {
        alwaysRetry = throwable -> true;

        // Create a source that emits a range of integers and then signals an error.
        source = Observable.create(emitter -> {
            for (int i = 0; i < itemCount; i++) {
                if (emitter.isDisposed()) {
                    return;
                }
                emitter.onNext(i);
            }
            emitter.onError(new RuntimeException("forced failure"));
        }).subscribeOn(Schedulers.computation());

        // Apply the retry operator under test.
        retryObservable = source.retryWhen(errors ->
                errors.flatMap(error -> {
                    // The retry predicate is evaluated inside the operator;
                    // we simply forward the error to let the operator decide.
                    return Observable.just(error);
                })
        ).compose(upstream -> new ObservableRetryPredicate<>(upstream, retryCount, alwaysRetry));
    }

    /**
     * Benchmark method that subscribes to the {@code retryObservable},
     * consumes all emitted items, and blocks until completion.
     *
     * The use of {@code blockingSubscribe} ensures that the benchmark measures
     * the full execution time of the retry logic.
     */
    @Benchmark
    public void retryThroughput() {
        // Consume the observable fully; any exception will be propagated and
        // cause the benchmark iteration to fail, which is desirable for correctness.
        retryObservable.blockingSubscribe();
    }
}
```