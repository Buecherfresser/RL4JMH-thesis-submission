```
package io.reactivex.rxjava3.internal.operators.single.benchmark;

import io.reactivex.rxjava3.core.Single;
import io.reactivex.rxjava3.internal.operators.single.SingleSubscribeOn;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link SingleSubscribeOn}.
 *
 * The benchmark measures the throughput of subscribing to a {@link Single}
 * that emits a constant value while the subscription is scheduled on a
 * background {@link io.reactivex.rxjava3.core.Scheduler}.
 *
 * Best‑practice notes:
 * <ul>
 *   <li>Use {@code @State(Scope.Thread)} to avoid sharing mutable state between threads.</li>
 *   <li>Warm‑up and measurement iterations are configured to let the JIT stabilize.</li>
 *   <li>Blackhole is used to consume the result and prevent dead‑code elimination.</li>
 *   <li>Forking isolates the benchmark from JVM warm‑up effects.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@Threads(1)
@State(Scope.Thread)
public class SingleSubscribeOnBenchmark {

    /** The Single that will be subscribed to in each benchmark iteration. */
    private Single<Integer> single;

    /** Scheduler used by {@link SingleSubscribeOn}. */
    private io.reactivex.rxjava3.core.Scheduler scheduler;

    @Setup(Level.Trial)
    public void setUp() {
        // Use a lightweight scheduler that does not create new threads per task.
        // Schedulers.trampoline runs tasks on the current thread, which isolates the
        // overhead of the operator itself from thread‑creation costs.
        scheduler = Schedulers.trampoline();

        // Create a source Single that immediately emits a constant value.
        Single<Integer> source = Single.just(42);

        // Wrap the source with the operator under test.
        single = new SingleSubscribeOn<>(source, scheduler);
    }

    @TearDown(Level.Trial)
    public void tearDown() {
        // Dispose the scheduler if it holds resources (trampoline does not, but this is safe for other schedulers).
        scheduler.dispose();
    }

    /**
     * Benchmark method that subscribes to the {@link Single} and blocks until the value is emitted.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void subscribeOnThroughput(Blackhole bh) {
        // blockingGet forces the subscription to happen and waits for completion.
        int result = single.blockingGet();
        bh.consume(result);
    }
}
```