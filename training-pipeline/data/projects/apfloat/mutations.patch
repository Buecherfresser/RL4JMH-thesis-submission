-    static Apfloat doubleFactorial(long n, long precision, int radix)
-        throws ArithmeticException, NumberFormatException, ApfloatRuntimeException
-    {
-        if (n < 0)
-        {
-            if ((n & 1) == 0)
-            {
-                throw new ApfloatArithmeticException("Double factorial of negative even number", "doubleFactorial.ofNegativeEven");
-            }
-            return new Apint((n & 2) == 0 ? n : -n, radix).divide(doubleFactorial(-n, precision, radix));   // Note that Long.MIN_VALUE is even so is caught by previous check
-        }
-        if ((n & 1) == 1)
-        {
-            return oddProduct(1, n, precision, radix);
-        }
-        long n2 = n >>> 1;
-        return pow(new Apfloat(2, precision, radix), n2).multiply(factorial(n2, precision, radix));
-    }
