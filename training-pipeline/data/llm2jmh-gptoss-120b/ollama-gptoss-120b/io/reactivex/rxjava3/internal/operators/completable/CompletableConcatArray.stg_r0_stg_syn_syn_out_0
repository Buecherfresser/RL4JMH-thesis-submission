/**
 * Benchmark for {@link CompletableConcatArray}.
 *
 * Measures the throughput of concatenating an array of {@link CompletableSource}s.
 * The benchmark creates a fresh {@code CompletableConcatArray} for each invocation
 * and blocks until the concatenated sequence completes.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the number of sources to explore scaling behavior.
 * - Warm‑up and measurement iterations are defined to let the JIT stabilize.
 * - Forking isolates the benchmark from JVM-wide side effects.
 * - Blackhole is used to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class CompletableConcatArrayBenchmark {

    /**
     * Number of Completable sources to concatenate.
     * Typical values: 1, 10, 100, 1000.
     */
    @Param({ "1", "10", "100", "1000" })
    public int sourceCount;

    /**
     * Array of pre‑created Completable sources. Each source completes immediately.
     */
    private CompletableSource[] sources;

    /**
     * Set up the array of Completable sources before each fork.
     */
    @Setup(Level.Trial)
    public void setUp() {
        sources = new CompletableSource[sourceCount];
        // Use a lightweight Completable that completes synchronously.
        Completable immediate = Completable.complete();
        for (int i = 0; i < sourceCount; i++) {
            sources[i] = immediate;
        }
    }

    /**
     * Benchmark method that creates a new {@link CompletableConcatArray},
     * subscribes to it, and blocks until completion.
     *
     * @param bh Blackhole to consume a dummy value and avoid dead‑code elimination.
     */
    @Benchmark
    public void concatArray(Blackhole bh) {
        Completable concat = new CompletableConcatArray(sources);
        // blockingAwait() returns true when completed without error.
        // It also propagates any error as a RuntimeException, which is fine for the benchmark.
        concat.blockingAwait();
        bh.consume(concat);
    }
}
