-
-        if (_cursorY == bLine.end.y || bSlope == Double.MAX_VALUE)
-            bx = bLine.end.x;
-        else if (_cursorY == bLine.start.y) {
-            bx = bLine.start.x;
-            bSlope = -bSlope;
-        } else
-            bx = bLine.start.x + (_cursorY - bLine.start.y) * bSlope;
