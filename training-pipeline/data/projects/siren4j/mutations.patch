+    }
+
+    void _addEntity(EntityImpl entity) {
+        subEntities.add(entity);
+    }
+
+    void _addLink(LinkImpl link) {
+        links.add(link);
+    }
+
+    void _addAction(ActionImpl action) {
+        actions.add(action);
+    }
+
+    void _addProperty(String name, Object value) {
