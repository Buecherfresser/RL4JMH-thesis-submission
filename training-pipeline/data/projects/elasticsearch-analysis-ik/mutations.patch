-class CN_QuantifierSegmenter implements ISegmenter{
-	
-	//子分词器标签
-	static final String SEGMENTER_NAME = "QUAN_SEGMENTER";
-	
-	//中文数词
-	private static String Chn_Num = "一二两三四五六七八九十零壹贰叁肆伍陆柒捌玖拾百千万亿拾佰仟萬億兆卅廿";//Cnum
