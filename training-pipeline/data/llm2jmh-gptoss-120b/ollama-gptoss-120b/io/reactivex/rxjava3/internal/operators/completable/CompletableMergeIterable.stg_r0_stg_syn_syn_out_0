/**
 * Benchmark for {@link CompletableMergeIterable}.
 *
 * Measures the throughput of merging a configurable number of {@link CompletableSource}
 * instances that complete immediately.
 *
 * The benchmark follows JMH best practices:
 * - State is scoped per thread to avoid contention.
 * - Parameters are used to explore different source counts.
 * - Setup creates immutable data structures.
 * - The benchmark method blocks until the merged Completable terminates,
 *   ensuring that the measured work includes the full lifecycle.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@State(Scope.Thread)
public class CompletableMergeIterableBenchmark {

    /**
     * Number of Completable sources to merge.
     * Typical values: 1, 10, 100, 1000.
     */
    @Param({ "1", "10", "100", "1000" })
    public int sourceCount;

    /**
     * Immutable list of CompletableSources used in each benchmark iteration.
     */
    private List<CompletableSource> sources;

    /**
     * The iterable wrapper required by {@link CompletableMergeIterable}.
     */
    private Iterable<? extends CompletableSource> iterableSources;

    @Setup(Level.Trial)
    public void setUp() {
        List<CompletableSource> list = new ArrayList<>(sourceCount);
        for (int i = 0; i < sourceCount; i++) {
            // Each source completes immediately; using Completable.complete()
            list.add(Completable.complete());
        }
        this.sources = List.copyOf(list);
        this.iterableSources = sources;
    }

    @Benchmark
    public void mergeCompletableIterables(Blackhole bh) throws InterruptedException {
        CompletableMergeIterable merge = new CompletableMergeIterable(iterableSources);
        CountDownLatch latch = new CountDownLatch(1);
        merge.subscribe(new CompletableObserver() {

            @Override
            public void onSubscribe(Disposable d) {
                // No need to keep the disposable; the benchmark will wait for completion.
            }

            @Override
            public void onError(Throwable e) {
                // Propagate error to Blackhole to avoid dead code elimination.
                bh.consume(e);
                latch.countDown();
            }

            @Override
            public void onComplete() {
                latch.countDown();
            }
        });
        // Wait for the merged Completable to finish.
        latch.await();
    }
}
