+    public static Aprational pochhammer(Aprational x, Apint n)
+    {
+        Apint one = Apint.ONES[x.radix()];
+        if (n.signum() == 0)
+        {
+            return one;
+        }
+        if (n.equals(one))
+        {
+            return x;
