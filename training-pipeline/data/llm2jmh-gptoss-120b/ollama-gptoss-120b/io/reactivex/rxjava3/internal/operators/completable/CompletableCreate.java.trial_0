```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.Completable;
import io.reactivex.rxjava3.core.CompletableObserver;
import io.reactivex.rxjava3.core.CompletableOnSubscribe;
import io.reactivex.rxjava3.disposables.Disposable;

/**
 * Microbenchmark for {@link io.reactivex.rxjava3.internal.operators.completable.CompletableCreate}.
 *
 * The benchmark measures the throughput of subscribing to a {@code CompletableCreate}
 * that immediately completes. This reflects the typical overhead of the operator
 * without any user‑code work.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Perform all allocations in @Setup to keep the benchmark method focused on the
 *   operation under test.
 * - Use Mode.Throughput with TimeUnit.SECONDS to report operations per second.
 * - Include warm‑up and measurement iterations, as well as a fork to get reliable JIT
 *   compilation.
 * - Blackhole is not needed because the Completable does not produce a value;
 *   we simply block until termination to ensure the subscription completes.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 1, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@Threads(1)
public class CompletableCreateThroughputBenchmark {

    /**
     * State holding a pre‑created Completable that completes immediately.
     */
    @State(Scope.Thread)
    public static class BenchmarkState {

        /** Completable that uses CompletableCreate with a no‑op source. */
        Completable completable;

        /** A no‑op observer used for subscription. */
        CompletableObserver observer;

        @Setup(Level.Trial)
        public void setUp() {
            // Source that immediately calls onComplete on the emitter.
            CompletableOnSubscribe source = emitter -> emitter.onComplete();

            // The Completable under test.
            completable = new io.reactivex.rxjava3.internal.operators.completable.CompletableCreate(source);

            // Simple observer that just disposes the subscription.
            observer = new CompletableObserver() {
                @Override
                public void onSubscribe(Disposable d) {
                    // No action needed; the disposable will be managed by the Completable.
                }

                @Override
                public void onComplete() {
                    // No action needed.
                }

                @Override
                public void onError(Throwable e) {
                    // Propagate unexpected errors to fail fast.
                    throw new RuntimeException(e);
                }
            };
        }
    }

    /**
     * Benchmark method that subscribes to the Completable and blocks until it terminates.
     *
     * @param state the benchmark state containing the Completable instance.
     */
    @Benchmark
    public void subscribeAndAwait(BenchmarkState state) {
        // Subscribe using the no‑op observer and block until completion.
        // blockingAwait() ensures the subscription has fully finished before the method returns.
        state.completable.subscribe(state.observer);
        // Since the source completes synchronously, we can safely call blockingAwait().
        // This also guarantees that any side‑effects (e.g., disposal) are accounted for.
        state.completable.blockingAwait();
    }
}
```