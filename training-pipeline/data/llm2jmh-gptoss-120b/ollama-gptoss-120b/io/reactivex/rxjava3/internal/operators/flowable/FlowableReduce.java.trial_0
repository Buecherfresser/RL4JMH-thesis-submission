```
package io.reactivex.rxjava3.benchmarks;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.BiFunction;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableReduce}.
 * Measures the throughput of reducing a Flowable of integers using a simple sum reducer.
 *
 * The benchmark follows JMH best‑practice guidelines:
 * - State is scoped to a thread to avoid contention.
 * - The source Flowable and reducer are created once per trial in @Setup.
 * - The result is consumed via Blackhole to prevent dead‑code elimination.
 * - Warm‑up, measurement iterations and forks are defined to obtain stable numbers.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@State(Scope.Thread)
public class FlowableReduceBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     * Typical values cover small, medium and large streams.
     */
    @Param({"1000", "10000", "100000"})
    public int size;

    private Flowable<Integer> source;
    private BiFunction<Integer, Integer, Integer> sumReducer;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a hot source that emits a known range of integers.
        source = Flowable.range(1, size);
        // Simple reducer that adds two integers.
        sumReducer = (a, b) -> a + b;
    }

    /**
     * Executes the reduce operation and consumes the result.
     *
     * @param bh Blackhole to consume the reduced value and avoid dead‑code elimination.
     */
    @Benchmark
    public void reduceSum(Blackhole bh) {
        // The reduce operator returns a Single; blockingGet() materialises the result.
        Integer result = source.reduce(sumReducer).blockingGet();
        bh.consume(result);
    }
}
```