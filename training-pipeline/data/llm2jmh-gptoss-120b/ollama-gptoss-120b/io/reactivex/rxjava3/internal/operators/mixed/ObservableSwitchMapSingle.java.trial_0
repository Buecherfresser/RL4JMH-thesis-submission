```
package io.reactivex.rxjava3.benchmarks.internal.operators.mixed;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.core.Single;
import io.reactivex.rxjava3.functions.Function;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.mixed.ObservableSwitchMapSingle}
 * using the public {@code Observable.switchMapSingle} API.
 *
 * The benchmark measures throughput (operations per second) of a typical
 * switchMapSingle pipeline where the upstream emits a fixed number of items
 * and each item is mapped to a {@code Single.just} source.
 *
 * Best practices applied:
 * - Separate @State for immutable data (source & mapper) to avoid allocation per iteration.
 * - Use @BenchmarkMode(Mode.Throughput) with a time unit of milliseconds.
 * - Warm‑up and measurement iterations are defined to let the JIT stabilize.
 * - Multiple forks to reduce JVM warm‑up bias.
 * - Blackhole consumption to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@Threads(1)
public class ObservableSwitchMapSingleBenchmark {

    @State(Scope.Thread)
    public static class BenchmarkState {

        /** Number of items emitted by the upstream Observable. */
        @Param({"1000", "10000", "100000"})
        public int count;

        /** Upstream Observable emitting a range of integers. */
        Observable<Integer> source;

        /** Mapping function turning each integer into a Single emitting the doubled value. */
        Function<Integer, Single<Integer>> mapper;

        @Setup(Level.Trial)
        public void setUp() {
            source = Observable.range(1, count);
            mapper = i -> Single.just(i * 2);
        }
    }

    @Benchmark
    public void switchMapSingleThroughput(BenchmarkState state, Blackhole bh) {
        // The pipeline: source -> switchMapSingle(mapper) -> blocking consumption.
        // Using blockingForEach ensures the whole stream is processed within the benchmark iteration.
        state.source
                .switchMapSingle(state.mapper)
                .blockingForEach(bh::consume);
    }
}
```