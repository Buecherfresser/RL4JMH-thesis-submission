-						PropertyAnalysis analysis = new PropertyAnalysis(kv.getKey(), info.element, kv.getValue());
-						if (bestAnalysis == null) {
-							bestAnalysis = analysis;
-						} else {
-							int foundKeys = analysis.allKeys.size();
