+        if (id == ARMED) {
+            slow();
+        }
+    }
+
+    private static int parseOp(final String name) {
+        if ("spin".equalsIgnoreCase(name)) {
+            return OP_SPIN;
+        }
+        if ("sleep".equalsIgnoreCase(name)) {
+            return OP_SLEEP;
+        }
+        if ("nanotime".equalsIgnoreCase(name)) {
+            return OP_NANOTIME;
+        }
+        if ("consumecpu".equalsIgnoreCase(name)) {
+            return OP_CONSUMECPU;
+        }
