/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableSkipWhile}.
 * Measures the throughput of the operator when skipping a configurable number of items.
 *
 * Best practices applied:
 * - @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - @Param to allow easy variation of source size and skip count.
 * - Warm‑up and measurement iterations to let the JIT stabilize.
 * - Multiple forks to reduce the impact of JVM start‑up and GC.
 * - Use of Blackhole to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableSkipWhileBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "1000", "10000", "100000" })
    public int sourceSize;

    /**
     * Number of items to skip before emitting downstream.
     */
    @Param({ "0", "10", "100" })
    public int skipCount;

    private Flowable<Integer> flowable;

    private Predicate<Integer> predicate;

    @Setup(Level.Trial)
    public void setUp() {
        // Source emits a range of integers [1 .. sourceSize]
        Flowable<Integer> source = Flowable.range(1, sourceSize);
        // Predicate returns true while the value is less than or equal to skipCount,
        // causing those items to be skipped.
        predicate = value -> value <= skipCount;
        // Apply the skipWhile operator under test.
        flowable = source.skipWhile(predicate);
    }

    @Benchmark
    public void skipWhileThroughput(Blackhole bh) {
        // Subscribe and consume all items, ensuring the work is not optimized away.
        flowable.blockingSubscribe(bh::consume);
    }

    @TearDown(Level.Trial)
    public void tearDown() {
        // Explicitly release references; helps GC between forks.
        flowable = null;
        predicate = null;
    }
}
