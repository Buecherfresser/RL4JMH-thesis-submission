-            if (a.signum() == 0)
-            {
-                throw new ApfloatArithmeticException("Zero to power zero", "pow.zeroToZero");
-            }
-
-            return Apint.ONES[a.radix()];
-        }
-        else if (m.signum() == 0)
-        {
-            return m;                           // By definition
-        }
-
-        m = abs(m);
-
-        Apfloat inverseModulus = ApfloatMath.inverseRoot(m, 1, m.scale() + Apfloat.EXTRA_PRECISION);
-        a = a.mod(m);
-
-        if (b.signum() < 0)
-        {
-            // Calculate modular inverse first
-            a = modInverse(a, m);
-            b = b.negate();
-        }
