+            // Long.MAX_VALUE
+            long sum = endInclusive + startInclusive;
+            return seq(LongStream.rangeClosed(endInclusive, startInclusive).map(x -> sum - x));
+        }
+        if ((endInclusive > startInclusive) != (step > 0))
+            return empty();
