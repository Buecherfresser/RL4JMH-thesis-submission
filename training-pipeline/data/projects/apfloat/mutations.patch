+    static Apcomplex tan(Apcomplex z, boolean negate)
+        throws ArithmeticException, ApfloatRuntimeException
+    {
+        if (z.imag().signum() == 0)
+        {
+            return ApfloatMath.tan(z.real());
+        }
+
+        z = (negate ? z.negate() : z);
