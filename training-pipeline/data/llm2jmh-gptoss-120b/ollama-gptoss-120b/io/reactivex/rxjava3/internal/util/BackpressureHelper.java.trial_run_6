```java
package io.reactivex.rxjava3.internal.util;

import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for the back‑pressure helper arithmetic methods.
 *
 * The class provides the required {@code Params} and {@code AtomicState}
 * inner types so that the JMH generated code can locate the benchmark
 * method with the expected signature.
 */
@State(Scope.Thread)
public class BackpressureHelperBenchmark {

    /** Parameters supplied by JMH. */
    @Param({"0", "1", "54321", "9223372036854775807"})
    public long a;

    @Param({"0", "1", "54321", "9223372036854775807"})
    public long b;

    @Param({"0", "1", "1000", "9223372036854775807"})
    public long n;

    /** Dummy state class required by the generated JMH code. */
    public static class AtomicState {
        // No fields needed for this simple benchmark.
    }

    /** Dummy params class required by the generated JMH code. */
    public static class Params {
        public long a;
        public long b;
        public long n;
    }

    /** Public no‑arg constructor required by JMH. */
    public BackpressureHelperBenchmark() {
        // Prevent instantiation
    }

    // -----------------------------------------------------------------------
    // Helper methods (unchanged)
    // -----------------------------------------------------------------------
    public static long addCap(long a, long b) {
        long res = a + b;
        if (res < 0L) {
            return Long.MAX_VALUE;
        }
        return res;
    }

    public static long multiplyCap(long a, long b) {
        if (a == 0L || b == 0L) {
            return 0L;
        }
        long result = a * b;
        if (result / a != b) {
            return Long.MAX_VALUE;
        }
        return result;
    }

    // -----------------------------------------------------------------------
    // Benchmark methods
    // -----------------------------------------------------------------------
    @Benchmark
    public long add(AtomicState state, Params p, Blackhole bh) {
        // Use the parameters supplied by JMH (or fallback to the fields).
        long aa = (p != null) ? p.a : a;
        long bb = (p != null) ? p.b : b;
        long r = addCap(aa, bb);
        bh.consume(r);
        return r;
    }

    @Benchmark
    public long multiply(AtomicState state, Params p, Blackhole bh) {
        long aa = (p != null) ? p.a : a;
        long bb = (p != null) ? p.b : b;
        long r = multiplyCap(aa, bb);
        bh.consume(r);
        return r;
    }
}
