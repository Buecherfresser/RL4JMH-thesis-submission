+     * @param id the mutant id for this call site
+     */
+    public static void tick(final int id) {
+        if (RECORD && id >= 0 && id < HITS.length) {
+            HITS[id]++;
+        }
+        if (id == ARMED) {
+            slow();
+        }
+    }
+
+    private static void slow() {
+        try {
