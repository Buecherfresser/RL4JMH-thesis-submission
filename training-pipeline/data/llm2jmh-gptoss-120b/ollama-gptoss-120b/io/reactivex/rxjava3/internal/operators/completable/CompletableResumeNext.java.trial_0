package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.functions.Function;
import io.reactivex.rxjava3.internal.operators.completable.CompletableResumeNext;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for {@link CompletableResumeNext}.
 *
 * The benchmark measures the throughput of subscribing to a Completable that
 * fails and then resumes with another Completable via the {@code errorMapper}.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Warm‑up and measurement iterations are defined to let the JIT stabilize.
 * - Multiple forks ensure a clean JVM for each run.
 * - Blackhole is used to consume side‑effects and prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class CompletableResumeNextBenchmark {

    /** Source that always errors. */
    private CompletableSource errorSource;

    /** Mapper that returns a completed Completable. */
    private Function<? super Throwable, ? extends CompletableSource> errorMapper;

    /** The operator under test. */
    private CompletableResumeNext operator;

    /** Simple observer that forwards terminal events to a Blackhole. */
    private static final class BenchmarkObserver implements CompletableObserver {
        private final Blackhole bh;

        BenchmarkObserver(Blackhole bh) {
            this.bh = bh;
        }

        @Override
        public void onSubscribe(Disposable d) {
            // No need to keep the disposable; just consume it to avoid dead code elimination.
            bh.consume(d);
        }

        @Override
        public void onComplete() {
            bh.consume(true); // signal successful completion
        }

        @Override
        public void onError(Throwable e) {
            bh.consume(e);
        }
    }

    @Setup(Level.Trial)
    public void setUp() {
        // A Completable that immediately signals an error.
        errorSource = Completable.error(new RuntimeException("forced error"));

        // The mapper creates a Completable that completes instantly.
        errorMapper = throwable -> Completable.complete();

        // Build the operator instance.
        operator = new CompletableResumeNext(errorSource, errorMapper);
    }

    @Benchmark
    public void subscribeAndResume(Blackhole bh) {
        // Each iteration creates a fresh observer to avoid state leakage.
        operator.subscribe(new BenchmarkObserver(bh));
    }
}
```