+        if ((qx0 * qx1 <= 0 || Math.abs(qx0) <= epsilon || Math.abs(qx1) <= epsilon) &&
+            (qy0 * qy1 <= 0 || Math.abs(qy0) <= epsilon || Math.abs(qy1) <= epsilon))
+            return LineLocation.BETWEEN;
+
+        final double dx = end.x - start.x;
+        final double dy = end.y - start.y;
