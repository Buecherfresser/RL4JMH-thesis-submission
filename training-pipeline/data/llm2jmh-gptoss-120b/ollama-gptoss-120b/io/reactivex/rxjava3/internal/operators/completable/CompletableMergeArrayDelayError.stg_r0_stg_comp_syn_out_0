@State(Scope.Thread)
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@Threads(1)
public class CompletableMergeArrayDelayErrorBenchmark {

    @Param({ "10", "100", "1000" })
    public int sourceCount;

    private CompletableSource[] sources;

    private CompletableMergeArrayDelayError operator;

    @Setup(Level.Trial)
    public void setUp() {
        sources = new CompletableSource[sourceCount];
        for (int i = 0; i < sourceCount; i++) {
            sources[i] = Completable.complete();
        }
        operator = new CompletableMergeArrayDelayError(sources);
    }

    @Benchmark
    public void mergeAndAwait() {
        operator.blockingSubscribe();
    }
}
