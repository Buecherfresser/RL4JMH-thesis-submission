```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.functions.BiFunction;
import org.openjdk.jmh.annotations.*;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableReduceMaybe}
 * measuring the throughput of the reduce operation on an {@link Observable}.
 *
 * The benchmark creates an {@link Observable} emitting a configurable number of integers
 * and applies a simple sum reducer. The result is obtained via {@code blockingGet()}
 * to ensure the operation completes before the measurement ends.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the size of the source to explore scaling behavior.
 * - Include warm‑up, measurement, and fork settings to obtain reliable results.
 * - Use Mode.Throughput to measure operations per second.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@State(Scope.Thread)
public class ObservableReduceMaybeBenchmark {

    /**
     * Number of items emitted by the source Observable.
     * Typical values: 10, 100, 1_000, 10_000, 100_000.
     */
    @Param({"10", "100", "1000", "10000"})
    public int size;

    private Observable<Integer> source;
    private BiFunction<Integer, Integer, Integer> sumReducer;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a cold Observable that emits a range of integers [1, size]
        source = Observable.range(1, size);

        // Simple sum reducer used by ObservableReduceMaybe
        sumReducer = (a, b) -> a + b;
    }

    /**
     * Executes the reduce operation and blocks until the Maybe emits the final result.
     *
     * @return the reduced sum (or null if the source is empty)
     */
    @Benchmark
    public Integer reduceAndBlock() {
        // ObservableReduceMaybe is internally used by the reduceMaybe operator.
        Maybe<Integer> maybe = source.reduceMaybe(sumReducer);
        // blockingGet forces the subscription to complete synchronously,
        // which is appropriate for a throughput benchmark.
        return maybe.blockingGet();
    }
}
```