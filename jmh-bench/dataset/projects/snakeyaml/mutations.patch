+     */
+    private static void spin(final long tokens) {
+        long t = consumed;
+        for (long i = tokens; i > 0L; i--) {
+            t += t * 0x5DEECE66DL + 0xBL;
+        }
+        if (t == 42L) {
+            consumed = t;
+        }
+    }
+
+    /**
