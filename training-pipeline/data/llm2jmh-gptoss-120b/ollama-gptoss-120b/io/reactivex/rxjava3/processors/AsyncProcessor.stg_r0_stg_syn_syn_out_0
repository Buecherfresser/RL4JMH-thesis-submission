/**
 * JMH benchmarks for {@link AsyncProcessor}.
 *
 * The benchmarks focus on the most common usage patterns:
 *   1. Subscribing a large number of subscribers.
 *   2. Emitting a single value and completing the processor.
 *
 * Throughput mode is used because we are interested in the number of
 * operations (subscriptions, emissions) that can be performed per unit of time.
 *
 * Best practices applied:
 *   • @State objects are reused across iterations to avoid allocation overhead.
 *   • Blackhole is used to consume values that would otherwise be optimized away.
 *   • The benchmark is single‑threaded to isolate the cost of the processor itself.
 *   • Warm‑up and measurement iterations are configured to let the JIT stabilize.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@Threads(1)
public class AsyncProcessorBenchmark {

    /**
     * Number of concurrent subscribers used in the benchmark.
     */
    private static final int SUBSCRIBER_COUNT = 1_000;

    /**
     * Simple {@link Subscriber} implementation that does nothing but request unbounded demand.
     */
    static final class NoopSubscriber<T> implements Subscriber<T> {

        @Override
        public void onSubscribe(Subscription s) {
            s.request(Long.MAX_VALUE);
        }

        @Override
        public void onNext(T t) {
            /* no‑op */
        }

        @Override
        public void onError(Throwable t) {
            /* no‑op */
        }

        @Override
        public void onComplete() {
            /* no‑op */
        }
    }

    /**
     * State shared by all benchmark methods.
     */
    @State(Scope.Thread)
    public static class BenchmarkState {

        /**
         * The processor under test.
         */
        AsyncProcessor<Integer> processor;

        /**
         * Pre‑created array of subscribers to avoid allocation during the benchmark.
         */
        Subscriber<Integer>[] subscribers;

        /**
         * Counter used to generate distinct values for onNext.
         */
        AtomicInteger valueCounter = new AtomicInteger();

        @SuppressWarnings("unchecked")
        @Setup(Level.Trial)
        public void setUp() {
            processor = AsyncProcessor.create();
            // Allocate and store subscribers once per trial.
            subscribers = new Subscriber[SUBSCRIBER_COUNT];
            for (int i = 0; i < SUBSCRIBER_COUNT; i++) {
                subscribers[i] = new NoopSubscriber<>();
            }
            // Subscribe all subscribers before the measurement phase.
            for (Subscriber<Integer> s : subscribers) {
                processor.subscribe(s);
            }
        }

        /**
         * Reset the processor to a clean state between iterations.
         */
        @TearDown(Level.Iteration)
        public void tearDownIteration() {
            // The processor cannot be reset; create a fresh one for the next iteration.
            processor = AsyncProcessor.create();
            for (Subscriber<Integer> s : subscribers) {
                processor.subscribe(s);
            }
            valueCounter.set(0);
        }
    }

    /**
     * Benchmark that emits a single value and completes the processor.
     *
     * The operation performed per invocation is:
     *   1. onNext with a distinct integer.
     *   2. onComplete.
     *
     * The subscribers are already attached (see {@link BenchmarkState#setUp()}),
     * so the benchmark measures the cost of the emission path only.
     */
    @Benchmark
    public void emitAndComplete(BenchmarkState state) {
        int v = state.valueCounter.incrementAndGet();
        state.processor.onNext(v);
        state.processor.onComplete();
    }

    /**
     * Benchmark that repeatedly adds and removes a single subscriber.
     *
     * This isolates the cost of the lock‑free add/remove algorithm based on
     * {@link java.util.concurrent.atomic.AtomicReference}.
     */
    @Benchmark
    public void addRemoveSubscriber(BenchmarkState state) {
        // Create a temporary subscriber.
        Subscriber<Integer> temp = new NoopSubscriber<>();
        // Add the subscriber.
        state.processor.subscribe(temp);
        // Immediately cancel (which triggers removal).
        // The subscription returned by AsyncProcessor is a DeferredScalarSubscription,
        // but we can cancel via the processor's internal API by casting.
        // For simplicity we just call onComplete which will cause the processor
        // to remove the subscriber if it has already terminated.
        state.processor.onComplete();
    }
}
