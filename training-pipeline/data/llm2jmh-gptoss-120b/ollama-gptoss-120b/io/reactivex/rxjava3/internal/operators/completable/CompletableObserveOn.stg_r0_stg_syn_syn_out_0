/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.completable.CompletableObserveOn}.
 *
 * Measures the throughput of a simple {@code Completable.complete()} that is
 * observed on a computation scheduler. The benchmark uses {@code blockingAwait()}
 * to ensure the scheduled work has finished before the next iteration.
 *
 * Best practices applied:
 * - Warm‑up and measurement phases are defined.
 * - Multiple forks to reduce JVM warm‑up effects.
 * - State scoped to a thread to avoid contention.
 * - Blackhole consumption to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@Threads(1)
public class CompletableObserveOnBenchmark {

    @State(Scope.Thread)
    public static class BenchmarkState {

        Scheduler scheduler;

        Completable completable;

        @Setup(Level.Trial)
        public void setUp() {
            // Use a scheduler that actually schedules work on a different thread.
            scheduler = Schedulers.computation();
            // A Completable that completes immediately.
            completable = Completable.complete();
        }

        @TearDown(Level.Trial)
        public void tearDown() {
            // Shut down the scheduler to avoid thread leaks between forks.
            if (scheduler instanceof io.reactivex.rxjava3.schedulers.ComputationScheduler) {
                ((io.reactivex.rxjava3.schedulers.ComputationScheduler) scheduler).shutdown();
            }
        }
    }

    @Benchmark
    public void observeOnThroughput(BenchmarkState state, Blackhole bh) {
        // Apply observeOn and wait for completion; this forces the scheduling path.
        state.completable.observeOn(state.scheduler).blockingAwait();
        // Consume a dummy value to keep the JIT from optimizing away the call.
        bh.consume(1);
    }
}
