/**
 * Benchmark for {@link FlowableToListSingle}.
 *
 * Measures the throughput of converting a {@link Flowable} into a {@link Single}
 * that emits a collection containing all upstream items.
 *
 * The benchmark varies the size of the source {@code Flowable} and the type of
 * collection supplied (ArrayList by default). It uses {@code blockingGet()} to
 * force the terminal signal and consumes the result with a {@link Blackhole}
 * to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableToListSingleBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     */
    @Param({ "10", "100", "1_000", "10_000", "100_000" })
    public int size;

    /**
     * Supplier for the collection that will hold the items.
     */
    private Supplier<Collection<Integer>> collectionSupplier;

    /**
     * The Flowable source used in each benchmark iteration.
     */
    private Flowable<Integer> source;

    /**
     * The Single that materialises the list.
     */
    private Single<? extends Collection<Integer>> single;

    @Setup(Level.Trial)
    public void setUp() {
        // Use a simple range Flowable as the upstream source.
        source = Flowable.range(1, size);
        // Default to an ArrayList supplier (the same as the operator's default).
        collectionSupplier = ArrayListSupplier.asSupplier();
        // Create the operator instance.
        FlowableToListSingle<Integer, Collection<Integer>> operator = new FlowableToListSingle<>(source, collectionSupplier);
        // The operator implements Single, so we can keep a reference to it.
        single = operator;
    }

    @Benchmark
    public void toListSingleThroughput(Blackhole bh) {
        // Trigger the flow, block until the collection is produced,
        // and consume it with Blackhole to avoid dead‑code elimination.
        bh.consume(single.blockingGet());
    }
}
