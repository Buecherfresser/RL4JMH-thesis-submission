```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Completable;
import io.reactivex.rxjava3.internal.operators.completable.CompletableTimeout;
import io.reactivex.rxjava3.schedulers.Schedulers;
import io.reactivex.rxjava3.core.Scheduler;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmarks for {@link CompletableTimeout}.
 *
 * <p>Two scenarios are measured:
 * <ul>
 *   <li>{@code timeoutNoDelay} – the source completes immediately, so the timeout task is cancelled.</li>
 *   <li>{@code timeoutWithFallback} – the source never completes, the timeout fires and the fallback {@code other}
 *       Completable is subscribed.</li>
 * </ul>
 *
 * <p>Throughput mode is used because we are interested in how many subscriptions per second the operator can
 * handle under steady‑state conditions.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class CompletableTimeoutBenchmark {

    /** Scheduler used by the operator. Re‑using the same scheduler avoids the cost of thread‑pool creation. */
    private Scheduler scheduler;

    /** Common fallback Completable used when the timeout fires. */
    private Completable fallback;

    @Setup(Level.Trial)
    public void setUp() {
        // Computation scheduler is a good default for short‑lived tasks.
        scheduler = Schedulers.computation();
        fallback = Completable.complete();
    }

    @TearDown(Level.Trial)
    public void tearDown() {
        // Dispose the scheduler to shut down its worker threads cleanly.
        scheduler.shutdown();
    }

    /**
     * Benchmark where the source completes immediately.
     *
     * <p>The timeout task should be cancelled, exercising the fast‑path of the operator.
     */
    @Benchmark
    public void timeoutNoDelay(Blackhole bh) {
        Completable source = Completable.complete();

        CompletableTimeout op = new CompletableTimeout(
                source,
                1,                     // timeout value (won't be reached)
                TimeUnit.MILLISECONDS,
                scheduler,
                fallback               // not used in this scenario
        );

        // blockingAwait blocks until the Completable terminates.
        op.blockingAwait();

        // Consume a dummy value to prevent dead‑code elimination.
        bh.consume(op);
    }

    /**
     * Benchmark where the source never completes, causing the timeout to fire and the fallback to be subscribed.
     *
     * <p>This measures the cost of scheduling, timeout handling and the fallback subscription.
     */
    @Benchmark
    public void timeoutWithFallback(Blackhole bh) {
        Completable source = Completable.never();

        CompletableTimeout op = new CompletableTimeout(
                source,
                1,                     // short timeout to keep the benchmark fast
                TimeUnit.MILLISECONDS,
                scheduler,
                fallback               // will be subscribed after timeout
        );

        op.blockingAwait();

        bh.consume(op);
    }
}
```