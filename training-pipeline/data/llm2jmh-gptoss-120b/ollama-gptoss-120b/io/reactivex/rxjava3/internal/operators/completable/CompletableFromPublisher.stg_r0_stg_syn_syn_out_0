/**
 * Benchmark for {@link CompletableFromPublisher}.
 * Measures the throughput of subscribing to a Completable that wraps an already completed Publisher.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Benchmark)
public class CompletableFromPublisherBenchmark {

    /**
     * A Completable that wraps an empty Publisher (completes immediately).
     */
    private Completable completable;

    @Setup(Level.Trial)
    public void setUp() {
        // Flowable.empty() completes without emitting any items.
        completable = new CompletableFromPublisher<>(Flowable.empty());
    }

    /**
     * Subscribes to the Completable and blocks until completion.
     * The method itself does not return a value; the throughput measurement
     * counts how many complete subscriptions can be performed per second.
     */
    @Benchmark
    public void subscribeAndAwait() {
        // blockingAwait() will block the current thread until the Completable terminates.
        // Any exception would be propagated as a RuntimeException, which is fine for the benchmark.
        completable.blockingAwait();
    }
}
