```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.Maybe;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Microbenchmark for {@link io.reactivex.rxjava3.internal.operators.maybe.MaybeSubscribeOn}.
 *
 * The benchmark measures the throughput of subscribing to a {@code Maybe} that
 * is shifted onto a {@link io.reactivex.rxjava3.core.Scheduler} via
 * {@code subscribeOn}. The {@code Maybe} emits a single integer value and
 * completes immediately, allowing us to focus on the overhead introduced by
 * the {@code MaybeSubscribeOn} operator and the scheduler dispatch.
 *
 * Best‑practice JMH settings are used:
 *   • Warm‑up iterations to let the JIT stabilize.
 *   • Measurement iterations for reliable results.
 *   • Scope.Thread state to avoid cross‑thread interference.
 *   • Blackhole consumption to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class MaybeSubscribeOnBenchmark {

    /** Source {@code Maybe} that emits a constant value. */
    private Maybe<Integer> source;

    /** Scheduler used for {@code subscribeOn}. */
    private io.reactivex.rxjava3.core.Scheduler scheduler;

    @Setup(Level.Trial)
    public void setUp() {
        // A simple Maybe that emits a single integer and completes.
        source = Maybe.just(42);
        // Use a single‑threaded scheduler to avoid thread‑pool contention.
        scheduler = Schedulers.single();
    }

    /**
     * Benchmark that subscribes to the {@code Maybe} on the configured scheduler
     * and blocks until the value is received. The result is consumed by a
     * {@link Blackhole} to prevent the JIT from optimizing the call away.
     *
     * @param bh Blackhole to consume the emitted value.
     */
    @Benchmark
    public void subscribeOnBlockingGet(Blackhole bh) {
        // Apply subscribeOn and block for the result.
        Integer result = source.subscribeOn(scheduler).blockingGet();
        bh.consume(result);
    }
}
```