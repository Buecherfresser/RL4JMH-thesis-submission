+    static Apfloat acos(Apfloat x, long precision)
+    {
+        if (x.signum() == 0)
+        {
+            return halfPi(x.radix(), precision);
+        }
+        return acos(x);
+    }
+
+    static Apfloat halfPi(int radix, long precision)
+    {
+        return pi(precision, radix).divide(new Apfloat(2, precision, radix));
