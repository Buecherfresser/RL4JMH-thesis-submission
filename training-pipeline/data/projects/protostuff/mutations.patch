-        {
-            char c = fileName.charAt(i);
-            if (isAlpha(c) || isNumber(c) || isAllowedCharacter(c))
-            {
-                sb.append(c);
-            }
-            else
-            {
-                sb.append('_');
-            }
-        }
-        return sb.toString();
