+        for (double element: array) {
+            if (element < 0)
+                throw new IllegalArgumentException("array element < 0");
+
+            sum += element;
+        }
+
+        if (sum != 0) {
+            for (int i = 0; i < array.length; i++)
+                array[i] /= sum;
+        } else {
+            final double value = 1.0 / array.length;
+            for (int i = 0; i < array.length; i++)
+                array[i] = value;
+        }
+
+        return sum;
+    }
+
+    /**
