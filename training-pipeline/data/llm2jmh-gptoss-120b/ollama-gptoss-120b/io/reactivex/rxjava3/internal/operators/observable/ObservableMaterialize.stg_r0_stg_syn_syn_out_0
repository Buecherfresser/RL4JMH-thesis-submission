/**
 * Benchmark for {@link ObservableMaterialize}.
 *
 * Measures the throughput of materializing a finite Observable sequence.
 * The source Observable is created once per trial to avoid measuring its construction cost.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
public class ObservableMaterializeBenchmark {

    /**
     * Number of items emitted by the source Observable.
     * Varying this parameter helps to understand how the operator scales.
     */
    @Param({ "1", "10", "1000", "100000" })
    public int size;

    private Observable<Integer> source;

    private Observable<Notification<Integer>> materialized;

    /**
     * Set up the source Observable and the materialized Observable once per trial.
     */
    @Setup(Level.Trial)
    public void setUp() {
        // A simple range source; creation cost is excluded from the benchmark.
        source = Observable.range(1, size);
        // Directly instantiate the operator under test.
        materialized = new ObservableMaterialize<>(source);
    }

    /**
     * Benchmark method that subscribes to the materialized Observable and consumes all notifications.
     *
     * @param bh Blackhole to consume the emitted {@link Notification}s and prevent dead‑code elimination.
     */
    @Benchmark
    public void materialize(Blackhole bh) {
        // blockingSubscribe ensures the whole stream is processed within the benchmark iteration.
        materialized.blockingSubscribe(bh::consume);
    }
}
