package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.functions.Action;
import io.reactivex.rxjava3.functions.Consumer;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@code ObservableDoOnEach}.
 *
 * Measures the throughput of an Observable pipeline with and without the {@code doOnEach}
 * side‑effect operator.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class ObservableDoOnEachBenchmark {

    @Param({"1000"})
    private int size;

    private Observable<Integer> plainSource;
    private Observable<Integer> doOnEachSource;

    private static final Consumer<Integer> NOOP_CONSUMER = v -> {
        // no‑op
    };
    private static final Consumer<Throwable> NOOP_ERROR = e -> {
        // no‑op
    };
    private static final Action NOOP_ACTION = () -> {
        // no‑op
    };

    @Setup(Level.Trial)
    public void setUp() {
        plainSource = Observable.range(1, size);
        // Use the public overloads: doOnEach with three arguments + doAfterTerminate
        doOnEachSource = plainSource
                .doOnEach(NOOP_CONSUMER, NOOP_ERROR, NOOP_ACTION)
                .doAfterTerminate(NOOP_ACTION);
    }

    @Benchmark
    public void baseline(Blackhole bh) {
        plainSource.subscribe(bh::consume);
    }

    @Benchmark
    public void doOnEach(Blackhole bh) {
        doOnEachSource.subscribe(bh::consume);
    }
}
