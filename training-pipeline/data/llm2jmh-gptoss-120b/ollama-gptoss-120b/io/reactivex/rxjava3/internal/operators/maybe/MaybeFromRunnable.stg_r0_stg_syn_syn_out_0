/**
 * JMH benchmark for {@link MaybeFromRunnable}.
 *
 * <p>Measures the throughput of:
 * <ul>
 *   <li>direct {@code Runnable.run()}</li>
 *   <li>subscribing to a {@code MaybeFromRunnable}</li>
 * </ul>
 *
 * <p>All benchmarks use a no‑op {@code Runnable} and a no‑op {@code MaybeObserver}
 * to isolate the overhead of the RxJava plumbing.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class MaybeFromRunnableBenchmark {

    /**
     * A no‑op runnable used for both direct and Maybe execution.
     */
    private Runnable noopRunnable;

    /**
     * The Maybe wrapper around the no‑op runnable.
     */
    private MaybeFromRunnable<Object> maybeFromRunnable;

    /**
     * A no‑op MaybeObserver that simply discards signals.
     */
    private static final MaybeObserver<Object> NOOP_OBSERVER = new MaybeObserver<Object>() {

        @Override
        public void onSubscribe(Disposable d) {
            /* no‑op */
        }

        @Override
        public void onSuccess(Object value) {
            /* no‑op */
        }

        @Override
        public void onError(Throwable e) {
            /* no‑op */
        }

        @Override
        public void onComplete() {
            /* no‑op */
        }
    };

    @Setup(Level.Trial)
    public void setUp() {
        // The runnable does absolutely nothing – this isolates the overhead of the RxJava machinery.
        noopRunnable = () -> {
            /* intentionally empty */
        };
        maybeFromRunnable = new MaybeFromRunnable<>(noopRunnable);
    }

    /**
     * Benchmark that measures the raw cost of invoking {@code Runnable.run()}.
     *
     * @param bh Blackhole to prevent dead‑code elimination.
     */
    @Benchmark
    public void directRun(Blackhole bh) {
        // The Blackhole ensures the JIT does not inline away the call.
        bh.consume(noopRunnable);
        noopRunnable.run();
    }

    /**
     * Benchmark that measures the cost of subscribing to {@link MaybeFromRunnable}
     * and letting it complete.
     *
     * @param bh Blackhole to prevent dead‑code elimination.
     */
    @Benchmark
    public void maybeRun(Blackhole bh) {
        // The Blackhole is used only to keep the reference alive; the observer does nothing.
        bh.consume(maybeFromRunnable);
        maybeFromRunnable.subscribe(NOOP_OBSERVER);
    }
}
