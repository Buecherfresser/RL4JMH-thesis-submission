package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.Action;
import io.reactivex.rxjava3.functions.Consumer;
import io.reactivex.rxjava3.functions.LongConsumer;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableDoOnLifecycle}
 * measuring the throughput of a simple range source passing through the operator
 * with no‑op lifecycle callbacks.
 *
 * The benchmark subscribes to the Flowable and blocks until completion to
 * include the full upstream‑downstream processing cost.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableDoOnLifecycleThroughputBenchmark {

    /** Number of items emitted by the source Flowable per iteration. */
    @Param({"1000", "100000", "1000000"})
    public int itemCount;

    /** The Flowable under test, created in the @Setup method. */
    private Flowable<Integer> flowable;

    /** No‑op onSubscribe callback. */
    private static final Consumer<org.reactivestreams.Subscription> NOOP_SUBSCRIBE = s -> {
        // intentionally empty
    };

    /** No‑op onRequest callback. */
    private static final LongConsumer NOOP_REQUEST = n -> {
        // intentionally empty
    };

    /** No‑op onCancel callback. */
    private static final Action NOOP_CANCEL = () -> {
        // intentionally empty
    };

    @Setup(Level.Trial)
    public void setUp() {
        // Create a source that emits a deterministic range of integers.
        Flowable<Integer> source = Flowable.range(1, itemCount);

        // Apply the operator with no‑op lifecycle callbacks.
        flowable = source.doOnLifecycle(NOOP_SUBSCRIBE, NOOP_REQUEST, NOOP_CANCEL);
    }

    /**
     * Subscribes to the Flowable and blocks until it completes.
     * The Blackhole is used to consume each emitted item to prevent dead‑code elimination.
     */
    @Benchmark
    public void throughput(Blackhole bh) {
        flowable.blockingSubscribe(bh::consume);
    }
}
```