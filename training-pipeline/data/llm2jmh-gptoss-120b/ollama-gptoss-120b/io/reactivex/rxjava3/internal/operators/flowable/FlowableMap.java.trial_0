```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.Function;
import io.reactivex.rxjava3.subscribers.TestSubscriber;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmarks for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableMap}.
 * Measures throughput of the map operator with a simple identity mapper.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableMapBenchmark {

    /** Number of items emitted by the source Flowable. */
    @Param({"1_000", "10_000", "100_000"})
    public int size;

    /** Source Flowable emitting a range of integers. */
    private Flowable<Integer> source;

    /** Simple mapper that adds a constant (identity for benchmarking). */
    private Function<Integer, Integer> mapper;

    /** Subscriber that consumes all items without additional overhead. */
    private TestSubscriber<Integer> subscriber;

    @Setup(Level.Trial)
    public void setup() {
        // Use a range source; the upstream is fused when possible.
        source = Flowable.range(1, size);

        // Identity mapper (no allocation) – realistic for many map use‑cases.
        mapper = v -> v + 0;

        // Reuse a fresh TestSubscriber for each benchmark iteration.
        subscriber = new TestSubscriber<>();
    }

    /**
     * Benchmark the map operator with a regular Subscriber.
     */
    @Benchmark
    public void mapRegularSubscriber(Blackhole bh) {
        // Reset the subscriber to avoid state leakage between iterations.
        subscriber.cancel();
        subscriber = new TestSubscriber<>();

        source
            .map(mapper)               // the operator under test
            .subscribe(subscriber);    // subscribe with a regular subscriber

        // Ensure all items are consumed; block until termination.
        subscriber.awaitDone(Long.MAX_VALUE, TimeUnit.NANOSECONDS);

        // Consume the result to prevent dead‑code elimination.
        bh.consume(subscriber.values().size());
    }

    /**
     * Benchmark the map operator when the downstream implements {@link io.reactivex.rxjava3.operators.ConditionalSubscriber}.
     * RxJava's {@code Flowable.map} detects ConditionalSubscriber and uses the optimized path.
     */
    @Benchmark
    public void mapConditionalSubscriber(Blackhole bh) {
        // ConditionalSubscriber is exercised via the internal TestSubscriber which implements it.
        subscriber.cancel();
        subscriber = new TestSubscriber<>();

        source
            .map(mapper)
            .filter(v -> true) // forces a ConditionalSubscriber downstream
            .subscribe(subscriber);

        subscriber.awaitDone(Long.MAX_VALUE, TimeUnit.NANOSECONDS);
        bh.consume(subscriber.values().size());
    }
}
```