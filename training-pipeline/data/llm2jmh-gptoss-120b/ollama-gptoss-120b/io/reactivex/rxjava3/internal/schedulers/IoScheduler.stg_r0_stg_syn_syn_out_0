/**
 * JMH benchmark for {@link IoScheduler}.
 *
 * Measures the throughput of scheduling a no‑op task on the IoScheduler.
 *
 * Best‑practice settings:
 * - Warm‑up iterations to let the JIT stabilize.
 * - Multiple measurement iterations for statistical confidence.
 * - Several forks to isolate JVM state.
 * - Use a single thread for the benchmark method to avoid contention on the scheduler
 *   (the scheduler itself creates its own worker threads).
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.MILLISECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Benchmark)
public class IoSchedulerBenchmark {

    private IoScheduler ioScheduler;

    private Scheduler.Worker worker;

    private Runnable noop;

    @Setup(Level.Trial)
    public void setUp() {
        // Use the default thread factory; the scheduler will create its own pool.
        ioScheduler = new IoScheduler();
        // Create a single worker that will be reused for all schedule calls.
        worker = ioScheduler.createWorker();
        // A no‑op task that does virtually nothing.
        noop = () -> {
            // intentionally empty
        };
    }

    @TearDown(Level.Trial)
    public void tearDown() {
        // Dispose the worker and shut down the scheduler to release resources.
        if (worker != null) {
            worker.dispose();
        }
        if (ioScheduler != null) {
            ioScheduler.shutdown();
        }
    }

    /**
     * Schedule a no‑op task with zero delay.
     *
     * The returned {@link Disposable} is ignored because the task completes immediately.
     * This benchmark focuses on the overhead of the scheduling path inside {@link IoScheduler}.
     */
    @Benchmark
    public Disposable scheduleNoop() {
        return worker.schedule(noop, 0, TimeUnit.NANOSECONDS);
    }
}
