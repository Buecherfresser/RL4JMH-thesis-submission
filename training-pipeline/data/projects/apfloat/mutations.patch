+        return "Calculator applet" + lineSeparator +
+               "Written by Mikko Tommila 2011 - 2023" + lineSeparator +
+               "Java version: "         + System.getProperty("java.version") + lineSeparator +
+               "Java Virtual Machine: " + System.getProperty("java.vm.name");
+    }
+}
