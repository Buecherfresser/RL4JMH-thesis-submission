# Copy this file to `.env` and fill in the keys you actually use. The CLI
# auto-loads `.env` from the current working directory (walking upwards) and
# falls back to the one next to this file, so any of:
#
#   jmhbench run --harness openrouter ...
#   cd /tmp && jmhbench run --harness openrouter ...
#
# will pick the keys up. Existing environment variables always win, so an
# explicit `export OPENROUTER_API_KEY=...` in the shell overrides the file.

# OpenRouter — single key gets you Anthropic, OpenAI, Google, Meta, Mistral,
# xAI, DeepSeek, ... all behind one OpenAI-compatible endpoint.
OPENROUTER_API_KEY=sk-or-v1-...
# Optional default model so you don't need `-o model=...` every run.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# OpenAI / Azure / vLLM / Ollama (anything OpenAI-compatible)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Anthropic native API (if you want to bypass OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-...

# Remote eval VM (tools/remote_run_eval.sh reads these)
# REMOTE=bsc-gcp
# REMOTE_BASE=jmhbench-remote          # relative to remote $HOME (recommended)
# REMOTE_BASE='~/jmhbench-remote'      # or explicit ~ — quote it, or bash expands to macOS paths
# JAVA_HOME_HINT=/usr/lib/jvm/java-21-openjdk-amd64   # optional; auto-detected if omitted
# SSH_OPTS=-i ~/.ssh/mykey

# Eval matrix overrides (optional — defaults live in tools/run_eval.sh)
# HARNESS=openai-zero-shot
# TRACKS=project synthetic
# TEMPS=0 1
# THINKING=true false
# PARALLEL=32
