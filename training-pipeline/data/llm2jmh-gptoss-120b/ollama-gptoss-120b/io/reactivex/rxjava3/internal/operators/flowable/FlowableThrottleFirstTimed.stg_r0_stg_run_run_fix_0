package io.reactivex.rxjava3.internal.operators.flowable;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.core.Scheduler;
import io.reactivex.rxjava3.functions.Consumer;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link FlowableThrottleFirstTimed}.
 * Measures the throughput (items per second) when applying the throttle-first operator
 * to a hot source emitting a large number of items.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Perform heavy setup in @Setup to exclude it from measurement.
 * - Use Blackhole to consume emitted items and prevent dead-code elimination.
 * - Configure warm‑up, measurement iterations and forks for reliable results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class FlowableThrottleFirstTimedBenchmark {

    /** Number of items emitted by the source in each benchmark iteration. */
    @Param({ "1000000" })
    public int itemCount;

    /** Timeout for the throttleFirst operator (in milliseconds). */
    @Param({ "1" })
    public long timeoutMs;

    private Flowable<Integer> source;
    private Flowable<Integer> throttled;

    /** No‑op consumer used when the user does not want to handle dropped items. */
    private static final Consumer<Object> NOOP = v -> {};

    @Setup(Level.Trial)
    public void setUp() {
        // A hot source that emits a known number of items as fast as possible.
        source = Flowable.range(1, itemCount)
                .subscribeOn(Schedulers.computation());

        // Apply the throttleFirstTimed operator with the configured timeout.
        // Provide a no‑op onDropped consumer to satisfy the non‑null requirement.
        throttled = source.throttleFirst(
                timeoutMs,
                TimeUnit.MILLISECONDS,
                Schedulers.computation(),
                NOOP
        );
    }

    /**
     * Benchmark method that subscribes to the throttled Flowable and consumes all emitted items.
     * The Blackhole ensures that the consumed values are not optimized away.
     */
    @Benchmark
    public void throttleFirstTimed(Blackhole bh) {
        throttled.blockingSubscribe(bh::consume);
    }
}
