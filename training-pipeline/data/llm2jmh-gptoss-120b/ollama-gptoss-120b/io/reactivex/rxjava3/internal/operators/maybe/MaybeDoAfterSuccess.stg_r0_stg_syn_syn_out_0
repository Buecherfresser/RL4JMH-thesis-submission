/**
 * JMH benchmark for {@link MaybeDoAfterSuccess}.
 *
 * The benchmark measures the throughput (operations per second) of a Maybe that
 * emits a single value and invokes a no‑op {@code Consumer} after success.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Pre‑create the Maybe instance in @Setup to exclude allocation overhead.
 * - Use Blackhole to consume the result and prevent dead‑code elimination.
 * - Configure warm‑up, measurement, forks and time units.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3, jvmArgsAppend = { "-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation" })
@State(Scope.Thread)
public class MaybeDoAfterSuccessBenchmark {

    /**
     * A no‑op consumer used as the after‑success action.
     */
    private static final Consumer<Object> NO_OP = v -> {
        // intentionally empty
    };

    /**
     * The Maybe source that emits a constant value.
     */
    private Maybe<Integer> source;

    /**
     * The Maybe under test: source with the doAfterSuccess operator applied.
     */
    private Maybe<Integer> maybeDoAfterSuccess;

    @Setup(Level.Trial)
    public void setUp() {
        // Create a simple source that emits a constant integer.
        source = Maybe.just(1);
        // Apply the operator under test with a no‑op consumer.
        maybeDoAfterSuccess = new MaybeDoAfterSuccess<>(source, NO_OP);
    }

    /**
     * Benchmark method that subscribes to the Maybe and blocks until the value is received.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void testDoAfterSuccess(Blackhole bh) {
        // blockingGet() is used to make the operation synchronous for the benchmark.
        Integer result = maybeDoAfterSuccess.blockingGet();
        bh.consume(result);
    }
}
