+    private R connectEmpty() {
+        synchronized (root) {
+            Connector<T, R> l = left, r = right;
+            if (l == null) {
+                return pushRight(none(), none());
+            }
+            left = right = null;
+            l.rhs = null;
+            T laright = l.right;
+            l.right = none();
+            if (l.acc == NONE) {
+                if (r == null)
+                    l.drain();
+                else {
+                    if (l.lhs != null) {
+                        l.lhs.right = r;
+                        r.lhs = l.lhs;
+                    }
+                }
+                return none();
+            }
+            if (r == null) {
