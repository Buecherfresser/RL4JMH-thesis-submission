```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.*;
import io.reactivex.rxjava3.internal.operators.observable.ObservableConcatMapEager;
import io.reactivex.rxjava3.operators.QueueDisposable;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicLong;
import java.util.function.Function;

/**
 * JMH benchmark for {@link ObservableConcatMapEager}.
 *
 * The benchmark measures the throughput (items per second) of the eager concat‑map
 * operator under a typical workload: a source emitting a range of integers,
 * each mapped to a small inner Observable. The inner Observables are executed
 * on the {@link Schedulers#computation()} scheduler to exercise the concurrency
 * aspects of the operator.
 *
 * Best‑practice notes:
 * • Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * • Pre‑create the source and mapper in @Setup to keep the benchmark method focused
 *   on the operation under test.
 * • Use a CountDownLatch to wait for completion without blocking the JMH thread pool.
 * • Consume the emitted items via Blackhole to prevent dead‑code elimination.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@Threads(1)
public class ObservableConcatMapEagerBenchmark {

    @State(Scope.Thread)
    public static class BenchmarkState {

        /** Number of items emitted by the upstream source. */
        @Param({"1000", "10000", "100000"})
        public int sourceSize;

        /** Max concurrency for the eager concat‑map operator. */
        @Param({"2", "8", "32"})
        public int maxConcurrency;

        /** Prefetch size for each inner Observable. */
        @Param({"16", "64", "256"})
        public int prefetch;

        /** The upstream Observable source. */
        Observable<Integer> source;

        /** Mapper function that creates an inner Observable for each upstream item. */
        Function<Integer, ObservableSource<Integer>> mapper;

        /** Scheduler used for inner Observables to trigger concurrency. */
        Scheduler innerScheduler;

        @Setup(Level.Trial)
        public void setUp() {
            // Simple range source; each item is mapped to a small inner Observable.
            source = Observable.range(1, sourceSize);

            // Mapper creates an inner Observable that emits the value and completes.
            // Using observeOn to force asynchronous execution and engage the operator's
            // concurrency handling.
            mapper = v -> Observable.just(v)
                    .observeOn(innerScheduler = Schedulers.computation());

            // Warm up the scheduler threads once per trial.
            innerScheduler.scheduleDirect(() -> {});
        }

        /**
         * Helper observer that counts received items and signals completion via a latch.
         */
        static final class CountingObserver implements Observer<Integer> {
            final CountDownLatch latch;
            final Blackhole bh;
            final AtomicLong count = new AtomicLong();

            CountingObserver(CountDownLatch latch, Blackhole bh) {
                this.latch = latch;
                this.bh = bh;
            }

            @Override public void onSubscribe(Disposable d) { /* no‑op */ }

            @Override public void onNext(Integer t) {
                count.incrementAndGet();
                bh.consume(t);
            }

            @Override public void onError(Throwable e) {
                // Propagate error to the latch to avoid hanging the benchmark.
                latch.countDown();
                throw new RuntimeException(e);
            }

            @Override public void onComplete() {
                latch.countDown();
            }
        }
    }

    @Benchmark
    public long eagerConcatMapThroughput(BenchmarkState state, Blackhole bh) throws InterruptedException {
        // Create the operator instance manually to avoid extra layers of indirection.
        ObservableConcatMapEager<Integer, Integer> operator =
                new ObservableConcatMapEager<>(
                        state.source,
                        state.mapper,
                        ObservableConcatMapEager.ErrorMode.IMMEDIATE,
                        state.maxConcurrency,
                        state.prefetch);

        CountDownLatch latch = new CountDownLatch(1);
        BenchmarkState.CountingObserver observer = new BenchmarkState.CountingObserver(latch, bh);

        // Subscribe and block until the stream completes.
        operator.subscribe(observer);
        latch.await();

        // Return the number of items processed; JMH will compute throughput.
        return observer.count.get();
    }
}
```