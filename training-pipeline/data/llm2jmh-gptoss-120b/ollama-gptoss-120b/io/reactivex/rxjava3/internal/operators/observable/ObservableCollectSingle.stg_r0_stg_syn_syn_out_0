/**
 * Benchmark for {@link ObservableCollectSingle}.
 *
 * Measures the throughput of collecting a stream of integers into a mutable container.
 * The benchmark runs in {@link Mode#Throughput} (operations per second) which is the
 * most common metric for reactive pipelines.
 *
 * Best‑practice JMH settings:
 * - Warmup to let the JIT stabilize.
 * - Multiple measurement iterations for statistical confidence.
 * - Forking to isolate JVM state.
 * - Using @State(Scope.Thread) to avoid sharing mutable state between threads.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@State(Scope.Thread)
public class ObservableCollectSingleBenchmark {

    /**
     * Number of items emitted by the source Observable.
     * Typical sizes for micro‑benchmarks; can be overridden via JMH command line.
     */
    @Param({ "1_000", "10_000", "100_000" })
    public int size;

    private Observable<Integer> source;

    private ObservableCollectSingle<Integer, List<Integer>> operator;

    /**
     * Set up the source Observable and the operator under test.
     * Executed once per fork.
     */
    @Setup(Level.Trial)
    public void setUp() {
        // Simple deterministic source; range is cheap and avoids external I/O.
        source = Observable.range(1, size);
        // ObservableCollectSingle that gathers items into an ArrayList.
        operator = new ObservableCollectSingle<>(source, (Supplier<List<Integer>>) ArrayList::new, (list, item) -> list.add(item));
    }

    /**
     * The benchmark method.
     *
     * @return the collected list; the return value prevents dead‑code elimination.
     */
    @Benchmark
    public List<Integer> collect() {
        // blockingGet forces the pipeline to execute synchronously,
        // which is appropriate for measuring pure operator overhead.
        return operator.blockingGet();
    }
}
