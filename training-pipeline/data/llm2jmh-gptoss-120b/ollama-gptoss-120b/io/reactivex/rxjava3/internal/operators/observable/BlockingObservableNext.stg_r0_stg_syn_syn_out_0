/**
 * Benchmark for {@link BlockingObservableNext} iterator throughput.
 *
 * The benchmark iterates over the entire sequence produced by the underlying
 * {@link Observable} and consumes each element via {@link Blackhole} to avoid
 * dead‑code elimination.
 *
 * Typical usage:
 *   mvn clean install -DskipTests
 *   java -jar target/benchmarks.jar -prof gc
 */
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(2)
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class BlockingObservableNextBenchmark {

    /**
     * Number of items emitted by the source Observable.
     * Adjust to evaluate different workloads.
     */
    @Param({ "1000", "10000", "100000" })
    public int size;

    private BlockingObservableNext<Integer> blocking;

    @Setup(Level.Trial)
    public void setUp() {
        // Simple deterministic source; can be replaced with more complex streams.
        Observable<Integer> source = Observable.range(1, size);
        blocking = new BlockingObservableNext<>(source);
    }

    /**
     * Measures the throughput of iterating over the entire sequence.
     *
     * @param bh Blackhole to consume values and prevent optimizations.
     */
    @Benchmark
    public void iterate(Blackhole bh) {
        Iterator<Integer> it = blocking.iterator();
        while (it.hasNext()) {
            bh.consume(it.next());
        }
    }
}
