package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.schedulers.Schedulers;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableSampleTimed}.
 * Measures the throughput of sampling a hot observable with a timed scheduler.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class ObservableSampleTimedBenchmark {

    /** Number of items emitted by the upstream source per benchmark invocation. */
    @Param({"100000"})
    public int itemCount;

    /** Sampling period in milliseconds. */
    @Param({"1"})
    public long periodMs;

    /** Scheduler used for sampling. */
    private Schedulers.ComputationScheduler scheduler;

    /** Upstream observable that emits a range of integers. */
    private Observable<Integer> source;

    @Setup(Level.Trial)
    public void setUp() {
        scheduler = (Schedulers.ComputationScheduler) Schedulers.computation();
        source = Observable.range(0, itemCount);
    }

    /**
     * Benchmarks the {@code sample} operator with {@code emitLast = false} and no {@code onDropped} consumer.
     * The downstream consumes the sampled values via {@link Blackhole} to avoid dead‑code elimination.
     */
    @Benchmark
    public void sampleTimedNoLast(Blackhole bh) {
        source
            .sample(periodMs, TimeUnit.MILLISECONDS, scheduler, false, null)
            .blockingSubscribe(bh::consume);
    }

    /**
     * Benchmarks the {@code sample} operator with {@code emitLast = true} and no {@code onDropped} consumer.
     */
    @Benchmark
    public void sampleTimedEmitLast(Blackhole bh) {
        source
            .sample(periodMs, TimeUnit.MILLISECONDS, scheduler, true, null)
            .blockingSubscribe(bh::consume);
    }
}
