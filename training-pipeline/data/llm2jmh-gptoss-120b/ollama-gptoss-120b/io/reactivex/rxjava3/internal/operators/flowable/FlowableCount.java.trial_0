```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;

import org.openjdk.jmh.annotations.*;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.core.Single;
import org.openjdk.jmh.infra.Blackhole;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableCount}
 * measuring the throughput of counting elements in a Flowable.
 *
 * The benchmark creates a Flowable that emits a configurable number of integers
 * and then applies the {@code count()} operator. The result is consumed via a
 * {@link Blackhole} to prevent dead‑code elimination.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Perform all allocations in @Setup to exclude them from the measured time.
 * - Use @BenchmarkMode(Mode.Throughput) with a time unit of seconds.
 * - Include warm‑up and measurement iterations.
 * - Run the benchmark in a separate JVM fork.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
@Threads(1)
public class FlowableCountBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     * Adjust this parameter to explore different workloads.
     */
    @Param({"1000", "10000", "100000", "1000000"})
    public int itemCount;

    private Flowable<Integer> source;

    /**
     * Prepare the source Flowable before each benchmark iteration.
     * The Flowable is created once per thread to avoid measuring allocation overhead.
     */
    @Setup(Level.Trial)
    public void setUp() {
        // Using a range Flowable which is a hot source that emits sequential integers.
        source = Flowable.range(1, itemCount);
    }

    /**
     * Benchmark the throughput of counting elements in the Flowable.
     *
     * @param bh Blackhole to consume the result and prevent dead‑code elimination.
     */
    @Benchmark
    public void countElements(Blackhole bh) {
        // count() returns a Single<Long>; blockingGet() materializes the result.
        Single<Long> countSingle = source.count();
        long count = countSingle.blockingGet();
        bh.consume(count);
    }
}
```