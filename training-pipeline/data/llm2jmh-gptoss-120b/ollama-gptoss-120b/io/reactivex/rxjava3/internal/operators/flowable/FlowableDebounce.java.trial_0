```
package io.reactivex.rxjava3.benchmarks.internal.operators.flowable;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.Function;
import io.reactivex.rxjava3.internal.operators.flowable.FlowableDebounce;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link FlowableDebounce} operator.
 *
 * The benchmark measures the throughput (operations per second) of a
 * {@code Flowable.range(...).debounce(...)} pipeline. The debounce selector
 * returns a synchronous {@code Flowable.just(...)} to isolate the overhead of
 * the operator itself without introducing artificial timing delays.
 *
 * Best practices applied:
 * - Use @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - Parameterize the source size to explore scaling behavior.
 * - Use Blackhole to consume emitted items and prevent dead‑code elimination.
 * - Use blockingSubscribe to ensure the whole stream is processed within the benchmark method.
 * - Include warm‑up, measurement, and fork settings recommended for reliable JMH results.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 7, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2)
@State(Scope.Thread)
public class FlowableDebounceBenchmark {

    /**
     * Number of items emitted by the source Flowable.
     * Typical values: 1_000, 10_000, 100_000.
     */
    @Param({"1000", "10000", "100000"})
    public int size;

    /**
     * Debounce selector that returns a synchronous Flowable.
     * Using {@code Flowable.just(0)} ensures the debounce decision is made
     * immediately, keeping the benchmark focused on operator overhead.
     */
    private static final Function<Integer, Flowable<Integer>> SELECTOR =
            v -> Flowable.just(v);

    private Flowable<Integer> source;

    @Setup(Level.Invocation)
    public void setUp() {
        // Create a fresh source for each invocation to avoid caching effects.
        source = Flowable.range(1, size);
    }

    @Benchmark
    public void debounceThroughput(Blackhole bh) {
        // Apply the debounce operator and consume all items.
        source
                .debounce(SELECTOR)
                .blockingSubscribe(bh::consume);
    }
}
```