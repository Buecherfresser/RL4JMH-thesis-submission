+     * @since 1.1
+     */
+
+    public static Apint copySign(Apint x, Apint y)
+        throws ApfloatRuntimeException
+    {
+        if (y.signum() == 0)
+        {
+            return y;
+        }
+        else if (x.signum() != y.signum())
+        {
+            return x.negate();
+        }
+        else
+        {
+            return x;
+        }
+    }
