+							//if (checkMatch(n.hi.infix, n.hi.posFirstBit-basePos, 
+							//		n.hi.posDiff-1-basePos)) {
+							if (checkMatch(valIntTemplate, n.hi.posFirstBit, n.hi.posDiff-1)) {
+								stack[++stackTop] = n.hi;
+								readHigherNext[stackTop] = READ_LOWER;
+								continue;
+							}
+						}
+					}
+				}
+				//proceed to move up a level
+				--stackTop;
+			}
