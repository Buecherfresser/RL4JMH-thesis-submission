# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# JMH runner scratch / build output
.jmhgen_work/
*.class
target/

# Training artifacts (weights, checkpoints, datasets) - tracked separately
outputs/
checkpoints/
wandb/
*.ckpt
*.safetensors

# Vendored Java sources for the original snippets (cloned, not tracked)
data/rxjava-src/

# Public repos shallow-cloned by `jmh-scrape-external` (cloned, not tracked)
data/external-src/

# Mutation track: keep the reproducible deliverables (project.yaml, mutations.patch,
# mutants.yaml) but ignore the large, re-materialisable derived corpus + any vendored source.
data/projects/*/snippets.jsonl
data/projects/*/src/

# Provisioned SUT classpaths + built (mutant-bearing) jars are derived from the vendored
# source by jmh-provision-{classpath,mutants}; regenerate on demand rather than tracking.
data/classpaths/

# Vendored SpotBugs + SpotJMHBugs (installed by tools/install_spotjmhbugs.sh)
vendor/

# Remote training run logs (large stdout captures; keep metrics/summaries under logs/)
logs/**/*.log

# OS / editor
.DS_Store
.idea/
.vscode/
.env

