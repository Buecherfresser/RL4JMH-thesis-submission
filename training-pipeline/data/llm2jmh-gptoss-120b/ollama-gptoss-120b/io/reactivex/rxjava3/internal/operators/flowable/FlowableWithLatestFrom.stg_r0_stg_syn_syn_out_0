/**
 * JMH benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableWithLatestFrom}
 * measuring throughput (items processed per second).
 *
 * The benchmark creates two finite synchronous sources (range) and applies the
 * {@code withLatestFrom} operator with a simple addition combiner. The resulting
 * Flowable is consumed via {@code blockingForEach} to ensure the whole pipeline
 * is executed and the result is fed to a {@link Blackhole} to avoid dead‑code
 * elimination.
 *
 * Best‑practice notes:
 * • State is scoped to a thread to avoid sharing mutable objects across threads.
 * • All objects are created in {@link Setup(Level.Trial)} so the benchmark measures
 *   only the operator's runtime, not allocation overhead.
 * • {@code Blackhole} is used to consume the downstream values.
 * • Warm‑up, measurement, and fork parameters follow typical JMH recommendations.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(1)
public class FlowableWithLatestFromBenchmark {

    /**
     * Number of items emitted by each source Flowable.
     */
    @Param({ "1000", "10000", "100000" })
    public int size;

    @State(Scope.Thread)
    public static class BenchmarkState {

        Flowable<Integer> combined;

        @Setup(Level.Trial)
        public void setUp(BenchmarkStateHolder holder) {
            // Create two finite sources emitting integers from 1 to size.
            Flowable<Integer> source = Flowable.range(1, holder.size);
            Flowable<Integer> other = Flowable.range(1, holder.size);
            // Apply withLatestFrom using a simple addition combiner.
            combined = source.withLatestFrom(other, (a, b) -> a + b);
        }
    }

    /**
     * Helper holder to expose the @Param field to the thread‑scoped state.
     */
    @State(Scope.Benchmark)
    public static class BenchmarkStateHolder {

        @Param({ "1000", "10000", "100000" })
        public int size;
    }

    @Benchmark
    public void throughput(BenchmarkState state, Blackhole bh) {
        // Consume the entire stream; each emitted item is passed to Blackhole.
        state.combined.blockingForEach(bh::consume);
    }
}
