-            offset = offset.negate();
-        }
-        z = z.subtract(n);
-        Apcomplex ls;
-        if (z.imag().compareTo(one) > 0)
-        {
-            ls = log(half.multiply(one.subtract(expNoLoP(two.multiply(i).multiply(pi).multiply(z))))).subtract(i.multiply(pi).multiply(z.subtract(half)));
-        }
