```
package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.internal.operators.flowable.FlowableCollect;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.TimeUnit;
import java.util.function.BiConsumer;
import java.util.function.Supplier;

/**
 * JMH benchmark for {@link FlowableCollect} operator.
 *
 * The benchmark measures the throughput (operations per second) of collecting
 * a stream of integers into a mutable container (ArrayList) using the
 * {@code collect} operator. It follows JMH best practices:
 * <ul>
 *   <li>State is scoped to a single thread to avoid contention.</li>
 *   <li>All mutable objects are created in {@link #setup()} to exclude allocation
 *       cost from the measured section.</li>
 *   <li>Blackhole is used to consume the result, preventing dead‑code elimination.</li>
 *   <li>Warm‑up and measurement iterations are defined to let the JVM reach a
 *       steady state.</li>
 * </ul>
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 2, jvmArgsAppend = {"-XX:+UnlockDiagnosticVMOptions", "-XX:+PrintCompilation"})
@State(Scope.Thread)
public class FlowableCollectBenchmark {

    /** Number of items emitted by the source Flowable. */
    @Param({"1000", "10000", "100000"})
    public int itemCount;

    /** The source Flowable emitting a range of integers. */
    private Flowable<Integer> source;

    /** Supplier that creates a new mutable container for collection. */
    private Supplier<List<Integer>> initialSupplier;

    /** BiConsumer that adds each emitted item to the container. */
    private BiConsumer<List<Integer>, Integer> collector;

    @Setup(Level.Trial)
    public void setup() {
        // Create a cold Flowable that emits a deterministic range of integers.
        source = Flowable.range(1, itemCount);

        // Supplier creates a fresh ArrayList for each collection.
        initialSupplier = ArrayList::new;

        // Collector simply adds the integer to the list.
        collector = List::add;
    }

    /**
     * Benchmark the collect operator.
     *
     * The operation is performed synchronously using {@code blockingGet()} to
     * obtain the final container, which is then consumed by the Blackhole.
     *
     * @param bh Blackhole to consume the result and avoid dead‑code elimination.
     */
    @Benchmark
    public void collect(Blackhole bh) {
        // Apply the collect operator and block until completion.
        List<Integer> result = source
                .collect(initialSupplier, collector)
                .blockingGet();

        // Consume the result to prevent the JIT from optimizing away the whole pipeline.
        bh.consume(result);
    }
}
```