package io.reactivex.rxjava3.benchmarks;

import io.reactivex.rxjava3.core.Flowable;
import io.reactivex.rxjava3.functions.BiFunction;
import io.reactivex.rxjava3.functions.Function;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;

import java.util.concurrent.TimeUnit;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.flowable.FlowableJoin}
 * measuring throughput of the join operation.
 *
 * The benchmark creates two finite Flowables, applies the join operator
 * with simple end publishers (timers) and a trivial result selector.
 * The emitted items are consumed by a Blackhole to prevent dead‑code elimination.
 *
 * Best practices applied:
 * - @State(Scope.Thread) to avoid sharing mutable state between threads.
 * - @Setup to pre‑create the Flowable pipeline once per benchmark iteration.
 * - Use of Blackhole for side‑effect consumption.
 * - Throughput mode with seconds as the output time unit.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@State(Scope.Thread)
public class FlowableJoinBenchmark {

    /** Number of elements in each source Flowable. */
    @Param({"100", "1000", "10000"})
    public int size;

    /** The Flowable pipeline under test. */
    private Flowable<Integer> joinedFlowable;

    /** Function that creates a left‑end publisher for a given left value. */
    private static final Function<Integer, Flowable<Long>> LEFT_END = l ->
            // End after a very short fixed delay; using a timer keeps the operator asynchronous.
            Flowable.timer(1, TimeUnit.MILLISECONDS);

    /** Function that creates a right‑end publisher for a given right value. */
    private static final Function<Integer, Flowable<Long>> RIGHT_END = r ->
            Flowable.timer(1, TimeUnit.MILLISECONDS);

    /** Result selector that combines left and right values. */
    private static final BiFunction<Integer, Integer, Integer> RESULT_SELECTOR = (l, r) -> l + r;

    @Setup(Level.Invocation)
    public void setUp() {
        Flowable<Integer> left = Flowable.range(1, size);
        Flowable<Integer> right = Flowable.range(1, size);

        // Build the join operator once per invocation to include its construction cost.
        joinedFlowable = left.join(
                right,
                LEFT_END,
                RIGHT_END,
                RESULT_SELECTOR
        );
    }

    @Benchmark
    public void joinThroughput(Blackhole bh) {
        // Subscribe and consume all items; blockingForEach ensures the benchmark
        // measures the complete execution of the join pipeline.
        joinedFlowable.blockingForEach(bh::consume);
    }
}
```