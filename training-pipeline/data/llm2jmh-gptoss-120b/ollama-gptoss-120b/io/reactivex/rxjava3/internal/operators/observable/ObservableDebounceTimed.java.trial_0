```
package io.reactivex.rxjava3.benchmarks;

import java.util.concurrent.TimeUnit;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import io.reactivex.rxjava3.core.Observable;
import io.reactivex.rxjava3.schedulers.Schedulers;
import io.reactivex.rxjava3.core.Scheduler;

/**
 * Benchmark for {@link io.reactivex.rxjava3.internal.operators.observable.ObservableDebounceTimed}
 * measuring throughput (items per second) of the debounce operator.
 *
 * The benchmark emits a configurable number of integer items as fast as possible,
 * applies {@code debounce} with a configurable timeout and scheduler, and consumes
 * the resulting items with a {@link Blackhole} to avoid dead‑code elimination.
 *
 * Best‑practice JMH settings:
 * - Warm‑up iterations to let the JIT stabilize.
 * - Multiple measurement iterations for statistical confidence.
 * - Several forks to isolate JVM state.
 * - Single thread per benchmark instance (Scope.Thread) to avoid contention.
 */
@BenchmarkMode(Mode.Throughput)
@OutputTimeUnit(TimeUnit.SECONDS)
@Warmup(iterations = 5, time = 1, timeUnit = TimeUnit.SECONDS)
@Measurement(iterations = 10, time = 1, timeUnit = TimeUnit.SECONDS)
@Fork(value = 3)
@State(Scope.Thread)
public class ObservableDebounceTimedBenchmark {

    /** Number of items emitted by the source Observable per benchmark invocation. */
    @Param({"1000", "10000", "100000"})
    public int itemCount;

    /** Debounce timeout value. */
    @Param({"1", "10", "100"})
    public long timeout;

    /** Time unit for the debounce timeout. */
    @Param({"MILLISECONDS"})
    public TimeUnit unit;

    /** Scheduler used by the debounce operator. */
    public Scheduler scheduler;

    /** Source Observable that emits {@code itemCount} integers as fast as possible. */
    private Observable<Integer> source;

    @Setup(Level.Trial)
    public void setUp() {
        // Use the computation scheduler which is the default for debounce in RxJava.
        scheduler = Schedulers.computation();

        // Create a hot source that emits items synchronously.
        source = Observable.range(0, itemCount);
    }

    @Benchmark
    public void debounceThroughput(Blackhole bh) {
        // Apply debounce with the configured timeout and scheduler.
        // Use blockingSubscribe to ensure the benchmark measures the full pipeline.
        source
            .debounce(timeout, unit, scheduler)
            .blockingSubscribe(bh::consume);
    }
}
```